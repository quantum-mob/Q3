 CellID->1068390033,ExpressionUUID->"ed0c8b64-f108-495a-a225-918b2cb1edcb"],

Cell[TextData[{
 "Consider a linear combination ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalSigma]", "i"], 
     SubscriptBox["\[Alpha]", "i"], 
     UnderscriptBox["a", "_"]}], "=", 
    RowBox[{
     SubscriptBox["\[CapitalSigma]", "i"], 
     SubscriptBox["\[Gamma]", "i"], 
     SubscriptBox["c", "i"]}]}], TraditionalForm]],ExpressionUUID->
  "a2bbbef5-45ef-4ad4-add7-28fc0a6aa05a"],
 " . Then, the two row vectors ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", ":=", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Alpha]", "1"], ",", 
      SubscriptBox["\[Alpha]", "2"], ",", "\[Ellipsis]"}], ")"}]}], 
   TraditionalForm]],ExpressionUUID->"506482bc-e56a-4915-a114-eaf190b57c46"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", ":=", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["\[Gamma]", "1"], ",", 
      SubscriptBox["\[Gamma]", "2"], ",", "\[Ellipsis]"}], "}"}]}], 
   TraditionalForm]],ExpressionUUID->"6583c5bd-bee0-4b4e-aee1-f52c3d173a1b"],
 " are related to each other by"
}], "TechNoteText",
 CellID->1501057669,ExpressionUUID->"31a55745-3faf-4244-8768-2601506089d9"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", 
    RowBox[{"\[Gamma]", "\[VeryThinSpace]", "M"}]}], TraditionalForm]],
  ExpressionUUID->"01d469b8-a0ba-4b4a-bb3a-a1b2ddd1fcbc"],
 " ,\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", "=", 
    RowBox[{"\[Alpha]", "\[VeryThinSpace]", "D"}]}], TraditionalForm]],
  ExpressionUUID->"5b4d95cd-4d55-44f9-876a-e4d9d1b244cf"],
 " ."
}], "TechNoteText",
 CellID->1199058434,ExpressionUUID->"2828a305-1913-4c7b-826d-d41e5f5d719e"],

Cell[TextData[{
 "Consider a bilinear combination ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalSigma]", 
      RowBox[{"i", ",", "j"}]], 
     SubsuperscriptBox[
      UnderscriptBox["a", "_"], "i", "\[Dagger]"], 
     SubscriptBox[
      RowBox[{"\[Alpha]", "\[VeryThinSpace]"}], 
      RowBox[{"i", "\[VeryThinSpace]", "j"}]], 
     SubscriptBox[
      UnderscriptBox["a", "_"], "j"]}], "=", 
    RowBox[{
     SubscriptBox["\[CapitalSigma]", 
      RowBox[{"i", ",", "j"}]], 
     SubscriptBox["c", "i"], 
     SubscriptBox["\[Gamma]", 
      RowBox[{"i", "\[VeryThinSpace]", "j"}]], 
     SubscriptBox["c", "j"]}]}], TraditionalForm]],ExpressionUUID->
  "80891740-70ac-4680-a2fb-cc44c7d22043"],
 ". The two coefficients matrices ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]],ExpressionUUID->
  "ddf86b60-0ded-40cc-bb60-579e143827cc"],
 " and ",
 Cell[BoxData[
  FormBox["\[Gamma]", TraditionalForm]],ExpressionUUID->
  "d02fb898-6c23-4d5f-bafc-aec650dbaced"],
 " are related with each other by"
}], "TechNoteText",
 CellID->1255090529,ExpressionUUID->"902d25ec-6c7f-45a9-85e6-35aecac8973c"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", 
    RowBox[{
     SuperscriptBox["M", "\[Dagger]"], "\[Gamma]", " ", "M"}]}], 
   TraditionalForm]],ExpressionUUID->"55710530-f1a3-4087-908e-fe3658d6945f"],
 "  ,\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", "=", 
    RowBox[{
     SuperscriptBox["D", "\[Dagger]"], "\[Alpha]", " ", "D"}]}], 
   TraditionalForm]],ExpressionUUID->"3d80e66e-2880-4ec0-af2a-f23190455b72"],
 "."
}], "TechNoteText",
 CellID->858802456,ExpressionUUID->"8cec3229-a7eb-46cc-8996-1682c3870430"]
}, Open  ]],

