Cell["Related functions", "TechNoteCaption",
 CellID->673419754,ExpressionUUID->"c1c24778-44b0-439e-94ee-6553fcfaace5"],

Cell[TextData[{
 "Consider a many-body unitary operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["U", "^"], ":=", 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], "\[VeryThinSpace]", 
      OverscriptBox["H", "^"]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "98709549-0aa5-4b71-bfb8-b534f159d306"],
 " governed by the above many-body Hamiltonian ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["H", "^"], TraditionalForm]],ExpressionUUID->
  "cc12ab9c-a126-4bd2-8f78-b4eac2e1ec32"],
 ". It represents the canonical transformations of the Dirac and Majorana \
spinors:"
}], "TechNoteText",
 CellID->808392804,ExpressionUUID->"f8be3434-c38c-4889-a27b-b7ca176a669b"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox[
      UnderscriptBox["a", "_"], "^"], "'"}], ":=", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       OverscriptBox["U", "^"], "\[Dagger]"], 
      OverscriptBox[
       UnderscriptBox["a", "_"], "^"], "\[VeryThinSpace]", 
      OverscriptBox["U", "^"]}], "=", 
     RowBox[{"U", 
      OverscriptBox[
       UnderscriptBox["a", "_"], "^"]}]}]}], TraditionalForm]],ExpressionUUID->
  "96bf0970-4817-4ac0-a578-e04a226603ce"],
 " ,\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["c", "^"], "'"}], ":=", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       OverscriptBox["U", "^"], "\[Dagger]"], 
      OverscriptBox["c", "^"], "\[VeryThinSpace]", 
      OverscriptBox["U", "^"]}], "=", 
     RowBox[{"R", 
      OverscriptBox["c", "^"]}]}]}], TraditionalForm]],ExpressionUUID->
  "23422fd7-341a-4742-9f33-5ba2a3764823"],
 " ."
}], "TechNoteText",
 CellID->1708574668,ExpressionUUID->"6e4d4402-5d8d-48ec-b37f-3b4a7fa950ea"],

Cell[TextData[{
 "Here, the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "n", "\[Times]", "2", "n"}], TraditionalForm]],ExpressionUUID->
  "fb093912-374d-47d8-b492-415ed1d354b7"],
 " ",
 StyleBox["unitary",
  FontSlant->"Italic"],
 " matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", ":=", 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], "\[VeryThinSpace]", "H"}], ")"}]}], 
   TraditionalForm]],ExpressionUUID->"c1e36faf-ef33-48b3-a035-b594d1ed00f8"],
 " (the symbols refer to the matrices ",
 Cell[BoxData[
  FormBox["U", TraditionalForm]],ExpressionUUID->
  "713db577-889b-4d0f-a6ef-84db7e9934c2"],
 " and ",
 Cell[BoxData[
  FormBox["H", TraditionalForm]],ExpressionUUID->
  "4d681441-50e8-48ba-a9c1-03cdbb1f38de"],
 "; not the many-body operators ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["U", "^"], TraditionalForm]],ExpressionUUID->
  "8e43914b-2b03-4414-8db4-fc4abf9c63dc"],
 " and ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["H", "^"], TraditionalForm]],ExpressionUUID->
  "68c2b467-3084-446d-a3b1-9d09e7641f2f"],
 ") represents the many-body unitary operator ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["U", "^"], TraditionalForm]],ExpressionUUID->
  "5c55b632-e067-41f6-a4ca-a968c19d29ef"],
 " in the space of Dirac spinors; in the same way, the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "n", "\[Times]", "2", "n"}], TraditionalForm]],ExpressionUUID->
  "53e4a56d-e6ca-4dd0-b80d-3392b6398f5f"],
 " ",
 StyleBox["real orthogonal",
  FontSlant->"Italic"],
 " matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", ":=", 
    RowBox[{"exp", "(", "A", ")"}]}], TraditionalForm]],ExpressionUUID->
  "242660ca-1d50-4ac7-9996-ee1656f17177"],
 " represents ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["U", "^"], TraditionalForm]],ExpressionUUID->
  "90921f0d-c9bc-4022-842a-0e3252549ed0"],
 " in the space of Majorana spinors. The two matrices are related to each \
other by"
}], "TechNoteText",
 CellID->866784807,ExpressionUUID->"7a3fcf29-be65-480b-b5f3-7fa360706b0d"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "=", 
    RowBox[{
     FractionBox["1", "2"], 
     SuperscriptBox["M", "\[Dagger]"], "R", " ", "M"}]}], TraditionalForm]],
  ExpressionUUID->"0554efb3-35fc-4501-a4f7-24cff3254f67"],
 " ,\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "=", 
    RowBox[{"2", 
     SuperscriptBox["D", "\[Dagger]"], "U", " ", "D"}]}], TraditionalForm]],
  ExpressionUUID->"50cfb7de-c15a-4000-9d69-29128cbe4d4e"],
 " ."
}], "TechNoteText",
 CellID->42690027,ExpressionUUID->"bde78a80-c3d4-47ed-a342-6ce2668ad9d5"]
}, Open  ]],

