Cell[CellGroupData[{

Cell["Conversion between Dirac and Majorana Fermions", "TechNoteSection",
 CellID->181417294,ExpressionUUID->"6e3397ed-cb9d-4274-8455-9a9c832321ca"],

Cell["\<\
Mathematically, any fermionic system may be describe in terms of either Dirac \
or Majorana fermions. Roughly, one may regard a Majorana fermion as a half of \
Dirac fermion; in other words, a Dirac fermion may be regarded to consist of \
two Majorana fermions.\
\>", "TechNoteText",
 CellID->1338494812,ExpressionUUID->"6527463f-008c-44b6-af9d-f30c7695657f"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "1"], ",", "\[Ellipsis]", ",", " ", 
    SubscriptBox["a", "n"]}], TraditionalForm]],ExpressionUUID->
  "a4626dae-99f9-44bb-aa37-c01a272ef94c"],
 " be Dirac fermion modes, and suppose that  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "1"], ",", 
    SubscriptBox["c", "2"], ",", "\[Ellipsis]", ",", 
    SubscriptBox["c", 
     RowBox[{
      RowBox[{"2", "n"}], "-", "1"}]], ",", 
    SubscriptBox["c", 
     RowBox[{"2", "n"}]]}], TraditionalForm]],ExpressionUUID->
  "55965eb4-ec99-408c-b836-60c07296a269"],
 " be the corresponding Majorana modes. The transformation rules between \
Dirac fermion operators ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "k"], TraditionalForm]],ExpressionUUID->
  "abda20a4-fc72-4d67-b67c-6082958733bf"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["a", "k", "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "858a3374-8f1b-4304-9621-fb18dcf036c4"],
 " and the Majorana fermion operators ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", 
    RowBox[{
     RowBox[{"2", "k"}], "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "2e3e7683-a910-4f9a-adaa-7d6a1a2b0ef9"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", 
    RowBox[{"2", "k"}]], TraditionalForm]],ExpressionUUID->
  "0031b1ae-5e74-4a8a-863e-ac96ccaced8a"],
 " are given by"
}], "TechNoteText",
 CellID->1234513517,ExpressionUUID->"bc04098b-db3b-40f2-9fde-3f8464517e0c"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "k"], ":=", 
    RowBox[{
     SubscriptBox["a", "k"], "+", 
     SubsuperscriptBox["a", "k", "\[Dagger]"]}]}], TraditionalForm]],
  ExpressionUUID->"1e11b3bf-6e3a-4753-b3f7-e93f161b0636"],
 " ,  \t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[ImaginaryI]", "\[VeryThinSpace]", 
     SubscriptBox["c", 
      RowBox[{"n", "+", "k"}]]}], ":=", 
    RowBox[{
     SubscriptBox["a", "k"], "-", 
     SubsuperscriptBox["a", "k", "\[Dagger]"]}]}], TraditionalForm]],
  ExpressionUUID->"d99b4c4d-2dea-4287-9b0d-5f49abab8a5d"],
 " ."
}], "TechNoteText",
 CellID->1790587256,ExpressionUUID->"249a597e-0e07-464e-83d9-790d4b266525"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "k"], ":=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["c", "k"], "+", 
       RowBox[{"\[ImaginaryI]", "\[VeryThinSpace]", 
        SubscriptBox["c", 
         RowBox[{"n", "+", "k"}]]}]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"e5ab3ba9-66d3-4f7c-8f29-36308fa62871"],
 " ,\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["a", "k", "\[Dagger]"], ":=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["c", "k"], "-", 
       RowBox[{"\[ImaginaryI]", "\[VeryThinSpace]", 
        SubscriptBox["c", 
         RowBox[{"n", "+", "k"}]]}]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"9f1dc8c1-eff0-482f-a322-05d421cb4dec"]
}], "TechNoteText",
 CellID->1562557471,ExpressionUUID->"6bd923f9-11fc-4455-8e7b-295e158a8ff1"],

Cell[TextData[{
 "Note that the Majorana operators are normalized as \[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["c", "i"], ",", 
      SubscriptBox["c", "j"]}], "}"}], "=", 
    RowBox[{"2", 
     SubscriptBox["\[Delta]", 
      RowBox[{"i", "\[VeryThinSpace]", "j"}]]}]}], TraditionalForm]],
  ExpressionUUID->"82c4b73c-374b-4087-ac5e-7624dd4174f7"],
 " ,    i.e.,    ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["c", "i", "2"], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"a8caa011-f4ff-4553-bee6-1a1fa0a1c7cf"],
 "."
}], "TechNoteText",
 CellID->1677403214,ExpressionUUID->"e77abd12-bf1b-450f-ad8b-db64cd6e49fa"],

Cell[CellGroupData[{

Cell["Spinor Form", "Subsection",
 CellID->530306869,ExpressionUUID->"615a0164-7f1d-4084-8e39-20231dd8749a"],

Cell[TextData[{
 "Define the ",
 StyleBox["Dirac and Majorana spinors, respectively, ",
  FontSlant->"Italic"],
 "by"
}], "TechNoteText",
 CellID->1094791532,ExpressionUUID->"70cfa126-dd3b-450d-be82-f1148a0562a0"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["a", "_"], ":=", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["a", "1"]},
       {"\[VerticalEllipsis]"},
       {
        SubscriptBox["a", "n"]},
       {
        SubsuperscriptBox["a", "1", "\[Dagger]"]},
       {"\[VerticalEllipsis]"},
       {
        SubsuperscriptBox["a", "n", "\[Dagger]"]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "de6bf43a-7b03-4e10-a344-ad80aa9bb812"],
 ". \t",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", ":=", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["c", "1"]},
       {"\[VerticalEllipsis]"},
       {
        SubscriptBox["c", "n"]},
       {
        SubscriptBox["c", 
         RowBox[{"n", "+", "1"}]]},
       {"\[VerticalEllipsis]"},
       {
        SubscriptBox["c", 
         RowBox[{"2", "n"}]]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "cd952d94-c5ef-4b7f-abc5-720b4bf2d1ea"],
 "."
}], "TechNoteText",
 CellID->1747941533,ExpressionUUID->"e6f76398-588b-472b-8eca-dab0da285dec"],

Cell["The transformation between the two spinors are given by", "TechNoteText",
 CellID->473617434,ExpressionUUID->"8af037e7-c449-4a3f-8111-66a03ecd4902"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["a", "_"], "=", 
    RowBox[{"D", "\[VeryThinSpace]", "c"}]}], TraditionalForm]],
  ExpressionUUID->"e4e00951-c6ff-4823-9014-10db84b77d68"],
 " ,\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", 
    RowBox[{"M", "\[VeryThinSpace]", 
     UnderscriptBox["a", "_"]}]}], TraditionalForm]],ExpressionUUID->
  "163dc5df-0040-49d4-b61c-8be9fd0ad0e1"],
 "."
}], "TechNoteText",
 CellID->2062792293,ExpressionUUID->"286619a0-ffe9-4222-a478-8d77606234b8"],

Cell[TextData[{
 "For a single mode (",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "cd89fa90-7f58-44c8-aba6-ea953bc15c78"],
 "),"
}], "TechNoteText",
 CellID->1148268085,ExpressionUUID->"90633da9-fade-4334-8839-38fc57d9c20c"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"D", "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", GridBox[{
         {"1", 
          RowBox[{"+", "\[ImaginaryI]"}]},
         {"1", 
          RowBox[{"-", "\[ImaginaryI]"}]}
        }], ")"}]}], "=", 
     RowBox[{
      FractionBox["1", "2"], 
      SuperscriptBox["M", "\[Dagger]"]}]}]}], TraditionalForm]],
  ExpressionUUID->"8eb9b576-ea4d-4184-8cc1-e82b334145cf"],
 " ,\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "=", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {"1", "1"},
        {
         RowBox[{"-", "\[ImaginaryI]"}], 
         RowBox[{"+", "\[ImaginaryI]"}]}
       }], ")"}], "=", 
     RowBox[{"2", 
      SuperscriptBox["D", "\[Dagger]"]}]}]}], TraditionalForm]],
  ExpressionUUID->"af0e1f0b-18f7-455b-b7b9-177bab6a887a"],
 " ."
}], "TechNoteText",
 CellID->1378857824,ExpressionUUID->"8bb00e52-0c62-4350-937a-177552040ac6"],

Cell[TextData[{
 "Note that matrices ",
 Cell[BoxData[
  FormBox["D", TraditionalForm]],ExpressionUUID->
  "ce4b6e46-dce5-477a-9fb4-abe7dd58b41d"],
 " and ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],ExpressionUUID->
  "987183f0-a0f4-492d-9689-f3be54c91fc0"],
 " are not unitary due to the pre-factors:"
}], "TechNoteText",
 CellID->396781122,ExpressionUUID->"6f9e17f0-74c4-44dd-8395-90ad81fa5e9f"],

Cell[TextData[{
