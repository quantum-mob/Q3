    "Represents Majorana fermions", "TechNoteTableText",ExpressionUUID->
     "355c78e7-84b5-4902-98e4-ff05623ba598"]},
   {
    TemplateBox[{
      Cell[
       TextData["Fermion"]], "paclet:QuantumMob/Q3/ref/Fermion", 
      "QuantumMob Package Symbol"},
     "PackageLink",
     BaseStyle->{"DefinitionBox", CellFrame -> 0}], Cell[
    "Represents Dirac fermions", "TechNoteTableText",ExpressionUUID->
     "62400a4d-033c-4b97-80be-ed16f658c3ce"]}
  }]], "DefinitionBox",
 CellID->1820544332,ExpressionUUID->"fa0ce909-36db-4922-b4e2-9ec94f753fc9"],

