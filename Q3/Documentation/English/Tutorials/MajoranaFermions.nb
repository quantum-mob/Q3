Cell["Related functions", "TechNoteCaption",
 CellID->1090222322,ExpressionUUID->"84697e3d-5dd1-4c22-aed3-daed1f3f0679"],

Cell[TextData[{
 "Any fermionic Gaussian state of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "c5beca8b-acb1-49bc-92bf-9594211d56bb"],
 " fermion modes can be written as"
}], "TechNoteText",
 CellID->52239125,ExpressionUUID->"c81d990d-cdb8-46b0-aa4e-30e008d0ef71"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "=", 
    RowBox[{
     FractionBox["\[ScriptCapitalN]", 
      SuperscriptBox["2", "n"]], 
     UnderoverscriptBox["\[CapitalPi]", 
      RowBox[{"k", "=", "1"}], "n"]}]}], TraditionalForm]],ExpressionUUID->
  "dff15ebc-c625-471f-8d8d-3bdff581142a"],
 "(1+\[ImaginaryI]\[VeryThinSpace]",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Lambda]", "k"], 
     SubscriptBox["c", 
      RowBox[{
       RowBox[{"2", "k"}], "-", "1"}]], 
     SubscriptBox["c", 
      RowBox[{"2", "k"}]]}], ")"}], TraditionalForm]],ExpressionUUID->
  "5c09b6df-b931-4079-8550-52336ce00dcc"],
 ","
}], "TechNoteText",
 CellID->596265470,ExpressionUUID->"310dfe65-668a-4a9a-aaf3-058a34695806"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "i"], TraditionalForm]],ExpressionUUID->
  "66b33aab-7d99-439f-9368-967b533d96b9"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", "2", ",", "\[Ellipsis]", ",", 
    RowBox[{"2", "n"}]}], TraditionalForm]],ExpressionUUID->
  "6c9dc969-60bd-429d-a2b6-ce0423284558"],
 ") are Majorana fermion operators corresponding to the ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "458116ca-ffe1-4c76-9294-79db129a06aa"],
 " Dirac fermion modes, ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalN]", TraditionalForm]],ExpressionUUID->
  "ccf10ec9-7150-4dce-81ff-98a7eef4af22"],
 " is the norm square of the state (i.e., note that some quantum channels do \
not preserve the trace of the state and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Tr", "\[VeryThinSpace]", "\[Rho]"}], "=", "\[ScriptCapitalN]"}], 
   TraditionalForm]],ExpressionUUID->"85101954-0e8a-45d6-b254-06bd1fd8e2c5"],
 "), and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[PlusMinus]", "\[ImaginaryI]"}], "\[VeryThinSpace]", 
    SubscriptBox["\[Lambda]", "k"]}], TraditionalForm]],ExpressionUUID->
  "d56e15d2-f42a-4206-a96b-b6e54b477b2f"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Lambda]", "k"], "\[Element]", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "1"}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"24f08e39-44f5-4876-b264-3f9769e252e2"],
 ") are eigenvalues of the ",
 StyleBox["covariance matrix",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "49bd9a43-89ce-4aa7-be41-50d2967e3873"],
 ", which is a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "n", "\[Times]", "2", "n"}], TraditionalForm]],ExpressionUUID->
  "0e068a6a-cd1d-474c-8756-e11dcfea567e"],
 " real anti-symmetric matrix (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["V", "T"], "=", 
    RowBox[{"-", "V"}]}], TraditionalForm]],ExpressionUUID->
  "8c36e978-71af-412a-b3a7-03d55d07ee86"],
 ") in the Majorana spinor space [",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData[
      StyleBox[{
        StyleBox["Bravyi", IgnoreSpellCheck -> True], " (2005)"}]]], 
    "https://dl.acm.org/doi/abs/10.5555/2011637.2011640"},
   "WebLink",
   BaseStyle->{"Notes"}]],ExpressionUUID->
  "bbd5ed15-1c4f-460e-b9c5-e1f11f50dfc8"],
 "]."
}], "TechNoteText",
 CellID->1791798107,ExpressionUUID->"8eeba5d0-5b56-4e9a-86bf-4cd37b344a2f"],

Cell[TextData[{
 "Introducing ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "n"}], TraditionalForm]],ExpressionUUID->
  "2739bedb-3cef-4a2a-a577-4b777086a322"],
 " ",
 ButtonBox["Grassmann variables",
  BaseStyle->"Link",
  ButtonData->"paclet:QuantumMob/Q3/ref/Grassmann"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],ExpressionUUID->
  "6a418b2f-0914-440c-afad-7a6f2319d34f"],
 " respectively corresponding to the Majorana modes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "i"], TraditionalForm]],ExpressionUUID->
  "10f19719-4aa8-4224-b468-a750b5e02c6b"],
 ", the fermionic Gaussian state reads as"
}], "TechNoteText",
 CellID->1331370085,ExpressionUUID->"2ea9aada-cd7b-41f1-bc5e-4878a54e24b2"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "\[DotEqual]", 
    RowBox[{
     FractionBox["\[ScriptCapitalN]", 
      SuperscriptBox["2", "n"]], 
     RowBox[{"exp", "(", 
      RowBox[{
       FractionBox["\[ImaginaryI]", "2"], 
       UnderoverscriptBox["\[CapitalSigma]", 
        RowBox[{"i", ",", 
         RowBox[{"j", "=", "1"}]}], 
        RowBox[{"2", "n"}]], 
       SubscriptBox["x", "i"], 
       SubscriptBox["V", 
        RowBox[{"i", "\[VeryThinSpace]", "j"}]], 
       SubscriptBox["x", "j"]}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "c421d69d-70e1-470d-8f09-118748a6c658"],
 " ,"
}], "TechNoteText",
 CellID->1331597561,ExpressionUUID->"d28231d4-2675-434f-9a9c-896d1746d681"],

Cell[TextData[{
 "expressed directly in terms of the covariance matrix ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "95bcdc99-48cb-469f-8bd4-f9735776eb57"],
 " [",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData[
      StyleBox[{
        StyleBox["Bravyi", IgnoreSpellCheck -> True], " (2005)"}]]], 
    "https://dl.acm.org/doi/abs/10.5555/2011637.2011640"},
   "WebLink",
   BaseStyle->{"Notes"}]],ExpressionUUID->
  "cc5ae6e0-5c55-4315-9ee7-47cd2371e78e"],
 "]."
}], "TechNoteText",
 CellID->1941127793,ExpressionUUID->"f19ec24a-acb1-4952-9549-2e645dfffa29"],

Cell[TextData[{
 "The ",
 StyleBox["covariance matrix",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "35fd410f-7910-4e9e-a488-0eda7678e64a"],
 " is related to the matrix ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "73c578bd-b393-46bd-bab2-eba4241793d8"],
 " of ",
 ButtonBox["Green\[CloseCurlyQuote]s functions",
  BaseStyle->"Link",
  ButtonData->"paclet:QuantumMob/Q3/ref/BravyiGreen"],
 " by"
}], "TechNoteText",
 CellID->1077220984,ExpressionUUID->"a03d32cb-5044-4a3a-8b9a-8111be218504"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "(", 
       RowBox[{"I", "-", 
        RowBox[{"\[ImaginaryI]", "\[VeryThinSpace]", "V"}]}], ")"}], 
      SuperscriptBox["D", "\[Dagger]"]}], "=", 
     RowBox[{
      FractionBox["1", "4"], 
      RowBox[{
       SuperscriptBox["M", "\[Dagger]"], "(", 
       RowBox[{"I", "-", 
        RowBox[{"\[ImaginaryI]", "\[VeryThinSpace]\[VeryThinSpace]", "V"}]}], 
       ")"}], "M"}]}]}], TraditionalForm]],ExpressionUUID->
  "d1ceafd2-f214-4100-8b91-29c0cb20c9d5"],
 " ,\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"I", "-", 
     RowBox[{"\[ImaginaryI]", "\[VeryThinSpace]", "V"}]}], "=", 
    RowBox[{
     RowBox[{"M", "\[VeryThinSpace]", "G", "\[VeryThinSpace]", 
      SuperscriptBox["M", "\[Dagger]"]}], "=", 
     RowBox[{"4", 
      SuperscriptBox["D", "\[Dagger]"], "G", " ", "D"}]}]}], 
   TraditionalForm]],ExpressionUUID->"95d45069-2547-4732-9446-7ff1cfa43b13"],
 " ."
}], "TechNoteText",
 CellID->1523081043,ExpressionUUID->"4853ea63-27cc-4fde-b37f-a547b7db9477"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "f1b003aa-7e0d-4d87-a1df-30963e061dc8"],
 " is the Green\[CloseCurlyQuote]s functions matrix is in the ",
 ButtonBox["block form",
  BaseStyle->"Link",
  ButtonData->"paclet:QuantumMob/Q3/ref/NambuGreen"],
 "\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", ":=", 
    RowBox[{"(", GridBox[{
       {"g", "f"},
       {
        SuperscriptBox["f", "\[Dagger]"], 
        RowBox[{"I", "-", 
         SuperscriptBox["g", "T"]}]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "4cf44f16-28e2-4aa4-96d7-149cdd2a47dc"],
 " ,\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", 
     RowBox[{"i", "\[VeryThinSpace]", "j"}]], ":=", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox["a", "i"], 
      SubsuperscriptBox["a", "j", "\[Dagger]"]}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]],ExpressionUUID->"b57ed24b-979e-4853-9e04-16031aa12527"],
 " ,\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", 
     RowBox[{"i", "\[VeryThinSpace]", "j"}]], ":=", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox["a", "i"], 
      SubscriptBox["a", "j"]}], "\[RightAngleBracket]"}]}], TraditionalForm]],
  ExpressionUUID->"2a87fa4f-2d4d-403e-a979-ca3088cb9b70"],
 " ."
}], "TechNoteText",
 CellID->1295337644,ExpressionUUID->"2ee5a131-1001-4a14-8c82-ea36df77693b"]
}, Open  ]]
}, Open  ]],

