Cell["Related functions", "TechNoteCaption",
 CellID->1701787266,ExpressionUUID->"44f39e8e-81c6-4db9-866a-84c035bede4b"],

Cell["Consider a many-body Hamiltonian", "TechNoteText",
 CellID->430066759,ExpressionUUID->"4fe3606d-c8f1-456f-8572-c5ed2acfb9b6"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["H", "^"], ":=", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], 
      SubscriptBox["\[CapitalSigma]", 
       RowBox[{"i", ",", "j"}]], 
      SuperscriptBox[
       UnderscriptBox["a", "_"], "\[Dagger]"], 
      SubscriptBox["H", 
       RowBox[{"i", "\[VeryThinSpace]", "j"}]], 
      SubscriptBox[
       OverscriptBox["a", "^"], "j"]}], "=", 
     RowBox[{
      FractionBox["\[ImaginaryI]", "4"], 
      SubscriptBox["\[CapitalSigma]", 
       RowBox[{"i", ",", "j"}]], 
      SubscriptBox[
       OverscriptBox["c", "^"], "i"], 
      SubscriptBox["A", 
       RowBox[{"i", "\[VeryThinSpace]", "j"}]], 
      SubscriptBox[
       OverscriptBox["c", "^"], "j"]}]}]}], TraditionalForm]],ExpressionUUID->
  "e9964968-349e-4787-88fd-ff456cca3cc3"],
 " ,"
}], "TechNoteText",
 CellID->1414119016,ExpressionUUID->"d0d2adf2-13d3-47da-aac5-db7638d48241"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox["H", TraditionalForm]],ExpressionUUID->
  "2bbf553a-77ca-406a-b705-842e0b0cdee9"],
 " is a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "n", "\[Times]", "2", "n", " "}], TraditionalForm]],
  ExpressionUUID->"bbe3f66b-2f53-463f-9c19-dc6c1fdd38a6"],
 StyleBox["Hermitian",
  FontSlant->"Italic"],
 " matrix and ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "ff31742f-2931-48d5-a19a-fbf07f76210a"],
 " is a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "n", "\[Times]", "2", "n"}], TraditionalForm]],ExpressionUUID->
  "5ce5266b-b0aa-492c-9d88-0756bc0c302a"],
 " real ",
 StyleBox["anti-symmetric",
  FontSlant->"Italic"],
 " matrix. Here, the many-body operators are denoted by hatted symbols; not \
to be confused with matrices denoted by pristine upper-case letters. Because \
of the explicit factors, the relation between ",
 Cell[BoxData[
  FormBox["H", TraditionalForm]],ExpressionUUID->
  "827cf633-c7d8-4204-90a6-4d30b2d20007"],
 " and ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "174b09a9-e500-4bff-80bb-354170db8113"],
 " are slightly different:"
}], "TechNoteText",
 CellID->358077209,ExpressionUUID->"77f3a3c2-a05f-4708-9d4d-c2e35780a161"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"H", "=", 
    RowBox[{
     FractionBox["\[ImaginaryI]", "2"], 
     SuperscriptBox["M", "\[Dagger]"], "A", " ", "M"}]}], TraditionalForm]],
  ExpressionUUID->"3f51a477-0e5e-403d-935b-72d1f1d8c6ab"],
 " , \t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "=", 
    RowBox[{
     RowBox[{"-", "2"}], "\[ImaginaryI]", " ", 
     SuperscriptBox["D", "\[Dagger]"], "H", " ", "D"}]}], TraditionalForm]],
  ExpressionUUID->"25a7dfa0-33ea-4a9f-abe8-d3129023ee91"],
 " ."
}], "TechNoteText",
 CellID->243940430,ExpressionUUID->"5648de4e-81f8-49bb-a742-82afce0d225f"]
}, Open  ]],

