Cell[TextData[{
 "Given unitary operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["U", "1"], ",", 
    SubscriptBox["U", "2"], ",", "\[Ellipsis]", ",", 
    SubscriptBox["U", "n"]}], TraditionalForm]],ExpressionUUID->
  "03310d3b-08b8-4499-a52c-47daacc5b421"],
 ", let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", ":=", 
    RowBox[{
     SubscriptBox["\[Sum]", "k"], 
     RowBox[{
      SubscriptBox["\[Alpha]", "k"], 
      SubscriptBox["U", "k"]}]}]}], TraditionalForm]],ExpressionUUID->
  "67719f8e-d2de-4c5d-8f1f-41cfa5558133"],
 " be a linear combination of those unitary operators, where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "k"], TraditionalForm]],ExpressionUUID->
  "885c5b87-b7fd-4346-9810-53706750ab36"],
 " are complex coefficients. In general, ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],ExpressionUUID->
  "e57be76a-0729-4d0f-9779-b8fa6e098707"],
 " is not unitary and cannot be implemented directly on a quantum computer. \
However, using an ancillary qubits, it can be implemented as discussed below. \
 It is a special case of ",
 ButtonBox["block encoding",
  BaseStyle->"Link",
  ButtonData->"paclet:QuantumMob/Q3/tutorial/BlockEncoding"],
 " using ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalO]", "(", 
    RowBox[{"log", " ", "K"}], ")"}], TraditionalForm]],ExpressionUUID->
  "0df70348-1456-44bf-a248-0e64d00036fa"],
 " ancilla qubits, where ",
 Cell[BoxData[
  FormBox["K", TraditionalForm]],ExpressionUUID->
  "b9b7ac6d-ddb0-471d-8fd4-70fbd381faa6"],
 " is the number of terms in the linear combination."
}], "TechNoteText",
 CellID->275259851,ExpressionUUID->"db327a72-2559-4333-9e5c-be7e776320bd"],

Cell[BoxData[GridBox[{
   {
