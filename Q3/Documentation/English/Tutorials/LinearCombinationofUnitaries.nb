Cell[BoxData[{
 RowBox[{
  RowBox[{"aa", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "/", "6"}], ",", 
      RowBox[{"2", "/", "6"}], ",", 
      RowBox[{"4", "/", "6"}], ",", 
      RowBox[{"5", "/", "6"}]}], "}"}], "*", "Pi"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ex", "=", 
   RowBox[{"MapIndexed", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"ExchangeExp", "[", 
       RowBox[{
        RowBox[{"#1", "*", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", "TT", ",", 
        RowBox[{"\"\<Label\>\"", "->", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<U\>\"", ",", 
           RowBox[{
            RowBox[{"First", "[", "#2", "]"}], "-", "1"}]}], "]"}]}]}], "]"}],
       "&"}], ",", "\[IndentingNewLine]", "aa"}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"QuantumCircuit", "@@", 
  RowBox[{"Riffle", "[", 
   RowBox[{"ex", ",", "\"\<Separator\>\""}], "]"}]}]}], "Input",
