Cell[TextData[{
 "In general, ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],ExpressionUUID->
  "c228b957-d958-42de-81fa-441f17c000d8"],
 " is not unitary, and cannot be directly implemented on a quantum computer. \
However, one can realize it probabilistically with a quantum circuit of the \
form and post-selection with respect to the ancilla register for state ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{"00", "\[Ellipsis]0"}]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "076ae2ae-b01d-4958-9117-152ff3ee4b1f"],
 ":"
}], "TechNoteMathCaption",
 CellID->47470155,ExpressionUUID->"55f3689c-beb3-459b-8da7-6df2c863394c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"qc", "=", 
  RowBox[{"QuantumCircuit", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Ket", "[", "AA", "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Through", "[", 
     RowBox[{"AA", "[", "6", "]"}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"UniformlyControlledGate", "[", 
     RowBox[{"AA", ",", "UU", ",", 
      RowBox[{"\"\<Label\>\"", "->", "\"\<U\>\""}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Through", "[", 
     RowBox[{"AA", "[", "6", "]"}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<Invisible\>\"", "->", 
     RowBox[{"A", "[", 
      RowBox[{"$m", "+", 
       RowBox[{"1", "/", "2"}]}], "]"}]}]}], "\[IndentingNewLine]", 
