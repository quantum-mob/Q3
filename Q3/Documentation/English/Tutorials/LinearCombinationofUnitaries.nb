Cell[TextData[{
 "To understate the above success probability, calculate the squared norm of \
operator ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],ExpressionUUID->
  "740bc24e-e0c7-486a-93f5-c054f14c7b45"],
 ", which gives the maximum success probability:"
}], "TechNoteMathCaption",
 CellID->188723714,ExpressionUUID->"d7460dc0-d87d-47d6-9b97-931fc0bc5e87"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"mat", "=", 
   RowBox[{"Total", "[", 
    RowBox[{"Matrix", "@", "ex"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"max", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Norm", "[", 
       RowBox[{"mat", ",", "2"}], "]"}], "^", "2"}], "/", "16"}], "//", "N"}],
    "//", "Chop"}]}]}], "Input",
 CellLabel->"In[23]:=",
 CellID->1600337733,ExpressionUUID->"d8f62554-938c-41c1-9243-22f7e2b92006"],

