}, Open  ]],

Cell["\<\
For the particular initial state, the success probability is given as follows:\
\>", "TechNoteMathCaption",
 CellID->1872304997,ExpressionUUID->"08f200bf-c555-48b3-9519-201190fad820"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"vv", "=", 
   RowBox[{"Matrix", "[", "in", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"prb", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Conjugate", "[", "vv", "]"}], ".", 
      RowBox[{"ConjugateTranspose", "[", "mat", "]"}], ".", "mat", ".", 
      "vv"}], "/", "16"}], "//", "N"}], "//", "Chop"}]}]}], "Input",
 CellLabel->"In[25]:=",
 CellID->255380146,ExpressionUUID->"6ce18377-b7fa-437c-892a-b7e50bdfc5bc"],

