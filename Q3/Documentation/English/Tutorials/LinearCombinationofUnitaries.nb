Cell[TextData[{
 "Consider a set of unitary gates ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["U", "0"], ",", 
     SubscriptBox["U", "1"], ",", 
     SubscriptBox["U", "2"], ",", 
     SubscriptBox["U", "3"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "16c097a4-1bf0-4fb3-92b7-a932c7c10ba7"],
 " on the system register of the form\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["U", "k"], ":=", 
    RowBox[{"exp", "[", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], "\[VeryThinSpace]", 
      RowBox[{
       SubscriptBox["\[Phi]", "k"], "(", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["T", "1", "X"], 
         SubsuperscriptBox["T", "2", "X"]}], "+", 
        RowBox[{
         SubsuperscriptBox["T", "1", "Y"], 
         SubsuperscriptBox["T", "2", "Y"]}], "+", 
        RowBox[{
         SubsuperscriptBox["T", "1", "Z"], 
         SubsuperscriptBox["T", "2", "Z"]}]}], ")"}]}], "]"}]}], 
   TraditionalForm]],ExpressionUUID->"962fc8a9-6f6e-471f-8a91-eeb6979654e5"],
 " ."
}], "TechNoteMathCaption",
 CellID->216503724,ExpressionUUID->"a0b0199d-76be-4331-8e57-bddea49134cd"],

