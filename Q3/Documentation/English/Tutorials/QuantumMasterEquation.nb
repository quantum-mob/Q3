Cell[CellGroupData[{

Cell["Quantum Jump Approach", "Subsection",
 CellID->248642970,ExpressionUUID->"59d28e16-59e7-4d6c-8272-e01eb364bf43"],

Cell[BoxData[GridBox[{
   {
    TemplateBox[{
      Cell[
       TextData["LindbladSimulate"]], 
      "paclet:QuantumMob/Q3/ref/LindbladSimulate", 
      "QuantumMob Package Symbol"},
     "PackageLink",
     BaseStyle->{"DefinitionBox", CellFrame -> 0}], Cell["\<\
Solve a quantum master equation using the quantum jump approach (Monte Carlo \
method).\
\>", "TechNoteTableText",ExpressionUUID->
     "a2f38acb-562c-4460-92b8-eb3ea8684cfc"]}
  }]], "DefinitionBox",
 CellID->913895715,ExpressionUUID->"662f3700-bd28-4c12-9817-c0c5973b1b61"],

Cell[TextData[{
 "Integrating quantum master equation gets quickly intractable as the system \
increases in size. For example, for a system of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "fffa4920-eba9-4999-b090-ba42d34555e4"],
 " qubits, one has to deal with an order of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["4", "n"], "\[Times]", 
    SuperscriptBox["4", "n"]}], TraditionalForm]],ExpressionUUID->
  "12430824-49e5-4785-be85-9ccc81b751f3"],
 "matrix; see ",
 ButtonBox["Equations (16)",
  BaseStyle->"Link",
  ButtonData->"paclet:QuantumMob/Q3/tutorial/QuantumMasterEquation#207578088"],
 " and ",
 ButtonBox["(17)",
  BaseStyle->"Link",
  ButtonData->
   "paclet:QuantumMob/Q3/tutorial/QuantumMasterEquation#1207975698"],
 ". The required memory is simply too large for most available computers. \
This is where the quantum jump approach  becomes extremely useful."
}], "TechNoteText",
 CellID->2086703375,ExpressionUUID->"1deffbb0-cd86-471f-8e82-76658a5f9479"],

Cell[TextData[{
 "\tTo understand the idea behind the quantum jump approach (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Plenio and Knight, 1998"]], 
    "https://doi.org/10.1103/RevModPhys.70.101"},
   "WebLink",
   BaseStyle->{"TechNoteText"}]],ExpressionUUID->
  "73cbdf27-0068-4c8e-885e-f5ad3f7312df"],
 "), note that for a short elapse ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], TraditionalForm]],
  ExpressionUUID->"99560a76-f298-4a34-9f1d-85dec1874382"],
 " of time from ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "53aba861-f7f4-4c8c-8e5a-f4deaeaf7441"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "+", 
    RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}]}], TraditionalForm]],
  ExpressionUUID->"6472000d-050a-4c00-aea3-3fb58cc2a0e0"],
 ", the density operator evolves as"
}], "TechNoteText",
 CellID->668184468,ExpressionUUID->"8e08afdb-9ce1-4f79-837c-3be611afc738"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", "(", 
     RowBox[{"t", "+", 
      RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}]}], ")"}], "\[TildeTilde]", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"I", "-", 
        RowBox[{
        "\[ImaginaryI]", "\[VeryThinSpace]", "\[Delta]", "\[VeryThinSpace]", 
         "t", "\[VeryThinSpace]", 
         SubscriptBox["L", "0"]}]}], ")"}], 
      RowBox[{"\[Rho]", "(", "t", ")"}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"I", "-", 
         RowBox[{
         "\[ImaginaryI]", "\[VeryThinSpace]", "\[Delta]", "\[VeryThinSpace]", 
          "t", "\[VeryThinSpace]", 
          SubscriptBox["L", "0"]}]}], ")"}], "\[Dagger]"]}], "+", 
     RowBox[{"\[Delta]", "\[VeryThinSpace]", "t", "\[VeryThinSpace]", 
      UnderoverscriptBox["\[CapitalSigma]", 
       RowBox[{"\[Mu]", "=", "1"}], 
       RowBox[{
        SuperscriptBox["d", "2"], "-", "1"}]], 
      SubscriptBox["L", "\[Mu]"], 
      RowBox[{"\[Rho]", "(", "t", ")"}], 
      SubsuperscriptBox["L", "\[Mu]", "\[Dagger]"]}]}], "\[TildeTilde]", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["U", "non"], "(", 
       RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], ")"}], 
      RowBox[{"\[Rho]", "(", "t", ")"}], 
      RowBox[{
       SubsuperscriptBox["U", "non", "\[Dagger]"], "(", 
       RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], ")"}]}], "+", 
     RowBox[{"\[Delta]", "\[VeryThinSpace]", "t", "\[VeryThinSpace]", 
      UnderoverscriptBox["\[CapitalSigma]", 
       RowBox[{"\[Mu]", "=", "1"}], 
       RowBox[{
        SuperscriptBox["d", "2"], "-", "1"}]], 
      SubscriptBox["L", "\[Mu]"], 
      RowBox[{"\[Rho]", "(", "t", ")"}], 
      SubsuperscriptBox["L", "\[Mu]", "\[Dagger]"]}]}]}], TraditionalForm]],
  ExpressionUUID->"d9c54354-6c90-4eac-94a0-5edd844f3a11"],
 " ,"
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->984363513,ExpressionUUID->"8b1e6566-e7f3-4223-affa-203768d7885c"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["U", "non"], "(", "t", ")"}], TraditionalForm]],
  ExpressionUUID->"71b1d212-346e-408d-93a1-1fca2076fb5d"],
 " is the non-unitary time-evolution operator associated with the effective \
non-Hermitian Hamiltonian ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "non"], TraditionalForm]],ExpressionUUID->
  "93afdd6e-30b3-4d1e-b7b1-6ffe802d064d"],
 "; that is,"
}], "TechNoteText",
 CellID->2131030150,ExpressionUUID->"d1e139a9-5c44-459e-8763-e2e5b38941d8"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["U", "non"], "(", "t", ")"}], ":=", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], "\[VeryThinSpace]", "t", "\[VeryThinSpace]", 
      SubscriptBox["H", "non"]}]]}], TraditionalForm]],ExpressionUUID->
  "94c7f37d-52f1-4a4c-b43a-f59ec3e6a155"],
 " ."
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->491466384,ExpressionUUID->"f2c83442-c9d4-41ef-891b-d6fe0ddbf8a5"],

Cell[TextData[{
 "We have ignored the term of the second and higher orders in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], TraditionalForm]],
  ExpressionUUID->"bee2ffb7-4e05-42e1-8daf-d375c3cce65e"],
 "."
}], "TechNoteText",
 CellID->853409526,ExpressionUUID->"8eaf830e-b93c-4eab-b8bd-58642b487152"],

Cell[TextData[{
 "\tConceptually, the key observation is that each term in ",
 ButtonBox["Equation (19)",
  BaseStyle->"Link",
  ButtonData->"paclet:QuantumMob/Q3/tutorial/QuantumMasterEquation#984363513"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["U", "non"], "(", 
     RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], ")"}], 
    RowBox[{"\[Rho]", "(", "t", ")"}], 
    RowBox[{
     SubsuperscriptBox["U", "non", "\[Dagger]"], "(", 
     RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], ")"}]}], 
   TraditionalForm]],ExpressionUUID->"afb4498c-2bf5-4cbe-b29b-9759c9cf11d5"],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "\[VeryThinSpace]", "t", " ", 
    SubscriptBox["L", "\[Mu]"], 
    RowBox[{"\[Rho]", "(", "t", ")"}], 
    SubsuperscriptBox["L", "\[Mu]", "\[Dagger]"]}], TraditionalForm]],
  ExpressionUUID->"2d433f0c-3475-41be-898b-d84898f8a753"],
 ", represents a possible quantum state that is determined randomly with \
probability \t"
}], "TechNoteText",
 CellID->210625169,ExpressionUUID->"9840c9ee-fea2-4487-a4fe-26dd0e7dcaa8"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "0"], ":=", 
    RowBox[{"Tr", "[", 
     RowBox[{
      RowBox[{
       SubscriptBox["U", "non"], "(", 
       RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], ")"}], 
      RowBox[{"\[Rho]", "(", "t", ")"}], 
      RowBox[{
       SubsuperscriptBox["U", "non", "\[Dagger]"], "(", 
       RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], ")"}]}], "]"}]}], 
   TraditionalForm]],ExpressionUUID->"c6e60183-dafe-4a90-b820-0f3ecbcefdf7"]
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->2048515405,ExpressionUUID->"e6982477-fb4a-4528-a5f0-58eef2c8ba36"],

Cell["or", "TechNoteText",
 CellID->103624565,ExpressionUUID->"0b2aa6d2-4b61-4354-8c1d-42d9c9706d5f"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "\[Mu]"], ":=", 
    RowBox[{"Tr", "[", 
     RowBox[{"\[Delta]", "\[VeryThinSpace]", "t", " ", 
      SubscriptBox["L", "\[Mu]"], 
      RowBox[{"\[Rho]", "(", "t", ")"}], 
      SubsuperscriptBox["L", "\[Mu]", "\[Dagger]"]}], "]"}]}], 
   TraditionalForm]],ExpressionUUID->"fd031e78-e4d8-4ce5-8663-bd897f678d94"],
 ". "
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->1204485777,ExpressionUUID->"c05444fa-4595-47e6-a941-87ce6de85b72"],

Cell[TextData[{
 "This means that to generate a trajectory of quantum state in the Hilbert \
space, we may just follow the spirit of Monte Carlo method and randomly apply \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Delta]", "\[VeryThinSpace]", 
     SubscriptBox["F", "0"]}], ":=", 
    RowBox[{
     SubscriptBox["U", "non"], "(", 
     RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], ")"}]}], 
   TraditionalForm]],ExpressionUUID->"7c6775b7-d459-4dd2-93a1-dec30c47626b"],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Delta]", "\[VeryThinSpace]", 
     SubscriptBox["F", "\[Mu]"]}], ":=", 
    RowBox[{
     SqrtBox[
      RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}]], 
     SubscriptBox["L", "\[Mu]"]}]}], TraditionalForm]],ExpressionUUID->
  "f2e2f16e-e89f-4f55-808e-81603760c314"],
 " with aforementioned probability at each time step ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "k"], ":=", 
    RowBox[{"k", "\[VeryThinSpace]", "\[Delta]", "\[VeryThinSpace]", "t"}]}], 
   TraditionalForm]],ExpressionUUID->"ff4333a4-44a2-486d-b2a4-51bb6c88c438"],
 ". For example, starting with an initial pure state ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"in"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "9b523b80-22e1-40a6-8946-8b4a0abed552"],
 ","
}], "TechNoteText",
 CellID->1690749513,ExpressionUUID->"4fae226f-0401-4efe-b185-b7903ba72358"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     TemplateBox[{
       RowBox[{"\[Psi]", "(", 
         SubscriptBox["t", "0"], ")"}]},
      "Ket"], "=", 
     TemplateBox[{"in"},
      "Ket"]}], ",", "\[LineSeparator]", 
    RowBox[{
     TemplateBox[{
       RowBox[{"\[Psi]", "(", 
         SubscriptBox["t", "1"], ")"}]},
      "Ket"], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Delta]", "\[VeryThinSpace]", 
        SubscriptBox["F", "0"]}], ")"}], 
      TemplateBox[{"in"},
       "Ket"]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     TemplateBox[{
       RowBox[{"\[Psi]", "(", 
         SubscriptBox["t", "2"], ")"}]},
      "Ket"], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Delta]", "\[VeryThinSpace]", 
        SubscriptBox["F", "2"]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"\[Delta]", "\[VeryThinSpace]", 
        SubscriptBox["F", "0"]}], ")"}], 
      TemplateBox[{"in"},
       "Ket"]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     TemplateBox[{
       RowBox[{"\[Psi]", "(", 
         SubscriptBox["t", "3"], ")"}]},
      "Ket"], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Delta]", "\[VeryThinSpace]", 
        SubscriptBox["F", "0"]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"\[Delta]", "\[VeryThinSpace]", 
        SubscriptBox["F", "2"]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"\[Delta]", "\[VeryThinSpace]", 
        SubscriptBox["F", "0"]}], ")"}], 
      TemplateBox[{"in"},
       "Ket"]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     TemplateBox[{
       RowBox[{"\[Psi]", "(", 
         SubscriptBox["t", "4"], ")"}]},
      "Ket"], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Delta]", "\[VeryThinSpace]", 
        SubscriptBox["F", "1"]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"\[Delta]", "\[VeryThinSpace]", 
        SubscriptBox["F", "0"]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"\[Delta]", "\[VeryThinSpace]", 
        SubscriptBox["F", "2"]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"\[Delta]", "\[VeryThinSpace]", 
        SubscriptBox["F", "0"]}], ")"}], 
      TemplateBox[{"in"},
       "Ket"]}]}], ",", "\[IndentingNewLine]", "\[Ellipsis]"}], 
   TraditionalForm]],ExpressionUUID->"47a99ebb-d5c1-4da0-8245-03503600ca04"]
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->924165127,ExpressionUUID->"bcf784d5-516f-459e-9ff8-1882f857bb3b"],

Cell[TextData[{
 "is a possible trajectory. By repeating the same procedure, one can realize \
many trajectories. The density matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "(", 
    SubscriptBox["t", "k"], ")"}], TraditionalForm]],ExpressionUUID->
  "94902f65-cc63-4dc4-b275-25b323468cba"],
 " at each time step ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "k"], TraditionalForm]],ExpressionUUID->
  "439b5a6a-7380-402f-9005-066f9ffa1342"],
 " can be obtained by taking the statistical mixture from all resulting \
trajectories,"
}], "TechNoteText",
 CellID->1841554385,ExpressionUUID->"17d2d3ec-9468-4f72-a7a1-0efc014932eb"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", "(", 
     SubscriptBox["t", "k"], ")"}], "=", 
    RowBox[{
     UnderscriptBox["\[CapitalSigma]", "trajectories"], 
     TemplateBox[{
       RowBox[{"\[Psi]", "(", 
         SubscriptBox["t", "k"], ")"}]},
      "Ket"], 
     TemplateBox[{
       RowBox[{"\[Psi]", "(", 
         SubscriptBox["t", "k"], ")"}]},
      "Bra"]}]}], TraditionalForm]],ExpressionUUID->
  "538f5aa5-2f57-43cd-a4b8-c6dae3dcea8a"],
 " ."
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->1470228131,ExpressionUUID->"6cf5d299-0510-413e-bd5d-126ef6b6aebb"],

Cell[TextData[{
 "\tTechnically, the key advantage of the quantum jump approach is that it \
only requires memory to store a complex vector of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "n"], TraditionalForm]],ExpressionUUID->
  "3eeaf70e-c62e-4325-bcfb-7b6be77da0b5"],
 " components for updating the state at each time step. Additional memory is \
needed to store the trajectories, but for the trajectory data, one can also \
utilize external storage."
}], "TechNoteText",
 CellID->1177355335,ExpressionUUID->"00bf5f09-9672-4c4b-9da5-d75b14820e08"],

Cell[CellGroupData[{

Cell["Example", "Subsubsection",
 CellID->400079759,ExpressionUUID->"83eb801c-3ae2-4688-b5ee-fe22e2428cd5"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<QuantumMob`Q3`\>\"", "]"}]], "Input",
 CellLabel->"In[18]:=",
 CellID->974935498,ExpressionUUID->"3080ba5f-08b7-4c83-9d9a-614fd1451851"],

Cell["Let us consider a system of qubits.", "TechNoteMathCaption",
 CellID->501695840,ExpressionUUID->"92d03631-a3f1-4801-9b03-7cca4eb5ffce"],

Cell[BoxData[
 RowBox[{"Let", "[", 
  RowBox[{"Qubit", ",", "S"}], "]"}]], "Input",
 CellLabel->"In[19]:=",
 CellID->208984626,ExpressionUUID->"fc405421-7d16-4ceb-a9ae-4803b4923afa"],

Cell["Take an effective Hamiltonian.", "TechNoteMathCaption",
 CellID->1723732938,ExpressionUUID->"a18f2d34-2419-4093-af9a-95d55ef1b5d6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"opH", "=", 
  RowBox[{"S", "[", "3", "]"}]}]], "Input",
 CellLabel->"In[20]:=",
 CellID->1225090936,ExpressionUUID->"ae0a31f4-80f5-4a11-ae29-0b39d3983f0e"],

Cell[BoxData[
 InterpretationBox[
  TemplateBox[{"S", 
    TemplateBox[{"\[ThinSpace]", "\"\[ThinSpace]\"", "\"Z\""}, 
     "RowWithSeparators"]},
   "Superscript"],
  $CellContext`S[3]]], "Output",
 CellLabel->"Out[20]=",
 CellID->724960039,ExpressionUUID->"1bd9e5e3-9b68-44d4-8b31-b9ae2f9be2b0"]
}, Open  ]],

Cell["Consider the bit-flip noises as quantum jump operators.", \
"TechNoteMathCaption",
 CellID->2138209167,ExpressionUUID->"a26d6a27-95a6-47d7-804d-fcd296cf634e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Let", "[", 
  RowBox[{"Real", ",", "\[CapitalGamma]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"opL", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"\[CapitalGamma]", "[", "\"\<+\>\"", "]"}], "]"}], " ", 
     RowBox[{"S", "[", "4", "]"}]}], ",", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"\[CapitalGamma]", "[", "\"\<-\>\"", "]"}], "]"}], 
     RowBox[{"S", "[", "5", "]"}]}]}], "}"}]}]}], "Input",
 CellLabel->"In[21]:=",
 CellID->890120871,ExpressionUUID->"8222122c-d23b-428d-85ec-a3e627ab9152"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    InterpretationBox[
     TemplateBox[{"S", 
       TemplateBox[{"\[ThinSpace]", "\"\[ThinSpace]\"", "\"+\""}, 
        "RowWithSeparators"]},
      "Superscript"],
     $CellContext`S[4]], " ", 
    SqrtBox[
     InterpretationBox[
      SubscriptBox["\[CapitalGamma]", 
       TemplateBox[{",", "\",\"", "\"+\""},
        "RowWithSeparators"]],
      $CellContext`\[CapitalGamma]["+"]]]}], ",", 
   RowBox[{
    InterpretationBox[
     TemplateBox[{"S", 
       TemplateBox[{"\[ThinSpace]", "\"\[ThinSpace]\"", "\"-\""}, 
        "RowWithSeparators"]},
      "Superscript"],
     $CellContext`S[5]], " ", 
    SqrtBox[
     InterpretationBox[
      SubscriptBox["\[CapitalGamma]", 
       TemplateBox[{",", "\",\"", "\"-\""},
        "RowWithSeparators"]],
      $CellContext`\[CapitalGamma]["-"]]]}]}], "}"}]], "Output",
 CellLabel->"Out[22]=",
 CellID->1728646042,ExpressionUUID->"14dc2a2c-1732-4779-aa73-0d2ec7393c7a"]
}, Open  ]],

Cell["Take an initial state.", "TechNoteMathCaption",
 CellID->1184140969,ExpressionUUID->"48c161b3-b593-45e7-a4de-669d7ceb3ca6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"in", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Ket", "[", "]"}], "+", 
      RowBox[{"Ket", "[", 
       RowBox[{"S", "->", "1"}], "]"}]}], ")"}], "/", 
    RowBox[{"Sqrt", "[", "2", "]"}]}], "//", "KetRegulate"}]}]], "Input",
 CellLabel->"In[23]:=",
 CellID->1126309234,ExpressionUUID->"b3a101e4-e397-42b1-a9e0-2d0805db58a2"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   InterpretationBox[
    TemplateBox[{
      TemplateBox[{"\[VeryThinSpace]", "\"\[VeryThinSpace]\"", 
        SubscriptBox["0", 
         TemplateBox[{",", "\",\"", 
           InterpretationBox["S", 
            $CellContext`S[QuantumMob`Q3`$]]}, "RowWithSeparators"]]}, 
       "RowWithSeparators"]},
     "Ket"],
    Ket[<|$CellContext`S[QuantumMob`Q3`$] -> 0|>]], "+", 
   InterpretationBox[
    TemplateBox[{
      TemplateBox[{"\[VeryThinSpace]", "\"\[VeryThinSpace]\"", 
        SubscriptBox["1", 
         TemplateBox[{",", "\",\"", 
           InterpretationBox["S", 
            $CellContext`S[QuantumMob`Q3`$]]}, "RowWithSeparators"]]}, 
       "RowWithSeparators"]},
     "Ket"],
    Ket[<|$CellContext`S[QuantumMob`Q3`$] -> 1|>]]}], 
  SqrtBox["2"]]], "Output",
 CellLabel->"Out[23]=",
 CellID->47767631,ExpressionUUID->"bb8f0eac-163d-4349-9e4a-c05b90b50f33"]
}, Open  ]],

Cell["\<\
Pick the time slices at which the trajectory points are fixed.\
\>", "TechNoteMathCaption",
 CellID->1174017344,ExpressionUUID->"1f6de4c2-07c9-4b26-9957-3d7b74fc95f0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tt", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", "10", ",", "0.05"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[24]:=",
 CellID->1225147428,ExpressionUUID->"ddc1b231-a168-483e-997b-439975cc20b3"],

Cell["\<\
Simulate the Lindblad equation using the quantum jump approach.\
\>", "TechNoteMathCaption",
 CellID->1958431180,ExpressionUUID->"01a1490e-6e0b-4833-a6d2-4ce45cb0dffd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EchoTiming", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"data", "=", 
    RowBox[{"Block", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[CapitalGamma]", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalGamma]", "[", "\"\<+\>\"", "]"}], "=", ".3"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[CapitalGamma]", "[", "\"\<-\>\"", "]"}], "=", ".7"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"LindbladSimulate", "[", 
        RowBox[{
        "opH", ",", "opL", ",", "in", ",", "tt", ",", "\[IndentingNewLine]", 
         RowBox[{"\"\<Samples\>\"", "->", "100"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellLabel->"In[25]:=",
 CellID->870984691,ExpressionUUID->"bad44bf9-7342-40df-8ee8-dc7927d768dc"],

Cell[BoxData["0.201879`"], "EchoTiming",
 CellID->1130819663,ExpressionUUID->"eecb1845-b71a-4d52-af36-b9943b9d1220"]
}, Open  ]],

Cell[TextData[{
 "Construct the density matrix at each times. Again, notice ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Transpose"]], "paclet:ref/Transpose"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4db5a6ce-351d-4475-8dce-cd4038db7c70"],
 " here; for the form of the output data, see the ",
 ButtonBox["Details and Options",
  BaseStyle->"Link",
  ButtonData->"paclet:QuantumMob/Q3/ref/LindbladSimulate#1226658091"],
 " section section above."
}], "TechNoteMathCaption",
 CellID->1382089322,ExpressionUUID->"c0d02b34-5283-407d-b705-37a4225040fa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rho", "=", 
   RowBox[{"Mean", "/@", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Dyad", "[", 
        RowBox[{"#", ",", "#"}], "]"}], "&"}], ",", 
      RowBox[{"Transpose", "@", "data"}], ",", 
      RowBox[{"{", "2", "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Dimensions", "[", "rho", "]"}]}], "Input",
 CellLabel->"In[26]:=",
 CellID->988622654,ExpressionUUID->"0eccc16c-a067-4e57-81b0-bf3ddc17af48"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"201", ",", "2", ",", "2"}], "}"}]], "Output",
 CellLabel->"Out[27]=",
 CellID->455800091,ExpressionUUID->"d4f26280-244b-42f1-9a8d-3e45e4694f7a"]
}, Open  ]],

Cell["\<\
As an example, calculate the averages of the Pauli X, Y, and Z operators.\
\>", "TechNoteMathCaption",
 CellID->1459452562,ExpressionUUID->"4be89781-ef92-4c92-b325-014b39ca446b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"II", "=", 
   RowBox[{"Transpose", "@", 
    RowBox[{"{", 
     RowBox[{"tt", ",", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Tr", "[", "#", "]"}], "&"}], ",", "rho"}], "]"}]}], 
     "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"XX", "=", 
   RowBox[{"Transpose", "@", 
    RowBox[{"{", 
     RowBox[{"tt", ",", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"ThePauli", "[", "1", "]"}], ".", "#"}], "]"}], "&"}], ",",
         "rho"}], "]"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"YY", "=", 
   RowBox[{"Transpose", "@", 
    RowBox[{"{", 
     RowBox[{"tt", ",", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"ThePauli", "[", "2", "]"}], ".", "#"}], "]"}], "&"}], ",",
         "rho"}], "]"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ZZ", "=", 
   RowBox[{"Transpose", "@", 
    RowBox[{"{", 
     RowBox[{"tt", ",", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"ThePauli", "[", "3", "]"}], ".", "#"}], "]"}], "&"}], ",",
         "rho"}], "]"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"XX", ",", "YY", ",", "ZZ"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Joined", "->", "True"}], ",", "\[IndentingNewLine]", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*SubscriptBox[\(B\), \(z\)]\) t\>\"", 
      ",", "\"\<\[LeftAngleBracket]X\[RightAngleBracket], \
\[LeftAngleBracket]Y\[RightAngleBracket], \[LeftAngleBracket]Z\
\[RightAngleBracket]\>\""}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
 CellLabel->"In[28]:=",
 CellID->460993500,ExpressionUUID->"3815fd50-2ead-4013-bfb9-b3ac88cb04b3"],

