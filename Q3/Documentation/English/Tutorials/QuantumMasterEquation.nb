Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<QuantumMob`Q3`\>\"", "]"}]], "Input",
 CellLabel->"In[158]:=",
 CellID->1208734507,ExpressionUUID->"28ff1659-aeb0-4a5a-98b5-f133ccb48e26"],

Cell[CellGroupData[{

Cell["General Form", "TechNoteSection",
 CellID->829965404,ExpressionUUID->"fad751e8-d7c3-4a41-be45-b9034d46e5c2"],

Cell[TextData[{
 "Within the Markov approximation, the density operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "9fb16f2b-cbc1-40aa-af31-5798f05a27fa"],
 " satisfies a differential equation of the form,"
}], "TechNoteText",
 CellID->1322257763,ExpressionUUID->"92e9588e-a0b0-4c6b-8d26-9b547d4d0b09"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["d\[Rho]", 
     RowBox[{"d", "\[VeryThinSpace]", "t"}]], "=", 
    RowBox[{"\[ScriptCapitalL]", "(", "\[Rho]", ")"}]}], TraditionalForm]],
  ExpressionUUID->"3f6bfda6-01e7-4430-8efc-f0c7ddf8e0e2"],
 ","
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->356024661,ExpressionUUID->"43b96575-a381-49c3-b8ac-defb31aec02e"],

Cell[TextData[{
 "which is called the ",
 StyleBox["quantum master equation",
  FontSlant->"Italic"],
 " or ",
 StyleBox["Lindblad equation",
  FontSlant->"Italic"],
 ". Here, the superoperator ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalL]", TraditionalForm]],ExpressionUUID->
  "7e7a2f92-c3b9-4b5b-a0ec-3c727ba0830b"],
 " defined by"
}], "TechNoteText",
 CellID->1025443585,ExpressionUUID->"35d5de03-a799-4445-aca1-0272f5b5b59a"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[ScriptCapitalL]", "(", "\[Rho]", ")"}], ":=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"\[ImaginaryI]", "[", 
       RowBox[{"H", ",", "\[Rho]"}], "]"}]}], "+", 
     RowBox[{
      UnderscriptBox["\[CapitalSigma]", "\[Mu]"], "(", 
      RowBox[{
       RowBox[{
        SubscriptBox["L", "\[Mu]"], "\[Rho]", " ", 
        SubsuperscriptBox["L", "\[Mu]", "\[Dagger]"]}], "-", 
       RowBox[{
        FractionBox["1", "2"], 
        SubsuperscriptBox["L", "\[Mu]", "\[Dagger]"], 
        SubscriptBox["L", "\[Mu]"], "\[Rho]"}], "-", 
       RowBox[{
        FractionBox["1", "2"], "\[Rho]", " ", 
        SubsuperscriptBox["L", "\[Mu]", "\[Dagger]"], 
        SubscriptBox["L", "\[Mu]"]}]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"7d13ea34-24bd-478c-982c-266487a7c5ea"],
 " ,"
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->1074065920,ExpressionUUID->"4c9623ca-6e26-4ba4-8c5a-fcafc650ff31"],

Cell[TextData[{
 "generates the quantum Markovian dynamics and is called the ",
 StyleBox["Lindblad generator",
  FontSlant->"Italic"],
 ". The Hermitian operator ",
 Cell[BoxData[
  FormBox["H", TraditionalForm]],ExpressionUUID->
  "88a5710a-9329-4160-8018-32e62c06a81f"],
 " in the above equation describes the unitary part of the dynamics. For this \
reason, ",
 Cell[BoxData[
  FormBox["H", TraditionalForm]],ExpressionUUID->
  "0b139ab0-69fe-4cbd-9a33-8b638b632a0c"],
 " is often called the ",
 StyleBox["effective Hamiltonian",
  FontSlant->"Italic"],
 " of the system, but in general it is not the same as the Hamiltonian when \
the system is isolated. The operators ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "dbb50adb-e26c-4e92-9949-e3ada1295362"],
 " are responsible for the non-unitary dynamics and are called the ",
 StyleBox["Lindblad operators",
  FontSlant->"Italic"],
 " or ",
 StyleBox["quantum jump operators",
  FontSlant->"Italic"],
 "."
}], "TechNoteText",
 CellID->78380758,ExpressionUUID->"e20c0c7e-4ea6-4ca7-84b6-b41a3e6e1b38"],

Cell["\<\
\tIt is also customary to rewrite the Lindblad generator into the form\
\>", "TechNoteText",
 CellID->937924095,ExpressionUUID->"e9b8c30f-7b15-479a-a60b-1665442c5417"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[ScriptCapitalL]", "(", "\[Rho]", ")"}], ":=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"\[ImaginaryI]", "[", 
       RowBox[{"H", ",", "\[Rho]"}], "]"}]}], "-", 
     RowBox[{"{", 
      RowBox[{"G", ",", "\[Rho]"}], "}"}], "+", 
     RowBox[{
      UnderscriptBox["\[CapitalSigma]", "\[Mu]"], 
      SubscriptBox["L", "\[Mu]"], "\[Rho]", " ", 
      SubsuperscriptBox["L", "\[Mu]", "\[Dagger]"]}]}]}], TraditionalForm]],
  ExpressionUUID->"c1c40587-bfb9-4398-bfd7-76b87713f971"],
 " ,"
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->1160295685,ExpressionUUID->"1ea84224-1dc5-4a15-9af2-7a8e01107a94"],

Cell["where", "TechNoteText",
 CellID->1938063035,ExpressionUUID->"1121964e-ef51-4c68-b517-02f575ea9ea0"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", ":=", 
    RowBox[{
     FractionBox["1", "2"], 
     UnderscriptBox["\[CapitalSigma]", "\[Mu]"], 
     SubsuperscriptBox["L", "\[Mu]", "\[Dagger]"], 
     SubscriptBox["L", "\[Mu]"]}]}], TraditionalForm]],ExpressionUUID->
  "86beeb2e-aed7-46f9-bea1-76f7cfd87c9c"],
 " ."
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->2140955196,ExpressionUUID->"568d7469-5706-41da-865c-cb82aa289126"],

Cell["\<\
Interestingly, ignoring the last term in the quantum jump operators, the \
solution to the approximate quantum master equation,\
\>", "TechNoteText",
 CellID->1945473687,ExpressionUUID->"49b45474-a8b1-4399-8b94-63fb44aad589"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["d\[Rho]", 
     RowBox[{"d", "\[VeryThinSpace]", "t"}]], "\[TildeTilde]", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"\[ImaginaryI]", "[", 
       RowBox[{"H", ",", "\[Rho]"}], "]"}]}], "-", 
     RowBox[{"{", 
      RowBox[{"G", ",", "\[Rho]"}], "}"}]}]}], TraditionalForm]],
  ExpressionUUID->"1364d4e8-e520-4105-9121-1489f003305a"],
 " ,"
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->2137731834,ExpressionUUID->"25256b04-ba53-4d1f-bdae-4114ac1ffafb"],

Cell["is simply given by ", "TechNoteText",
 CellID->1457519728,ExpressionUUID->"6b81e2fd-b981-4e35-8493-bd4735cf09c8"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", "(", "t", ")"}], "\[TildeTilde]", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], "\[VeryThinSpace]", "t", "\[VeryThinSpace]", 
       SubscriptBox["H", "non"]}]], 
     RowBox[{"\[Rho]", "(", "0", ")"}], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"+", "\[ImaginaryI]"}], "\[VeryThinSpace]", "t", "\[VeryThinSpace]", 
       SubsuperscriptBox["H", "non", "\[Dagger]"]}]]}]}], TraditionalForm]],
  ExpressionUUID->"12aae6bf-9b2d-4b39-9310-0289e8a296b6"],
 " ,"
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->188107167,ExpressionUUID->"1cad711f-41de-47a8-bd38-3d3b4c324f36"],

Cell[TextData[{
 "which resembles the unitary dynamics with Hamiltonian ",
 Cell[BoxData[
  FormBox["H", TraditionalForm]],ExpressionUUID->
  "3734c212-d93c-4171-86a4-498850579c2f"],
 " replaced with the effective non-Hermitian Hamiltonian "
}], "TechNoteText",
 CellID->421227385,ExpressionUUID->"a59eebb8-ee37-4a1e-8566-457055a6e487"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["H", "non"], ":=", 
    RowBox[{"H", "-", 
     RowBox[{"\[ImaginaryI]", "\[VeryThinSpace]", "G"}]}]}], 
   TraditionalForm]],ExpressionUUID->"d5f79760-a053-4d50-82cc-e08c5fe9bc1d"],
 " ."
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->1462559183,ExpressionUUID->"c00535f6-ad97-49eb-aab1-d17a3f6087b6"],

Cell[TextData[{
 "The additional term in ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "47fd4201-5179-4c80-9dc8-9f5369a6f08e"],
 " of the non-Hermitian Hamiltonian makes a significant difference in the \
evolution governed  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], "\[VeryThinSpace]", "t", "\[VeryThinSpace]", 
     SubscriptBox["H", "non"]}]], TraditionalForm]],ExpressionUUID->
  "01e72746-1579-4644-ba75-9e48c61e01ab"],
 " since it causes damping and leads to irreversible population loss in the \
eigenstates of ",
 Cell[BoxData[
  FormBox["H", TraditionalForm]],ExpressionUUID->
  "7c8c4258-dbdd-462a-9ec1-87398d64a1e7"],
 ". To put it in another way, probability is not conserved any longer,"
}], "TechNoteText",
 CellID->1134365119,ExpressionUUID->"496c590e-50fd-4982-818f-6d535f19d8cf"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Tr", "[", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], "\[VeryThinSpace]", "t", "\[VeryThinSpace]", 
        SubscriptBox["H", "non"]}]], 
      RowBox[{"\[Rho]", "(", "0", ")"}], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"+", "\[ImaginaryI]"}], "\[VeryThinSpace]", "t", "\[VeryThinSpace]", 
        SubsuperscriptBox["H", "non", "\[Dagger]"]}]]}], "]"}], "=", 
    RowBox[{
     RowBox[{"Tr", "[", 
      RowBox[{
       RowBox[{"\[Rho]", "(", "0", ")"}], 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "G"}], "+", 
         RowBox[{
         "\[ImaginaryI]", "\[VeryThinSpace]", "t", "\[VeryThinSpace]", 
          "H"}]}]], 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "G"}], "-", 
         RowBox[{
         "\[ImaginaryI]", "\[VeryThinSpace]", "t", "\[VeryThinSpace]", 
          "H"}]}]]}], "]"}], "<", "1"}]}], TraditionalForm]],ExpressionUUID->
  "3d5da107-f698-4b4b-a2e3-17bfa3862801"],
 " ,"
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->2062220614,ExpressionUUID->"80e10e8a-6d49-45df-bbb6-4c6923df48c2"],

Cell[TextData[{
 "because ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "91291722-8d67-402e-8e8b-6bc964cdb8b0"],
 " is positive. In this sense, we call ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "fc6ac6c1-51b2-4543-8785-a0311295663b"],
 " the ",
 StyleBox["effective damping operator",
  FontSlant->"Italic"],
 ". Physically, other processes described by Lindblad operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "\[Mu]"], " "}], TraditionalForm]],ExpressionUUID->
  "ab72d1eb-b4ce-4bba-820f-066bd1175dd2"],
 " account for the loss in probability."
}], "TechNoteText",
 CellID->1503280565,ExpressionUUID->"73ce6987-626e-48b5-8810-0956da05394c"],

Cell[TextData[{
 "\tAlthough the non-Hermitian Hamiltonian approach does not explain all \
decoherence processes, it lays out an intuitively appealing picture of open \
systems and has been widely used to describe the effects of a finite life \
time of (effective) energy levels. The non-Hermitian Hamiltonian also \
provides a good starting point for various more elaborate methods to \
investigate decoherence processes. A common example is the so-called ",
 StyleBox[ButtonBox["quantum jump approach",
  BaseStyle->"Link",
  ButtonData->"paclet:QuantumMob/Q3/tutorial/QuantumMasterEquation#248642970"],
  FontSlant->"Italic"],
 ". It is an approximate method to solve the quantum master equation \
combining the aforementioned non-unitary evolution due to the non-Hermitian \
Hamiltonian and the \[OpenCurlyDoubleQuote]quantum jumps\
\[CloseCurlyDoubleQuote] due to the quantum jump operators ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "2c0a811e-cbfc-4d1e-bf90-4f4d7e6a28d4"],
 " (Dum ",
 StyleBox["et al",
  FontSlant->"Italic"],
 "., 1992; Plenio and Knight, 1998)."
}], "TechNoteText",
 CellID->491349000,ExpressionUUID->"873b4716-c737-4b7c-a850-1ac31f4c10fe"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Derivation", "TechNoteSection",
 CellID->1028020285,ExpressionUUID->"d0face15-c9db-48b0-b330-abb06d1ab971"],

Cell[TextData[{
 "It is straightforward to derive the quantum master equation starting from \
the ",
 ButtonBox["Kraus representation",
  BaseStyle->"Link",
  ButtonData->"paclet:QuantumMob/Q3/tutorial/QuantumOperations#982874389"],
 " under the Markov assumption (see, e.g., Breuer and Petruccione (2002) for \
details). Here, we take a heuristic approach, which is more useful to \
understand the underlying physics. More common approach is to reduce, often \
approximately, the ",
 ButtonBox["unitary dynamics of the total system",
  BaseStyle->"Link",
  ButtonData->"paclet:QuantumMob/Q3/tutorial/QuantumOperations#1215528911"],
 " consisting of the system and environment (see also Section 5.2.3) to the \
quantum master equation for the system only. Some examples including \
perturbative methods are discussed in Breuer and Petruccione (2002)."
}], "TechNoteText",
 CellID->1991605227,ExpressionUUID->"c7c3648a-dd03-46cd-bbba-7c89ea5ab0a0"],

Cell[TextData[{
 "\tConsider an infinitesimal elapse ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], TraditionalForm]],
  ExpressionUUID->"2cc8171b-07a6-47b0-ab9b-e19682dcc8a9"],
 " of time from ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "f84230a1-06e5-4227-aa19-4ff72282dbb2"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"t", "'"}], ":=", 
    RowBox[{"t", "+", 
     RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}]}]}], TraditionalForm]],
  ExpressionUUID->"71fa0b96-6ab7-438b-b682-cf35890c56ec"],
 ". The density operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "(", 
    RowBox[{"t", "'"}], ")"}], TraditionalForm]],ExpressionUUID->
  "6b321145-3eca-4d2a-bee3-e9c458d57e8c"],
 " is related to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "6a180a01-c0fa-4a0e-9a20-555c8d46343a"],
 " by the Kraus representation"
}], "TechNoteText",
 CellID->1430989880,ExpressionUUID->"b03ed815-88fb-449b-98fe-a916cc5c026d"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", "(", 
     RowBox[{"t", "'"}], ")"}], "=", 
    RowBox[{
     UnderscriptBox["\[CapitalSigma]", "\[Mu]"], 
     RowBox[{
      SubscriptBox["F", "\[Mu]"], "(", 
      RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], ")"}], 
     RowBox[{"\[Rho]", "(", "t", ")"}], " ", 
     RowBox[{
      SubsuperscriptBox["F", "\[Mu]", "\[Dagger]"], "(", 
      RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"c6ef64a0-9605-4667-916b-30b399558237"],
 " ,"
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->909584588,ExpressionUUID->"27c28cbb-0cba-4128-a7a1-d8ab129ca838"],

Cell[TextData[{
 "where we have imposed the Markovian approximation.  For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], "\[TildeTilde]", "0"}], 
   TraditionalForm]],ExpressionUUID->"eeceddbf-efc9-4804-85c5-c8fd002d99a5"],
 ", it is physically required that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", "(", 
     RowBox[{"t", "'"}], ")"}], "\[TildeTilde]", 
    RowBox[{"\[Rho]", "(", "t", ")"}]}], TraditionalForm]],ExpressionUUID->
  "521e6f56-b698-44fa-ad15-b25f5efa3006"],
 ". This implies that one and only one of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", 
     RowBox[{"\[Mu]", " "}]], "(", 
    RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], ")"}], TraditionalForm]],
  ExpressionUUID->"af050da6-286d-4058-b749-bfdbb68fb2e0"],
 " must approach the identity operator ",
 Cell[BoxData[
  FormBox["I", TraditionalForm]],ExpressionUUID->
  "8fc6436c-a2af-4ddc-ba3c-bf45a39cae1f"],
 ". Let us denote it by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", "0"], "(", 
    RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], ")"}], TraditionalForm]],
  ExpressionUUID->"0b7f1c95-fd30-4a09-9adc-40ec53dcf160"],
 ". Up to the first order in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], TraditionalForm]],
  ExpressionUUID->"2708662a-e199-40ad-863a-5452370b10a1"],
 ","
}], "TechNoteText",
 CellID->977550407,ExpressionUUID->"511c335e-07ac-4abb-9c99-4bbf686922d2"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["F", "0"], "(", 
     RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], ")"}], "\[TildeTilde]", 
    RowBox[{"I", "-", 
     RowBox[{
     "\[ImaginaryI]", "\[VeryThinSpace]", "\[Delta]", "\[VeryThinSpace]", "t",
       " ", 
      SubscriptBox["L", "0"]}]}]}], TraditionalForm]],ExpressionUUID->
  "20486686-7c57-48be-b8ef-2fe41f5e589f"],
 " ,"
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->1439790899,ExpressionUUID->"31dda6f6-6450-4cfa-b149-080db908ef1b"],

Cell[TextData[{
 "where the additional factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "\[ImaginaryI]"}], TraditionalForm]],ExpressionUUID->
  "a48ff631-de53-4ad7-91e8-51087d65d748"],
 " is completely arbitrary at this stage but is introduced here for later \
convenience. The rest should vanish ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["F", "\[Mu]"], "(", 
     RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], ")"}], "\[RightArrow]", 
    "0"}], TraditionalForm]],ExpressionUUID->
  "bca4bd0e-6066-4e54-a59d-d059ac6b2100"],
 " for any ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", "\[NotEqual]", "0"}], TraditionalForm]],ExpressionUUID->
  "997f13e6-a9f1-4f37-8646-751c5d0a1ca6"],
 ". Since we physically expect that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", "(", 
     RowBox[{"t", "'"}], ")"}], "\[TildeTilde]", 
    RowBox[{
     RowBox[{"\[Rho]", "(", "t", ")"}], "+", 
     RowBox[{"\[ScriptCapitalO]", "(", 
      RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"a0157a4f-8202-4478-bd97-6c897522334a"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", "\[Mu]"], "(", 
    RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], ")"}], TraditionalForm]],
  ExpressionUUID->"ab05f10b-5f90-4474-972b-05db2fbe0431"],
 " must vanish like ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}]], TraditionalForm]],
  ExpressionUUID->"5d092959-7a51-4eaf-9340-0644ba80e788"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], TraditionalForm]],
  ExpressionUUID->"459b499f-9100-4f7e-a2d6-36ee1412ce8d"],
 " so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["F", "\[Mu]"], "(", 
      RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], ")"}], 
     RowBox[{"\[Rho]", "(", "t", ")"}], 
     RowBox[{
      SubsuperscriptBox["F", "\[Mu]", "\[Dagger]"], "(", 
      RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], ")"}]}], "\[TildeTilde]", 
    RowBox[{"\[ScriptCapitalO]", "(", 
     RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], ")"}]}], 
   TraditionalForm]],ExpressionUUID->"7027555e-12bc-48d3-87cd-3d18c98e2f59"],
 ". We put"
}], "TechNoteText",
 CellID->719905097,ExpressionUUID->"0f8faa88-443d-496e-9092-9196611a0ffc"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["F", "\[Mu]"], "(", 
     RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}], ")"}], "\[TildeTilde]", 
    RowBox[{
     SqrtBox[
      RowBox[{" ", 
       RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}]}]], 
     SubscriptBox["L", "\[Mu]"]}]}], TraditionalForm]],ExpressionUUID->
  "cb1f814d-58cd-44ba-9de8-30887649fecb"],
 "  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[Mu]", "\[NotEqual]", "0"}], ")"}], TraditionalForm]],
  ExpressionUUID->"ff02f146-ef28-47e6-9cbc-993234c3923d"],
 " ."
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->522098081,ExpressionUUID->"10423464-cbc0-4d2c-a92d-085010cfc71d"],

Cell[TextData[{
 "Since ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "79482230-34de-4bf3-aa3b-fda98ff8538e"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", "\[NotEqual]", "0"}], TraditionalForm]],ExpressionUUID->
  "285ef27a-cc13-48f8-adf1-44bf52f374ca"],
 ") directly proportional to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "b5fbfc83-037a-40ee-a9fd-82fbbf5c07d7"],
 ", they are all traceless and mutually orthogonal; i.e., ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Tr", "[", 
     RowBox[{
      SubsuperscriptBox["L", "\[Mu]", "\[Dagger]"], 
      SubscriptBox["L", "\[Mu]"]}], "]"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"4350367a-5ffd-4aaf-abac-6eb884678028"],
 " for all ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", "\[NotEqual]", "\[Nu]"}], TraditionalForm]],
  ExpressionUUID->"2bc7966a-8d73-4406-91fb-7abf5b24fb84"],
 ". Putting these approximations back into the equation for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "(", 
    RowBox[{"t", "'"}], ")"}], TraditionalForm]],ExpressionUUID->
  "c6900bb9-f0e3-4450-a8cd-1067afec0c9d"],
 " at the beginning of this section leads to"
}], "TechNoteText",
 CellID->284265725,ExpressionUUID->"b7f65962-e7fd-42aa-8617-287604a0d317"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", "(", 
     RowBox[{"t", "+", 
      RowBox[{"\[Delta]", "\[VeryThinSpace]", "t"}]}], ")"}], "\[TildeTilde]", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"I", "-", 
        RowBox[{
        "\[ImaginaryI]", "\[VeryThinSpace]", "\[Delta]", "\[VeryThinSpace]", 
         "t", "\[VeryThinSpace]", 
         SubscriptBox["L", "0"]}]}], ")"}], 
      RowBox[{"\[Rho]", "(", "t", ")"}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"I", "-", 
         RowBox[{
         "\[ImaginaryI]", "\[VeryThinSpace]", "\[Delta]", "\[VeryThinSpace]", 
          "t", "\[VeryThinSpace]", 
          SubscriptBox["L", "0"]}]}], ")"}], "\[Dagger]"]}], "+", 
     RowBox[{"\[Delta]", "\[VeryThinSpace]", "t", "\[VeryThinSpace]", 
      UnderoverscriptBox["\[CapitalSigma]", 
       RowBox[{"\[Mu]", "=", "1"}], 
       RowBox[{
        SuperscriptBox["d", "2"], "-", "1"}]], 
      SubscriptBox["L", "\[Mu]"], 
      RowBox[{"\[Rho]", "(", "t", ")"}], 
      SubsuperscriptBox["L", "\[Mu]", "\[Dagger]"]}]}], "\[TildeTilde]", 
    RowBox[{
     RowBox[{"\[Rho]", "(", "t", ")"}], "-", 
     RowBox[{"\[ImaginaryI]", "\[VeryThinSpace]", "\[Delta]", "\[VeryThinSpace]", 
      RowBox[{"t", "[", 
       RowBox[{
        RowBox[{
         SubscriptBox["L", "0"], 
         RowBox[{"\[Rho]", "(", "t", ")"}]}], "-", 
        RowBox[{
         RowBox[{"\[Rho]", "(", "t", ")"}], 
         SubsuperscriptBox["L", "0", "\[Dagger]"]}]}], "]"}]}], "+", 
     RowBox[{"\[Delta]", "\[VeryThinSpace]", "t", "\[VeryThinSpace]", 
      UnderoverscriptBox["\[CapitalSigma]", 
       RowBox[{"\[Mu]", "=", "1"}], 
       RowBox[{
        SuperscriptBox["d", "2"], "-", "1"}]], 
      SubscriptBox["L", "\[Mu]"], 
      RowBox[{"\[Rho]", "(", "t", ")"}], 
      SubsuperscriptBox["L", "\[Mu]", "\[Dagger]"]}]}]}], TraditionalForm]],
  ExpressionUUID->"f97514d3-56d4-47e5-910d-763074ec3625"],
 " ."
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->1650409147,ExpressionUUID->"fbd2dca8-a300-4026-925c-2677f3283982"],

Cell["The conservation of probability then implies that", "TechNoteText",
 CellID->1527748977,ExpressionUUID->"df483e3f-2d07-46bc-99b7-bff25229c6bf"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["L", "0"], "-", 
     SubsuperscriptBox["L", "0", "\[Dagger]"]}], "=", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], 
     UnderoverscriptBox["\[CapitalSigma]", 
      RowBox[{"\[Mu]", "=", "1"}], 
      RowBox[{
       SuperscriptBox["d", "2"], "-", "1"}]], 
     SubsuperscriptBox["L", "\[Mu]", "\[Dagger]"], 
     SubscriptBox["L", "\[Mu]"]}]}], TraditionalForm]],ExpressionUUID->
  "e030a323-6c6b-408e-b45b-60eb25cebaff"],
 " ."
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->1562572907,ExpressionUUID->"0235ac51-230f-418e-ad4c-33ba17b057d4"],

Cell[TextData[{
 "This suggests that it will be convenient to split ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "0"], TraditionalForm]],ExpressionUUID->
  "89750576-d55c-4f3f-8202-442482c1e5cf"],
 " into the Hermitian and anti-Hermitian parts as"
}], "TechNoteText",
 CellID->585328786,ExpressionUUID->"23ab8610-994a-486f-9820-6949cee4183c"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "0"], "=", 
    RowBox[{"H", "-", 
     RowBox[{"\[ImaginaryI]", "\[VeryThinSpace] ", "G"}]}]}], 
   TraditionalForm]],ExpressionUUID->"38c1f368-3fbe-4196-ad20-53d001b181cd"],
 " ,"
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->2145803042,ExpressionUUID->"64f5e3e8-b83e-4db8-b95f-463eb829c1a7"],

Cell[TextData[{
 "which is identical to the non-Hermitian Hamiltonian as we already mentioned \
above. Indeed, the anti-Hermitian part, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], "\[VeryThinSpace]", "G"}], 
   TraditionalForm]],ExpressionUUID->"4781bfa3-b68e-4ec2-86ff-003828334e89"],
 ", is then fixed by operators ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "b4fed8ec-ca3a-45e0-9e62-41b5649e8b43"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", "\[NotEqual]", "0"}], TraditionalForm]],ExpressionUUID->
  "1d757c60-54d6-4bf5-a0e1-19fc9d76b881"],
 " through the relation"
}], "TechNoteText",
 CellID->1818842823,ExpressionUUID->"29704c52-cc0b-471e-ad56-14d48ba76ae4"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", ":=", 
    RowBox[{
     FractionBox["1", "2"], 
     UnderoverscriptBox["\[CapitalSigma]", 
      RowBox[{"\[Mu]", "=", "1"}], 
      RowBox[{
       SuperscriptBox["d", "2"], "-", "1"}]], 
     SubsuperscriptBox["L", "\[Mu]", "\[Dagger]"], 
     SubscriptBox["L", "\[Mu]"]}]}], TraditionalForm]],ExpressionUUID->
  "194420f1-a80b-4545-9705-ea556c87667e"],
 " ,"
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->2009094763,ExpressionUUID->"7e41ed06-b207-4552-b1d8-0893d1acf3c4"],

Cell[TextData[{
 "where the Hermitian part ",
 Cell[BoxData[
  FormBox["H", TraditionalForm]],ExpressionUUID->
  "9dade26d-6d3a-475d-adfd-2b38d4a0d525"],
 " remains arbitrary and is determined only by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "0"], TraditionalForm]],ExpressionUUID->
  "1b1dfaf4-0efb-4f05-a875-6b01e1dda743"],
 ", which is linearly independent of any ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "097fb3bb-6079-48af-94e8-54dd0ab2c6ea"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", "\[NotEqual]", "0"}], TraditionalForm]],ExpressionUUID->
  "fc182ace-d792-415a-a050-359c879aa4ea"],
 ". In passing, it is important to note that ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "f6fca326-ddc5-4a84-b27d-7aa7beb8a3c4"],
 " is positive, and as previously remarked, the probability conservation \
breaks down in the dynamics governed by the non-Hermitian Hamiltonian ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "non"], TraditionalForm]],ExpressionUUID->
  "49db97f6-6bc7-435d-be2b-6b16cab7395e"],
 " (or, equivalently, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "0"], TraditionalForm]],ExpressionUUID->
  "4b525a36-ef58-44f9-a1ff-e71bb03906e5"],
 ")."
}], "TechNoteText",
 CellID->1970299960,ExpressionUUID->"ff245234-a730-4001-afdf-155661d4407c"],

Cell[TextData[{
 "\tFinally, putting ",
 ButtonBox["Equations (14)",
  BaseStyle->"Link",
  ButtonData->
   "paclet:QuantumMob/Q3/tutorial/QuantumMasterEquation#2145803042"],
 " and ",
 ButtonBox["(15)",
  BaseStyle->"Link",
  ButtonData->
   "paclet:QuantumMob/Q3/tutorial/QuantumMasterEquation#2009094763"],
 " into ",
 ButtonBox["Equation (12)",
  BaseStyle->"Link",
  ButtonData->
   "paclet:QuantumMob/Q3/tutorial/QuantumMasterEquation#1650409147"],
 " leads to the ",
 ButtonBox["desired equations (2)",
  BaseStyle->"Link",
  ButtonData->
   "paclet:QuantumMob/Q3/tutorial/QuantumMasterEquation#1074065920"],
 " or, equivalently, ",
 ButtonBox["(3)",
  BaseStyle->"Link",
  ButtonData->
   "paclet:QuantumMob/Q3/tutorial/QuantumMasterEquation#1160295685"],
 ". Note that in this particular derivation, Lindblad operators ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "42b19ed4-f1d7-43a1-ab8a-4b98967255be"],
 " turn out to be traceless and mutually orthogonal automatically. Here, \
these properties inherit from the orthogonality of Kraus elements ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "b92af402-513b-4f01-95de-58225585379d"],
 "."
}], "TechNoteText",
 CellID->2030521791,ExpressionUUID->"831370ab-27f4-4bcf-a419-9aeb7fb4b47e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Solution Methods", "TechNoteSection",
 CellID->633590980,ExpressionUUID->"21134c13-e558-4390-ab3a-5fed76df4f81"],

Cell[CellGroupData[{

Cell["Integrating the Differential Equation", "Subsection",
 CellID->1732673218,ExpressionUUID->"1d957902-b70f-4a58-a9e4-90b2c55ec5d9"],

Cell[BoxData[GridBox[{
   {
    TemplateBox[{
      Cell[
       TextData["LindbladSolve"]], "paclet:QuantumMob/Q3/ref/LindbladSolve", 
      "QuantumMob Package Symbol"},
     "PackageLink",
     BaseStyle->{"DefinitionBox", CellFrame -> 0}], Cell[
    "Solves the quantum master equation", "TechNoteTableText",ExpressionUUID->
     "bf69d592-3067-49c2-8a77-8652126d0b4b"]},
   {
    TemplateBox[{
      Cell[
       TextData["NLindbladSolve"]], "paclet:QuantumMob/Q3/ref/NLindbladSolve",
       "QuantumMob Package Symbol"},
     "PackageLink",
     BaseStyle->{"DefinitionBox", CellFrame -> 0}], Cell[
    "Numerically solves the quantum master equation", "TechNoteTableText",
     ExpressionUUID->"db16ba54-12dd-47c8-9829-ace6d38e1dc2"]}
  }]], "DefinitionBox",
 CellID->1070647715,ExpressionUUID->"1bbec250-14d3-40c3-acb3-ffee16998c59"],

Cell["\<\
The Lindblad equation is a linear equation without an explicit time \
dependence, and it can always be solved by means of common methods for linear \
differential equations. More explicitly, in the standard basis, the Lindblad \
equation can be written as\
\>", "TechNoteText",
 CellID->1539679034,ExpressionUUID->"48072db7-7118-46cb-8a3f-01727a1292f8"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[Rho]", "."], 
     RowBox[{"j", "\[VeryThinSpace]", "k"}]], "=", 
    RowBox[{
     UnderscriptBox["\[CapitalSigma]", 
      RowBox[{
       RowBox[{"j", "'"}], 
       RowBox[{"k", "'"}]}]], 
     SubscriptBox["M", 
      RowBox[{
       RowBox[{"j", "\[VeryThinSpace]", "k"}], ";", 
       RowBox[{
        RowBox[{"j", "'"}], 
        RowBox[{"k", "'"}]}]}]], 
     SubscriptBox["\[Rho]", 
      RowBox[{
       RowBox[{"j", "'"}], 
       RowBox[{"k", "'"}]}]]}]}], TraditionalForm]],ExpressionUUID->
  "d12b068b-81f7-49d7-9ecb-291632950fd5"],
 " "
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->207578088,ExpressionUUID->"6c891704-de9d-4a03-93bd-a22de330d902"],

Cell["wit", "TechNoteText",
 CellID->1251482288,ExpressionUUID->"e436a121-19e3-4ffa-ac72-4f0e875606c0"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["M", 
     RowBox[{
      RowBox[{"j", "\[VeryThinSpace]", "k"}], ";", 
      RowBox[{
       RowBox[{"j", "'"}], 
       RowBox[{"k", "'"}]}]}]], ":=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"\[ImaginaryI]", "(", 
       RowBox[{
        RowBox[{
         SubscriptBox["H", 
          RowBox[{"j", "\[VeryThinSpace]", 
           RowBox[{"j", "'"}]}]], 
         SubscriptBox["\[Delta]", 
          RowBox[{"k", "\[VeryThinSpace]", 
           RowBox[{"k", "'"}]}]]}], "-", 
        RowBox[{
         SubscriptBox["\[Delta]", 
          RowBox[{"j", "\[VeryThinSpace]", 
           RowBox[{"j", "'"}]}]], 
         SubscriptBox["H", 
          RowBox[{"k", "\[VeryThinSpace]", 
           RowBox[{"k", "'"}]}]]}]}], ")"}]}], "-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["G", 
         RowBox[{"j", "\[VeryThinSpace]", 
          RowBox[{"j", "'"}]}]], 
        SubscriptBox["\[Delta]", 
         RowBox[{"k", "\[VeryThinSpace]", 
          RowBox[{"k", "'"}]}]]}], "+", 
       RowBox[{
        SubscriptBox["\[Delta]", 
         RowBox[{"j", "\[VeryThinSpace]", 
          RowBox[{"j", "'"}]}]], 
        SubscriptBox["G", 
         RowBox[{"k", "\[VeryThinSpace]", 
          RowBox[{"k", "'"}]}]]}]}], ")"}], "+", 
     RowBox[{
      UnderscriptBox["\[CapitalSigma]", "\[Mu]"], 
      SubscriptBox["L", 
       RowBox[{"\[Mu]", ";", 
        RowBox[{"j", "\[VeryThinSpace]", 
         RowBox[{"j", "'"}]}]}]], 
      SubsuperscriptBox["L", 
       RowBox[{"\[Mu]", ";", 
        RowBox[{"k", "\[VeryThinSpace]", 
         RowBox[{"k", "'"}]}]}], "*"]}]}]}], TraditionalForm]],ExpressionUUID->
  "b041d7b7-2341-472b-9c78-7333de87298a"],
 " ."
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->1207975698,ExpressionUUID->"7bf6a69e-f3ce-4e7f-88bb-cfd355b159b9"],

Cell[TextData[{
 "Regarding ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", ":=", 
    RowBox[{"(", 
     RowBox[{"j", "\[VeryThinSpace]", "k"}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"15254765-0dbd-4e03-a3d1-486dfaf883ce"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Nu]", ":=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"j", "'"}], 
      RowBox[{"k", "'"}]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "e4b3f9c5-1f49-4b22-8a19-c9eecf21567c"],
 " as collective indices, the differential equation above reads as"
}], "TechNoteText",
 CellID->137157548,ExpressionUUID->"1684fe81-937f-4ffa-92d6-c993371f0441"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[Rho]", "."], "\[Mu]"], "=", 
    RowBox[{
     UnderscriptBox["\[CapitalSigma]", "\[Nu]"], 
     SubscriptBox["M", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], 
     SubscriptBox["\[Rho]", "\[Nu]"]}]}], TraditionalForm]],ExpressionUUID->
  "4e0cf3c3-2b3e-4a28-8154-edb7c22c8b3e"],
 "  ,"
}], "TechNoteText",
 CellFrameLabels->{{None, 
    Cell[
     TextData[{"(", 
       CounterBox["DisplayFormulaNumbered"], ")"}], 
     "DisplayFormulaEquationNumber"]}, {None, None}},
 CounterIncrements->"DisplayFormulaNumbered",
 CellID->956956005,ExpressionUUID->"0dea6fc0-ddf0-4485-acac-fc4de593fbee"],

Cell[TextData[{
 "which is a typical first-order differential equation for the column vector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Rho]", "\[Nu]"], TraditionalForm]],ExpressionUUID->
  "34b02c2a-3267-4795-9b4b-6bc609795eb4"],
 "."
}], "TechNoteText",
 CellID->1054543652,ExpressionUUID->"4a3af68d-5d20-48fd-88fa-4fea495ae6b0"],

Cell[TextData[{
 "\tTechnically, the differential equation (18) is not adequate yet to solve \
because of the conditions that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Rho]", "\[Dagger]"], "=", "\[Rho]"}], TraditionalForm]],
  ExpressionUUID->"9fbdb1fc-5715-4309-be2c-22d49a7d7cf3"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Tr", "[", "\[Rho]", "]"}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"290a4636-b9c3-4c19-ba49-21df40d9265e"],
 "; that is, the components ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Rho]", 
    RowBox[{"i", "\[VeryThinSpace]", "j"}]], TraditionalForm]],ExpressionUUID->
  "6076988f-7718-4873-99c3-901446d756f5"],
 " are not independent of each other. These conditions are reflected in the \
fact that the determinant of the matrix ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],ExpressionUUID->
  "d0d5143b-114d-40d9-8d6f-0262017b1bfa"],
 " is always zero."
}], "TechNoteText",
 CellID->56787535,ExpressionUUID->"3ae141d3-d824-4df2-b0cc-8733047c98c7"],

Cell["\<\
For example, consider a single-qubit system. Suppose that the Lindblad \
equation is characterized by the effective Hamiltonian\
\>", "TechNoteText",
 CellID->443996717,ExpressionUUID->"54047e49-72c2-41d1-a17a-252aae4edb0a"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"H", "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], "\[CapitalOmega]", "\[VeryThinSpace]", 
      SuperscriptBox["S", "Z"]}], "+", 
     RowBox[{
      FractionBox["1", "2"], "\[CapitalDelta]", "\[VeryThinSpace]", 
      SuperscriptBox["S", "X"]}]}]}], TraditionalForm]],ExpressionUUID->
  "622aa75b-5dc8-44da-999a-9daf8b61f569"]
}], "TechNoteText",
 CellID->955068142,ExpressionUUID->"f46333d9-e717-4e09-99e3-3fe050c6e8fe"],

Cell[TextData[{
 "and the quantum jump operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox[
     SubscriptBox["\[CapitalGamma]", "\[PlusMinus]"]], 
    SuperscriptBox["S", "\[PlusMinus]"]}], TraditionalForm]],ExpressionUUID->
  "7e69cba2-91b8-482f-8529-9d37dacfc440"],
 ". In the matrix form, the quantum master equation is given by"
}], "TechNoteText",
 CellID->722520673,ExpressionUUID->"0194100a-718b-478e-aeec-5169fefae861"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["d", 
      RowBox[{"d", "\[VeryThinSpace]", "t"}]], 
     RowBox[{"(", GridBox[{
        {
         SubscriptBox["\[Rho]", "11"]},
        {
         SubscriptBox["\[Rho]", "12"]},
        {
         SubscriptBox["\[Rho]", "21"]},
        {
         SubscriptBox["\[Rho]", "22"]}
       }], ")"}]}], "=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", GridBox[{
        {
         RowBox[{
          RowBox[{"-", "2"}], 
          SubscriptBox["\[CapitalGamma]", "-"]}], 
         RowBox[{"\[ImaginaryI]", "\[VeryThinSpace]", "\[CapitalDelta]"}], 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], "\[VeryThinSpace]", 
          "\[CapitalDelta]"}], 
         RowBox[{"2", 
          SubscriptBox["\[CapitalGamma]", "+"]}]},
        {
         RowBox[{"\[ImaginaryI]", "\[VeryThinSpace]", "\[CapitalDelta]"}], 
         RowBox[{
          RowBox[{"-", 
           SubscriptBox["\[CapitalGamma]", "-"]}], "-", 
          SubscriptBox["\[CapitalGamma]", "+"], "-", 
          RowBox[{
          "2", "\[ImaginaryI]", "\[VeryThinSpace]", "\[CapitalOmega]"}]}], 
         "0", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], "\[VeryThinSpace]", 
          "\[CapitalDelta]"}]},
        {
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], "\[VeryThinSpace]", 
          "\[CapitalDelta]"}], "0", 
         RowBox[{
          RowBox[{"-", 
           SubscriptBox["\[CapitalGamma]", "-"]}], "-", 
          SubscriptBox["\[CapitalGamma]", "+"], "+", 
          RowBox[{
          "2", "\[ImaginaryI]", "\[VeryThinSpace]", "\[CapitalOmega]"}]}], 
         RowBox[{"\[ImaginaryI]", "\[VeryThinSpace]", "\[CapitalDelta]"}]},
        {
         RowBox[{"2", 
          SubscriptBox["\[CapitalGamma]", "-"]}], 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], "\[VeryThinSpace]", 
          "\[CapitalDelta]"}], 
         RowBox[{"\[ImaginaryI]", "\[VeryThinSpace]", "\[CapitalDelta]"}], 
         RowBox[{
          RowBox[{"-", "2"}], 
          SubscriptBox["\[CapitalGamma]", "+"]}]}
       }], ")"}], 
     RowBox[{"(", GridBox[{
        {
         SubscriptBox["\[Rho]", "11"]},
        {
         SubscriptBox["\[Rho]", "12"]},
        {
         SubscriptBox["\[Rho]", "21"]},
        {
         SubscriptBox["\[Rho]", "22"]}
       }], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "cc662f57-d3a2-4256-b593-2d3f4bfc2942"]
}], "TechNoteText",
 CellID->866849901,ExpressionUUID->"081637d4-91f0-44b1-a8f8-8613dd545d1c"],

Cell[TextData[{
 "Imposing the conditions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Rho]", "\[Dagger]"], "=", "\[Rho]"}], TraditionalForm]],
  ExpressionUUID->"71e9b016-92b1-4812-a76a-74ad15be9c23"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Tr", "[", "\[Rho]", "]"}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"9d5d4d91-71f7-4888-ba08-c913d659f19c"],
 ", the above equation reads as"
}], "TechNoteText",
 CellID->348556883,ExpressionUUID->"010af662-6edf-44d5-903b-0d6b5d54f464"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["d", 
      RowBox[{"d", "\[VeryThinSpace]", "t"}]], 
     RowBox[{"(", GridBox[{
        {
         SubscriptBox["\[Rho]", "11"]},
        {
         RowBox[{"Re", "\[VeryThinSpace]", 
          SubscriptBox["\[Rho]", "21"]}]},
        {
         RowBox[{"Im", "\[VeryThinSpace]", 
          SubscriptBox["\[Rho]", "21"]}]}
       }], ")"}]}], "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", GridBox[{
         {
          RowBox[{
           RowBox[{"-", "2"}], "\[CapitalGamma]"}], "0", "0"},
         {"0", 
          RowBox[{
           RowBox[{"-", "\[CapitalGamma]"}], "/", "2"}], 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], "\[ThinSpace]", 
           RowBox[{"\[CapitalGamma]", "/", "2"}]}]},
         {
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], "\[VeryThinSpace]", 
           "\[CapitalDelta]"}], 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], "\[ThinSpace]", 
           "\[CapitalOmega]"}], 
          RowBox[{"-", "\[CapitalOmega]"}]}
        }], ")"}], 
      RowBox[{"(", GridBox[{
         {
          SubscriptBox["\[Rho]", "11"]},
         {
          RowBox[{"Re", "\[VeryThinSpace]", 
           SubscriptBox["\[Rho]", "21"]}]},
         {
          RowBox[{"Im", "\[VeryThinSpace]", 
           SubscriptBox["\[Rho]", "21"]}]}
        }], ")"}]}], "+", 
     RowBox[{"(", GridBox[{
        {
         SubscriptBox["\[CapitalGamma]", "+"]},
        {"0"},
        {
         RowBox[{"\[CapitalDelta]", "/", "2"}]}
       }], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "c7298991-1198-4d5c-bdd2-6f51a81915c8"],
 " ,"
}], "TechNoteText",
 CellID->694839095,ExpressionUUID->"600a8365-053d-43d8-9ed4-68c2c49fe9b8"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalGamma]", ":=", 
    RowBox[{
     SubscriptBox["\[CapitalGamma]", "+"], "+", 
     SubscriptBox["\[CapitalGamma]", "-"]}]}], TraditionalForm]],
  ExpressionUUID->"63e021d6-4bde-4b11-9be8-8452ac6699c2"],
 ". It is a typical inhomogeneous first-order differential equation and can \
be solved using the standard methods. If necessary, various numerical methods \
can also be applied.  This method is extensively discussed in Blum (2012) ."
}], "TechNoteText",
 CellID->966710621,ExpressionUUID->"3f0e0733-f1d8-4606-8ee4-cbc5b8999c7a"],

Cell[TextData[{
 "\tIn the above discussion, the constraints ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Rho]", "\[Dagger]"], "=", "\[Rho]"}], TraditionalForm]],
  ExpressionUUID->"4ce9305a-0d62-4261-bce8-21e61da1c2f9"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Tr", "[", "\[Rho]", "]"}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"0242728a-a2b4-494a-bc63-337504eaacee"],
 " have been handled in an ad hoc fashion. More systematic and efficient way \
is explained in the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Quantum Workbook"]], 
    "https://doi.org/10.1007/978-3-030-91214-7"},
   "WebLink",
   BaseStyle->{"TechNoteText"}]],ExpressionUUID->
  "5bc2b39e-fa78-469c-9380-55439ae54d47"],
 "."
}], "TechNoteText",
 CellID->1070338383,ExpressionUUID->"c889d3ae-96d4-4413-8490-569184b0832f"],

