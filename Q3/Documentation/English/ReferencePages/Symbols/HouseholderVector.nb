Cell["\<\
To make the first element real positive,  multiply an additional phase factor:\
\>", "ExampleText",
 CellID->446095805,ExpressionUUID->"ea5d79d4-055a-4afb-a7df-586cbd843bd4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"phase", "=", 
   RowBox[{"-", 
    RowBox[{"Sign", "[", 
     RowBox[{"Conjugate", "@", 
      RowBox[{"First", "@", "v"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"phase", "*", 
   RowBox[{"v", ".", 
    RowBox[{"ReflectionMatrix", "[", "w", "]"}]}]}], "//", "Chop"}]}], "Input",\

