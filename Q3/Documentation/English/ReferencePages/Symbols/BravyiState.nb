    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bca4d863-d33f-4c7d-9615-bb75af6f6911"],
 " (mixed state) expression. It may take long for large systems, and is \
intended for elementary tests."
}], "Notes",
 CellID->909824622,ExpressionUUID->"716c8467-c81d-4cd1-ab00-3999d296a1b9"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BravyiGreen"]], "paclet:QuantumMob/Q3/ref/BravyiGreen", 
     "QuantumMob Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["BravyiState"]], "paclet:QuantumMob/Q3/ref/BravyiState", 
      "QuantumMob Package Symbol"},
     "PackageLink",
     BaseStyle->"InlineFormula"], "[", 
    StyleBox["\[Ellipsis]", "TR"], "]"}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a02b5c16-a001-48ac-b14a-b492f77b5115"],
 " returns the Green's functions of fermion modes. Similarly, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BravyiEntanglementEntropy"]], 
    "paclet:QuantumMob/Q3/ref/BravyiEntanglementEntropy", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fd17e14e-1707-4b06-9c68-46b5c9d808d0"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BravyiLogarithmicNegativity"]], 
    "paclet:QuantumMob/Q3/ref/BravyiLogarithmicNegativity", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c833dddd-f42e-41c1-910e-ed4af67d3ade"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BravyiMutualInformation"]], 
    "paclet:QuantumMob/Q3/ref/BravyiMutualInformation", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f89bc193-0f1f-41d7-86c7-ad37f094d3ed"],
 ", etc. are supported as well."
}], "Notes",
 CellID->993218105,ExpressionUUID->"a4f5c8b1-0db0-4cc6-a5ba-de564859fcbf"],

Cell[TextData[{
 "A ",
 StyleBox["convex linear combination",
  FontSlant->"Italic"],
 " (",
 StyleBox["not ",
  FontSlant->"Italic"],
 "coherent superposition) \[LineSeparator]\t",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TR"], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["w", "TI"], 
      StyleBox["1", "TR"]], "*", 
     RowBox[{
      TemplateBox[{
        Cell[
         TextData["BravyiState"]], "paclet:QuantumMob/Q3/ref/BravyiState", 
        "QuantumMob Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"], "[", 
      SubscriptBox[
       StyleBox["spec", "TI"], 
       StyleBox["1", "TR"]], "]"}]}], "+", 
    RowBox[{
     SubscriptBox[
      StyleBox["w", "TI"], 
      StyleBox["2", "TR"]], "*", 
     RowBox[{
      TemplateBox[{
        Cell[
         TextData["BravyiState"]], "paclet:QuantumMob/Q3/ref/BravyiState", 
        "QuantumMob Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"], "[", 
      SubscriptBox[
       StyleBox["spec", "TI"], 
       StyleBox["2", "TR"]], "]"}]}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "19c9f412-bd00-40d6-93eb-15a9ef30f32b"],
 "\[LineSeparator]of two normalized Bravyi states ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TR"], 
    StyleBox["1", "TR"]], "=", 
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["BravyiState"]], "paclet:QuantumMob/Q3/ref/BravyiState", 
      "QuantumMob Package Symbol"},
     "PackageLink",
     BaseStyle->"InlineFormula"], "[", 
    SubscriptBox[
     StyleBox["spec", "TI"], 
     StyleBox["1", "TR"]], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5fe6b141-f057-4c82-8adc-93f93e44ad1c"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TR"], 
    StyleBox["2", "TR"]], "=", 
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["BravyiState"]], "paclet:QuantumMob/Q3/ref/BravyiState", 
      "QuantumMob Package Symbol"},
     "PackageLink",
     BaseStyle->"InlineFormula"], "[", 
    SubscriptBox[
     StyleBox["spec", "TI"], 
     StyleBox["2", "TR"]], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "820c039d-587a-4f1e-9533-94230b2cb8ff"],
 " is supported for ",
 StyleBox["non-negative",
  FontSlant->"Italic"],
 " numbers ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["w", "TI"], 
   StyleBox["1", "TR"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "26c5a506-3221-4e3a-bd3a-055cad864b04"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["w", "TI"], 
   StyleBox["2", "TR"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6cdc794b-74a2-47bd-bf65-588f6fd411e6"],
 ", and is understood as \[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["w", "1"], "+", 
       SubscriptBox["w", "2"]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox[
         SubscriptBox["w", "1"], 
         RowBox[{
          SubscriptBox["w", "1"], "+", 
          SubscriptBox["w", "2"]}]], 
        SubscriptBox["\[Rho]", "1"]}], "+", 
       RowBox[{
        FractionBox[
         SubscriptBox["w", "2"], 
         RowBox[{
          SubscriptBox["w", "1"], "+", 
          SubscriptBox["w", "2"]}]], 
        SubscriptBox["\[Rho]", "2"]}]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"105488e3-dfd8-40ab-aa76-b89c41efbce9"],
 ". \[LineSeparator]Here, it is important to note that the resulting state ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TR"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e21b1614-2688-4ee2-89ec-23d90b7a3a14"],
 "  is a ",
 StyleBox["mixed state",
  FontSlant->"Italic"],
 " even when both ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BravyiState"]], "paclet:QuantumMob/Q3/ref/BravyiState", 
     "QuantumMob Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   SubscriptBox[
    StyleBox["spec", "TI"], 
    StyleBox["1", "TR"]], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "632f77d5-d52b-4d16-8eae-093cc6bd1a82"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BravyiState"]], "paclet:QuantumMob/Q3/ref/BravyiState", 
     "QuantumMob Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   SubscriptBox[
    StyleBox["spec", "TI"], 
    StyleBox["2", "TR"]], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9f084517-580c-40b7-9063-c8d36541113c"],
 " represent pure states, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Rho]", "1"], "=", 
    RowBox[{
     TemplateBox[{
       SubscriptBox["\[Psi]", "1"]},
      "Ket"], 
     TemplateBox[{
       SubscriptBox["\[Psi]", "1"]},
      "Bra"]}]}], TraditionalForm]],ExpressionUUID->
  "e9289528-bc0b-4a6f-960b-7c03dbcf0a44"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Rho]", "2"], "=", 
    RowBox[{
     TemplateBox[{
       SubscriptBox["\[Psi]", "2"]},
      "Ket"], 
     TemplateBox[{
       SubscriptBox["\[Psi]", "2"]},
      "Bra"]}]}], TraditionalForm]],ExpressionUUID->
  "b07caf87-33d3-474b-a6cc-a69515886875"],
 "; it should ",
 StyleBox["not",
  FontSlant->"Italic"],
 " be confused with the ",
 StyleBox["coherent superposition",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     TemplateBox[{
       SubscriptBox["\[Psi]", "1"]},
      "Ket"], 
     SubscriptBox["w", "1"]}], "+", 
    RowBox[{
     TemplateBox[{
       SubscriptBox["\[Psi]", "2"]},
      "Ket"], 
     SubscriptBox["w", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "154b7144-6f0e-4f24-912c-cbbb6834d4ef"],
 ". Note also that the norm square of \[Rho] is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["w", "1"], "+", 
    SubscriptBox["w", "2"]}], TraditionalForm]],ExpressionUUID->
  "bcc0dc3d-9fcc-47df-a4a1-bf38df87e55e"],
 " assuming that ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TR"], 
   StyleBox["1", "TR"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "01250d3f-966f-4526-a6ad-2cc361f95cef"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TR"], 
   StyleBox["2", "TR"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "38bc97cb-db25-483d-b04c-092509399259"],
 " are properly normalized (Q3 does not check the normalization)."
}], "Notes",
 CellID->1320442067,ExpressionUUID->"5da16dd6-bc44-4a7f-9c51-91d9815a0903"]
}, Closed]],

