Cell["Supermap is a linear mapping of linear operators.", "Notes",
 CellID->1067943069,ExpressionUUID->"4e8cb756-7be5-41d5-83cb-0c039d53a3b3"],

Cell[TextData[{
 "Specifically, let ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalV]", TraditionalForm]],ExpressionUUID->
  "c46bd9d2-4ddb-4a83-b1b6-c6ef19567a62"],
 " and ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalW]", TraditionalForm]],ExpressionUUID->
  "6fad91e6-0989-4d25-88d0-a47ad6ce194e"],
 " be vector spaces, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[ScriptCapitalL]", "(", "\[ScriptCapitalV]", ")"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      OverscriptBox["A", "^"], ":", 
      RowBox[{"\[ScriptCapitalV]", "\[RightArrow]", "\[ScriptCapitalV]"}]}], 
     "}"}]}], TraditionalForm]],ExpressionUUID->
  "b4352511-9fa4-43b1-84e0-b6c84ac3dd80"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[ScriptCapitalL]", "(", "\[ScriptCapitalW]", ")"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      OverscriptBox["A", "^"], ":", 
      RowBox[{"\[ScriptCapitalW]", "\[RightArrow]", "\[ScriptCapitalW]"}]}], 
     "}"}]}], TraditionalForm]],ExpressionUUID->
  "2ef6e1af-854e-4264-a77d-459206612e82"],
 " vector spaces of linear operators on \[ScriptCapitalV] and ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalW]", TraditionalForm]],ExpressionUUID->
  "4d6ee719-4645-4d16-8c1b-48bff1ce0dbb"],
 ", respectively. A linear map ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalF]", ":", 
    RowBox[{
     RowBox[{"\[ScriptCapitalL]", 
      RowBox[{"(", "\[ScriptCapitalV]", ")"}]}], "\[RightArrow]", 
     RowBox[{"\[ScriptCapitalL]", 
      RowBox[{"(", "\[ScriptCapitalW]", ")"}], " "}]}]}], TraditionalForm]],
  ExpressionUUID->"4eb29ab2-3414-4f40-8390-28cf0c6c8f1b"],
 "is called a ",
 StyleBox["supermap",
  FontSlant->"Italic"],
 "."
}], "Notes",
 CellID->579543253,ExpressionUUID->"d5762dc8-c42d-4f97-ab7a-dd1a3b5ac74c"],

Cell[TextData[{
 "A supermap is typically specified by an operator-sum representation or ",
 ButtonBox["Choi matrix",
  BaseStyle->"Link",
  ButtonData->"paclet:QuantumMob/Q3/ref/ChoiMatrix"],
 "."
}], "Notes",
 CellID->799768405,ExpressionUUID->"91e54156-7e4e-4559-a47c-bfa770befe29"]
}, Closed]],

