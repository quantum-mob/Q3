Cell[TextData[{
 "The (normal) Green\[CloseCurlyQuote]s function of fermion modes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "k"], TraditionalForm]],ExpressionUUID->
  "dbced1c8-79b1-44c9-8011-07f52a96145b"],
 " is defined by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["G", 
     RowBox[{"i", "\[VeryThinSpace]", "j"}]], ":=", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox["a", "i"], 
      SubsuperscriptBox["a", "j", "\[Dagger]"]}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]],ExpressionUUID->"499dc598-9a1e-42c6-8cae-5510b3e096d7"],
 ". The matrix ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "3fdc280a-5aaa-4908-b504-31061a78671e"],
 " is Hermitian, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["G", "\[Dagger]"], "=", "G"}], TraditionalForm]],
  ExpressionUUID->"cdb2461d-bf9e-43c5-95cb-b33049b81d0a"],
 ". The ",
 StyleBox["correlation matrix",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["C", 
     RowBox[{"i", "\[VeryThinSpace]", "j"}]], ":=", 
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       SubsuperscriptBox["a", "i", "\[Dagger]"], 
       SubscriptBox["a", "j"]}], "\[RightAngleBracket]"}], "\[Congruent]", 
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{"I", "-", 
        SuperscriptBox["G", "T"]}], ")"}], 
      RowBox[{"i", "\[VeryThinSpace]", "j"}]]}]}], TraditionalForm]],
  ExpressionUUID->"bbf5adcc-84cc-42bd-9251-83cabb2466cf"],
 " has equivalent information and is also frequently used. Obviously, the \
matrix ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],ExpressionUUID->
  "a9ca96d5-19e2-4c9c-8fb3-58790f49fc4c"],
 " is Hermitian as well, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["C", "\[Dagger]"], "=", "C"}], TraditionalForm]],
  ExpressionUUID->"6df2550a-cc33-417d-970c-eaf863d36a0b"],
 "."
}], "Notes",
 CellID->348061621,ExpressionUUID->"851127fe-fced-477a-8c58-62ad7472783a"]
}, Closed]],

