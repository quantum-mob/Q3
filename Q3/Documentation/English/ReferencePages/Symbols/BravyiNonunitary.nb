Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BravyiNonunitary"]], 
     "paclet:QuantumMob/Q3/ref/BravyiNonunitary", "QuantumMob Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["h", "TI"], ",", 
     StyleBox["g", "TI"], ",", 
     SubscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["0", "TR"]]}], "}"}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "76e90790-dff0-49a1-9d0a-44990ce3b661"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "n", "\[Times]", "2", "n"}], TraditionalForm]],ExpressionUUID->
  "7107389b-84c2-49f1-9ecc-dec13517fba4"],
 " ",
 StyleBox["real",
  FontSlant->"Italic"],
 " anti-symmetric matrices ",
 Cell[BoxData[
  FormBox["h", TraditionalForm]],ExpressionUUID->
  "9dd23970-c05b-4bde-8f1f-df7dc702b3ad"],
 " and ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "7c934664-8c6e-4cce-b077-ccdac40d92bb"],
 " and a real positive number ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["g", "TI"], 
   StyleBox["0", "TR"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4dbaf27a-1fec-44c3-a190-976e91092ec5"],
 ", represents an arbitrary many-fermion operator of the form\[LineSeparator]\
\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["W", "^"], ":=", 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", 
       SubscriptBox["g", "0"]}], "+", 
      RowBox[{
       FractionBox["1", "4"], 
       UnderoverscriptBox["\[CapitalSigma]", 
        RowBox[{"i", "\[VeryThinSpace]", "j"}], 
        RowBox[{"2", "n"}]], 
       SubscriptBox[
        RowBox[{
         SubscriptBox[
          OverscriptBox["c", "^"], "i"], " ", "[", 
         RowBox[{"h", "-", 
          RowBox[{"\[ImaginaryI]", "\[VeryThinSpace]", "g"}]}], "]"}], 
        RowBox[{"i", "\[VeryThinSpace]", "j"}]], 
       SubscriptBox[
        OverscriptBox["c", "^"], "j"]}]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"4868a0c6-b9f6-462b-914f-e231e05f9904"],
 " ,\nwhere ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["c", "^"], "k"], TraditionalForm]],ExpressionUUID->
  "ef2a6e53-e1d2-4f5b-82d7-e61aae1e2737"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["c", "^"], "k"], TraditionalForm]],ExpressionUUID->
  "964bbcf6-3c6b-4b98-976b-8013f12a4514"],
 " are the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "n"}], TraditionalForm]],ExpressionUUID->
  "23ddd2ee-6bdb-49aa-89aa-f87377be17e5"],
 " ",
 StyleBox[ButtonBox["Majorana fermion",
  BaseStyle->"Link",
  ButtonData->"paclet:QuantumMob/Q3/tutorial/MajoranaFermions"],
  FontSlant->"Italic"],
 " operators corresponding to ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "cfd0152f-a4f6-4412-ae4d-304265a85d20"],
 " Dirac fermion modes. Physically, it describes a non-unitary dynamics \
governed by the non-Hermitian Hamiltonian ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["H", "^"], "non"], "=", 
    RowBox[{
     OverscriptBox["H", "^"], "-", 
     RowBox[{"\[ImaginaryI]", "\[VeryThinSpace]", 
      OverscriptBox["G", "^"]}]}]}], TraditionalForm]],ExpressionUUID->
  "b2e8619d-e8d5-420b-ad74-281f01a86bb0"],
 ", where\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["H", "^"], ":=", 
    RowBox[{
     FractionBox["\[ImaginaryI]", "4"], 
     UnderoverscriptBox["\[CapitalSigma]", 
      RowBox[{"i", "\[VeryThinSpace]", "j"}], 
      RowBox[{"2", "n"}]], 
     SubscriptBox[
      OverscriptBox["c", "^"], "i"], " ", 
     SubscriptBox["h", 
      RowBox[{"i", "\[VeryThinSpace]", "j"}]], 
     SubscriptBox[
      OverscriptBox["c", "^"], "j"]}]}], TraditionalForm]],ExpressionUUID->
  "b098f95a-5ba3-4fa4-ab92-4f272ac7dd86"],
 "\[LineSeparator]is the effective Hamiltonian and\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["G", "^"], ":=", 
    RowBox[{
     SubscriptBox["g", "0"], "+", 
     RowBox[{
      FractionBox["\[ImaginaryI]", "4"], 
      UnderoverscriptBox["\[CapitalSigma]", 
       RowBox[{"i", "\[VeryThinSpace]", "j"}], 
       RowBox[{"2", "n"}]], 
      SubscriptBox[
       OverscriptBox["c", "^"], "i"], " ", 
      SubscriptBox["g", 
       RowBox[{"i", "\[VeryThinSpace]", "j"}]], 
      SubscriptBox[
       OverscriptBox["c", "^"], "j"]}]}]}], TraditionalForm]],ExpressionUUID->
  "591201c7-1924-458d-b6c7-968933b70087"],
 "\[LineSeparator]is the effective damping operator."
}], "Notes",
 CellID->1582982925,ExpressionUUID->"ab8ebeb0-83c3-44f0-a255-af79b3625582"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  StyleBox["ham", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d8f97b88-76a4-4af2-93b4-a411b8ab45a1"],
 " and ",
 Cell[BoxData[
  StyleBox["dmp", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9c237bcc-536c-477d-b1d4-75c7f5aa2215"],
 " are given in the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NambuHermitian"]], "paclet:QuantumMob/Q3/ref/NambuHermitian", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5fc7ad5a-aa4b-4769-89cb-855d03dd1682"],
 " object, then they are automatically converted to the coefficient matrices \
for ",
 StyleBox[ButtonBox["Majorana fermion",
  BaseStyle->"Link",
  ButtonData->"paclet:QuantumMob/Q3/tutorial/MajoranaFermions"],
  FontSlant->"Italic"],
 " modes."
}], "Notes",
 CellID->1920253778,ExpressionUUID->"b99cd105-0857-404c-8ebb-2272e469bdae"],

Cell[TextData[{
 "A quadratic many-body operator (such as Hamiltonian) is typically expressed \
as a bilinear combination of Dirac or Majorana fermion operators as follows:\
\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["H", "^"], "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", GridBox[{
         {
          SuperscriptBox["a", "\[Dagger]"], "a"}
        }], ")"}], "H", " ", 
      RowBox[{"(", GridBox[{
         {"a"},
         {
          SuperscriptBox["a", "\[Dagger]"]}
        }], ")"}]}], "=", 
     RowBox[{
      FractionBox["\[Iota]", "4"], 
      RowBox[{"(", GridBox[{
         {
          SubscriptBox["c", "1"], 
          SubscriptBox["c", "2"], "\[Ellipsis]"}
        }], ")"}], "A", " ", 
      RowBox[{"(", GridBox[{
         {
          SubscriptBox["c", "1"]},
         {
          SubscriptBox["c", "2"]},
         {"\[VerticalEllipsis]"}
        }], ")"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "bfe492c6-baa9-4088-b261-7ceef706be56"],
 " .\[LineSeparator]Here, notice the numerical pre-factors ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "2"}], TraditionalForm]],ExpressionUUID->
  "fd282642-ac04-440e-92ca-3f2465f723c6"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ImaginaryI]", "/", "4"}], TraditionalForm]],ExpressionUUID->
  "a0631303-8686-4ea8-9520-4964663448b0"],
 ", respectively. Due to these pre-factors, the two coefficients matrices are \
related each other by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "2"}], "\[ImaginaryI]"}], ")"}], 
    RowBox[{
     TemplateBox[{
       Cell[
        TextData["ToMajorana"]], "paclet:QuantumMob/Q3/ref/ToMajorana", 
       "QuantumMob Package Symbol"},
      "PackageLink",
      BaseStyle->"InlineFormula"], "[", 
     StyleBox["H", "TI"], "]"}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a94256f8-df7c-449d-926f-d85802b78a51"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[ImaginaryI]", "/", "2"}], ")"}], 
