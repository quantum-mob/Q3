        BaseStyle->"InlineFormula"], "[", 
       StyleBox["a", "TI"], "]"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "54a8aee3-fc06-4cff-b025-ace74001813b"],
     "\[LineSeparator]reduces a complex skew-symmetric matrix ",
     Cell[BoxData[
      StyleBox["a", "TI"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "94a64792-fe14-456d-9388-4db8787eae52"],
     " of even dimension to Murnaghan's normal form, and returns ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          SubscriptBox[
           StyleBox["s", "TI"], 
           StyleBox["1", "TR"]], ",", 
          SubscriptBox[
           StyleBox["s", "TI"], 
           StyleBox["2", "TR"]], ",", 
          StyleBox["\[Ellipsis]", "TR"]}], "}"}], ",", 
        StyleBox["u", "TI"]}], "}"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "efdc29a5-3d46-444f-a52d-eac5649a6d6d"],
     " with unitary ",
     Cell[BoxData[
      StyleBox["u", "TI"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "d91cd087-abf8-4d01-bf6b-bf66d20553c4"],
     " such that ",
     Cell[BoxData[
      RowBox[{
       RowBox[{
        TemplateBox[{
          Cell[
           TextData["Transpose"]], "paclet:ref/Transpose"},
         "RefLink",
         BaseStyle->{"InlineFormula"}], "[", 
        StyleBox["u", "TI"], "]"}], ".", 
       StyleBox["a", "TI"], ".", 
       StyleBox["u", "TI"]}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "577fbcb8-ab32-4106-a7b2-4e10dd8e20d5"],
     " is block-diagonal with 2x2 blocks ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          SubscriptBox[
           StyleBox["s", "TI"], 
           StyleBox["i", "TI"]]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
