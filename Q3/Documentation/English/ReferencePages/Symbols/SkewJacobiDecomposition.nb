            StyleBox["s", "TI"], 
            StyleBox["i", "TI"]]}], ",", " ", "0"}], "}"}]}], "}"}]], 
      "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "2bac6248-1722-44a6-93f4-992e684fb252"],
