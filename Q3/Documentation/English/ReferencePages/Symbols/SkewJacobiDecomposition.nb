Cell["\<\
Check that alpha values gives the singular values of the skew matrix:\
\>", "ExampleText",
 CellID->871098085,ExpressionUUID->"9810f568-927d-4a25-b2d9-47cb245e9baa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"errSV", "=", 
   RowBox[{
    RowBox[{"Sort", "[", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"{", 
        RowBox[{"val", ",", "val"}], "}"}], "]"}], ",", "Greater"}], "]"}], "-", 
    RowBox[{"SingularValueList", "[", 
     RowBox[{"ant", ",", 
      RowBox[{"Tolerance", "->", "0"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"errSV", "=", 
  RowBox[{"Norm", "[", 
   RowBox[{"errSV", ",", "Infinity"}], "]"}]}]}], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[6]:=",
 CellID->1149492996,ExpressionUUID->"b54bbf52-20c5-4320-ba6c-cc51607b3c99"],

