 CellLabel->"Out[6]=",
 CellID->1754492102,ExpressionUUID->"c9db66fa-041e-45cf-b084-d7086cd02967"]
}, Open  ]],

Cell["\<\
Solve the linear equation associated with the skew matrix and test it:\
\>", "ExampleText",
 CellID->765895360,ExpressionUUID->"cb659b6b-385d-46b5-a423-413140372587"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"b", "=", 
   RowBox[{"RandomVector", "[", "n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"x", "=", 
   RowBox[{"SkewJacobiSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"val", ",", "U"}], "}"}], ",", "b"}], "]"}]}], ";"}], "\n", 
 RowBox[{"res", "=", 
  RowBox[{"Norm", "[", 
   RowBox[{
    RowBox[{"ant", ".", "x"}], "-", "b"}], "]"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"~", "0"}], " ", "for", " ", "full"}], "-", 
    RowBox[{"rank", " ", "A"}]}], "*)"}]}]}], "Input",
