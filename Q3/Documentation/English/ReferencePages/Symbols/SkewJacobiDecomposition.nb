Cell["The following options can be given: ", "Notes",
 CellID->1447454287,ExpressionUUID->"1e5a70a6-8f0a-44b9-8a60-6afa7cddf0a9"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "5f345f99-b0d5-46f1-a717-ab699281271b"], "\"\<Tolerance\>\"", "1.0*^-13",
     Cell[TextData[{
     "The convergence is tested against the tolerance times the Frobenius \
norm ",
     Cell[BoxData[
      FormBox[
       SubscriptBox[
        RowBox[{
        "\[LeftDoubleBracketingBar]", "a", "\[RightDoubleBracketingBar]"}], 
