Cell["\<\
Consider a state vector to make a measurement on. Note that v below is NOT \
normalized.\
\>", "ExampleText",
 CellID->947677212,ExpressionUUID->"d31b2166-64cb-419a-8af4-ebbc4088e3b8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"v", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Ket", "[", "]"}], "+", 
