Cell["\<\
Note that Pauli operators include tensor products of the single-qubit Pauli \
operators.\
\>", "Notes",
 CellID->2092045182,ExpressionUUID->"436437d6-5dba-4c50-aa14-8b7c73cbddf0"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Measurement"]], "paclet:QuantumMob/Q3/ref/Measurement", 
      "QuantumMob Package Symbol"},
     "PackageLink",
     BaseStyle->"InlineFormula"], "[", 
    StyleBox["op", "TI"], "]"}], "[", 
   StyleBox["vec", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "735bdf3b-b0ae-4954-a912-adc579eea26f"],
 " gives outcomes 0 or 1, corresponding to eigenvalues \[PlusMinus]1, \
respectively, of ",
 Cell[BoxData[
  StyleBox["op", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f23eeaf7-7480-4488-96ff-8c69608a1ef2"],
 ". Recall that any Pauli operator has eigenvalue \[PlusMinus]1."
}], "Notes",
 CellID->330064636,ExpressionUUID->"d42d9e11-1110-480e-81db-02a3e1d32033"],

Cell[TextData[{
 "If the input vector is symbolic, then the post-measurement vectors are ",
 StyleBox["not",
  FontSlant->"Italic"],
 " normalized."
}], "Notes",
 CellID->833201793,ExpressionUUID->"4b99c073-d52b-4c6b-b40e-9cb950ff754e"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Matrix"]], "paclet:QuantumMob/Q3/ref/Matrix", 
     "QuantumMob Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"Measurement", "[", 
     StyleBox["op", "TI"], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["s", "TI"], 
       StyleBox["1", "TR"]], ",", 
      SubscriptBox[
       StyleBox["s", "TI"], 
       StyleBox["2", "TR"]], ",", 
      StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "73ef9ea4-3ef5-46e0-9ea3-7bb502ca9cf3"],
 " is equivalent to ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Measurement"]], "paclet:QuantumMob/Q3/ref/Measurement", 
     "QuantumMob Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Matrix"]], "paclet:QuantumMob/Q3/ref/Matrix", 
      "QuantumMob Package Symbol"},
     "PackageLink",
     BaseStyle->"InlineFormula"], "[", 
    RowBox[{
     StyleBox["op", "TI"], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        StyleBox["s", "TI"], 
        StyleBox["1", "TR"]], ",", 
       SubscriptBox[
        StyleBox["s", "TI"], 
        StyleBox["2", "TR"]], ",", 
       StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], "]"}], "]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6b7ad71a-2c09-407a-bffe-b779c0a26c1a"],
 "; hence, the result is not really a matrix."
}], "Notes",
 CellID->1336201431,ExpressionUUID->"d6bcc04f-3a20-4836-b852-ddd8bbc2f2cb"]
}, Closed]],

