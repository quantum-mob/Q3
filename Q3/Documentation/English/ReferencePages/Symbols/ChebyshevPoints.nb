Cell[TextData[{
 "Chebyshev points are also known as ",
 StyleBox["Chebyshev nodes",
  FontSlant->"Italic"],
 "."
}], "Notes",
 CellID->535143365,ExpressionUUID->"3cb06fcd-4921-4104-a477-944027c176cf"],

Cell[TextData[{
 "The Chebyshev points of the first kind are given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "k"], ":=", 
    RowBox[{"cos", "(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"k", "-", 
        RowBox[{"1", "/", "2"}]}], ")"}], 
      RowBox[{"\[Pi]", "/", "n"}]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"5688bcba-c29f-45ed-af9d-dfb3cb331a25"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"k", "=", "1"}], ",", "\[Ellipsis]", ",", 
    RowBox[{"n", "."}]}], TraditionalForm]],ExpressionUUID->
  "3349baa9-c26f-47df-a318-b1ff0e71c19a"]
}], "Notes",
 CellID->1867607051,ExpressionUUID->"f95e1509-242d-4bf5-986c-a7f97b1cabd5"],

Cell[TextData[{
 "The Chebyshev points of the second kind are given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "k"], ":=", 
    RowBox[{"cos", "(", "\[VeryThinSpace]", 
     RowBox[{"k", "\[VeryThinSpace]", 
      RowBox[{"\[Pi]", "/", 
       RowBox[{"(", 
        RowBox[{"n", "-", "1"}], ")"}]}]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"e47b1e0b-783c-42ad-a33d-f631bba18ca2"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"k", "=", "0"}], ",", "1", ",", "\[Ellipsis]", ",", 
    RowBox[{"n", "-", "1."}]}], TraditionalForm]],ExpressionUUID->
  "4184b566-0c3d-4e54-ae12-51b96b98baf6"]
}], "Notes",
 CellID->1060991321,ExpressionUUID->"612e124a-72a0-4bda-9f49-b85d9ae7d3d8"],

Cell[TextData[{
 "Chebyshev points are the projection of equally spaced points along the \
circumference of the unit circle onto the interval ",
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{
    RowBox[{"-", "1"}], ",", "1"}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "77842fab-b8d7-4a5b-ad93-9b33e7a53453"],
 "."
}], "Notes",
 CellID->1627716796,ExpressionUUID->"b86188af-3bed-4ec1-a59a-1ead49e8b6e9"]
}, Closed]],

