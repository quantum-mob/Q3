Cell[BoxData[GridBox[{
   {"", Cell[TextData[{
     Cell[BoxData[
      RowBox[{
       TemplateBox[{
         Cell[
          TextData["WickMutualInformation"]], 
         "paclet:QuantumMobQ3/ref/WickMutualInformation", 
         "QuantumMobQ3 Package Symbol"},
        "PackageLink",
        BaseStyle->"InlineFormula"], "[", 
       RowBox[{
        StyleBox["grn", "TI"], ",", 
        RowBox[{"{", 
         RowBox[{
          SubscriptBox[
           StyleBox["k", "TI"], 
           StyleBox["1", "TR"]], ",", 
          SubscriptBox[
           StyleBox["k", "TI"], 
           StyleBox["2", "TR"]], ",", "\[Ellipsis]"}], "}"}]}], "]"}]], 
      "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "263f905b-1941-46df-8481-33b98e4486c0"],
     "\[LineSeparator]returns the mutual information between the subsystem \
consisting of fermion modes {k1, k2, \[Ellipsis]}\[Subset]{1, 2, \[Ellipsis], \
n} and the rest in the fermionic Gaussian state (without pairing correlation) \
characterized by n\[Times]n matrix grn of single-particle Green's functions. \
"
    }],ExpressionUUID->"6a351d93-884e-4ea0-80c2-d1b6dc26912d"]},
   {"", Cell[TextData[{
     "WickMutualInformation[ws,",
     Cell[BoxData[
      StyleBox[
       RowBox[{"{", "k1"}], "TI"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "39e90969-f494-49be-a321-51a3b74b7351"],
     ",k2,\[Ellipsis]}]\[LineSeparator]is equivalent to "
    }],ExpressionUUID->"c498dfaa-6f25-43dc-9341-b995afb97495"]},
   {"", Cell[TextData[{
     "WickMutualInformation[WickGreen[state]\[LineSeparator],{k1,k2,\
\[Ellipsis]}] for Wick ",
     Cell[BoxData[
      StyleBox["state", "TI"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "21fa58f5-0c77-47f1-8aaf-71e9aeb4c5d7"],
     " ws. "
    }],ExpressionUUID->"8f08f6d5-21f3-4488-898c-9736cb712ec0"]},
