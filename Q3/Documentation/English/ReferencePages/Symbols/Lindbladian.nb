Cell["\<\
Mathematically, Lindblad supermap is a generator of a dynamical semi-group.\
\>", "Notes",
 CellID->486125778,ExpressionUUID->"b58aa4ab-cb89-4c55-98b5-e40c47b17542"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   RowBox[{"Lindbladian", "[", 
