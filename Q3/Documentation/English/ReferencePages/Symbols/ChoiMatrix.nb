 " returns a forth-rank tensor, but is typically called a matrix regarding \
the first two and last two indexes as collective indices."
}], "Notes",
 CellID->1067943069,ExpressionUUID->"1662da17-c385-49b5-ac50-9cd05b0cecd4"],

Cell[TextData[{
 "Let \[ScriptCapitalV] and \[ScriptCapitalW] be vector spaces, and suppose \
that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       TemplateBox[{
         SubscriptBox["v", "i"]},
        "Ket"], "|", "i"}], "=", "1"}], ",", "2", ",", "\[Ellipsis]", ",", 
     "m"}], "}"}], TraditionalForm]],ExpressionUUID->
  "b642fb79-3360-45fb-9eff-1717a6cbe529"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       TemplateBox[{
         SubscriptBox["w", "j"]},
        "Ket"], "|", "j"}], "=", "1"}], ",", "2", ",", "\[Ellipsis]", ",", 
     "n"}], "}"}], TraditionalForm]],ExpressionUUID->
  "6fcd8d82-66ba-4235-9a7b-4251e856a038"],
 " be their respective orthonormal bases. Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalF]", ":", 
    RowBox[{
     RowBox[{"\[ScriptCapitalL]", "(", "\[ScriptCapitalV]", ")"}], "\[RightArrow]", 
     RowBox[{"\[ScriptCapitalL]", "(", "\[ScriptCapitalW]", ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"8633d471-d330-49f2-b8e4-8f6566dc0463"],
 " be a supermap from linear operators on ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalV]", TraditionalForm]],ExpressionUUID->
  "b0ae1810-4658-4a9e-86e1-4980ee9d1d78"],
 " to linear operators on ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalW]", TraditionalForm]],ExpressionUUID->
  "e02c3c31-a612-4df6-b378-ef0ce4714295"],
 ". The Choi matrix ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],ExpressionUUID->
  "17a55865-0cea-414b-8850-30d796036245"],
 " of ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalF]", TraditionalForm]],ExpressionUUID->
  "d8fbf955-8439-4861-be37-c251550014dc"],
 " is defined by\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[ScriptCapitalF]", "(", 
     RowBox[{
      TemplateBox[{
        SubscriptBox["v", "k"]},
       "Ket"], 
      TemplateBox[{
        SubscriptBox["v", "l"]},
       "Bra"]}], ")"}], ":=", 
    RowBox[{
     UnderscriptBox["\[CapitalSigma]", 
      RowBox[{"i", "\[ThinSpace]", "j"}]], 
     TemplateBox[{
       SubscriptBox["w", "i"]},
      "Ket"], 
     SubscriptBox["C", 
      RowBox[{
       RowBox[{"i", "\[VeryThinSpace]", "k"}], ";", 
       RowBox[{"j", "\[VeryThinSpace]", "l"}]}]], 
     TemplateBox[{
       SubscriptBox["w", "j"]},
      "Bra"]}]}], TraditionalForm]],ExpressionUUID->
  "44508b0a-8e00-4e2f-8fc8-93aec6be5fdc"],
 ".\[LineSeparator]More precisely, it is a forth-rank tensor, and yet is \
frequently called a matrix by regarding the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"i", ",", "k"}], ")"}], TraditionalForm]],ExpressionUUID->
  "66fff286-5597-4622-9f67-5fe508317857"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"j", ",", "l"}], ")"}], TraditionalForm]],ExpressionUUID->
  "be573a01-9ed0-483a-b7fb-c555c0120a8b"],
 " as collective indices."
}], "Notes",
 CellID->2071262949,ExpressionUUID->"37adf2fa-ca2d-4eec-bc9a-11fe8214bd4c"],

Cell["\<\
If a supermap is completely positive, then its Choi matrix is positive.\
\>", "Notes",
 CellID->1804368584,ExpressionUUID->"ff19e6b4-8997-48b7-8f0a-c775e5c43ad6"],

Cell[TextData[{
 "The Choi matrix of supermap ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalF]", ":", 
    RowBox[{
     RowBox[{"\[ScriptCapitalL]", "(", "\[ScriptCapitalV]", ")"}], "\[RightArrow]", 
     RowBox[{"\[ScriptCapitalL]", "(", "\[ScriptCapitalW]", ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"5f7d242d-9908-4847-81e6-036587622da3"],
 " defined by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[ScriptCapitalF]", "(", "\[Rho]", ")"}], ":=", 
    RowBox[{"A", "\[VeryThinSpace]", "\[Rho]", "\[VeryThinSpace]", 
     SuperscriptBox["B", "\[Dagger]"]}]}], TraditionalForm]],ExpressionUUID->
  "6639e808-42f1-40be-9c05-64ce296c0f44"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", ",", 
    RowBox[{"B", "\[Element]", 
     RowBox[{"\[ScriptCapitalL]", "(", 
      RowBox[{"\[ScriptCapitalV]", ",", "\[ScriptCapitalW]"}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"1c17bd05-4622-4d3d-868a-b6ad8d80f137"],
 ", is given by \[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["C", 
     RowBox[{
      RowBox[{"i", "\[VeryThinSpace]", "k"}], ";", 
      RowBox[{"j", "\[VeryThinSpace]", "l"}]}]], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["A", 
       RowBox[{"i", "\[VeryThinSpace]", "\[Kappa]"}]], 
      SubsuperscriptBox["B", 
       RowBox[{"j", "\[VeryThinSpace]", "l"}], "*"]}], "\[Congruent]", 
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{"A", "\[CircleTimes]", 
        SuperscriptBox["B", "*"]}], ")"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"k", ",", "l"}], ")"}]}]]}]}], TraditionalForm]],
  ExpressionUUID->"3d18b939-ae99-41ae-a9cb-b3abc640d05e"],
 " . \[LineSeparator]The corresponding ",
 StyleBox["super-matrix",
  FontSlant->"Italic"],
 " is given by \[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["M", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"i", ",", "j"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"k", ",", "l"}], ")"}]}]], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["A", 
       RowBox[{"i", "\[VeryThinSpace]", "k"}]], 
      SubsuperscriptBox["B", 
       RowBox[{"j", "\[VeryThinSpace]", "l"}], "*"]}], "\[Congruent]", 
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{"A", "\[CircleTimes]", 
        SuperscriptBox["B", "*"]}], ")"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"k", ",", "l"}], ")"}]}]]}]}], TraditionalForm]],
  ExpressionUUID->"85dd9833-acee-4b9b-a973-e4e8cbdecbd4"],
 "; \[LineSeparator]that is, \[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["M", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"i", ",", "j"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"k", ",", "l"}], ")"}]}]], "=", 
    SubscriptBox["C", 
     RowBox[{
      RowBox[{"i", "\[VeryThinSpace]", "k"}], ";", 
      RowBox[{"j", "\[VeryThinSpace]", "l"}]}]]}], TraditionalForm]],
  ExpressionUUID->"8659166b-6449-4c0a-8408-46bd63cd4a97"],
 " ."
}], "Notes",
 CellID->544097144,ExpressionUUID->"1b2f69d7-6779-48a7-96f5-47624a607edd"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalF]", ":", 
    RowBox[{"\[Rho]", "\[RightTeeArrow]", "\[Sigma]"}]}], TraditionalForm]],
  ExpressionUUID->"fc725e25-05f3-4ad0-9205-1b62c1edb469"],
 " be a supermap, and ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],ExpressionUUID->
  "88248867-11cf-46ad-8157-d53720d602d1"],
 " its Choi matrix. Then, the components of \[Rho] and \[Sigma] are related \
by the transformation\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", 
     RowBox[{"i", "\[VeryThinSpace]", "j"}]], "=", 
    RowBox[{
     RowBox[{
      UnderscriptBox["\[CapitalSigma]", 
       RowBox[{"k", "\[VeryThinSpace]", "l"}]], 
      SubscriptBox["C", 
       RowBox[{
        RowBox[{"i", "\[VeryThinSpace]", "k"}], ";", 
        RowBox[{"j", "\[VeryThinSpace]", "l"}]}]], 
      SubscriptBox["\[Rho]", 
       RowBox[{"k", "\[VeryThinSpace]", "l"}]]}], "=", 
     RowBox[{
      UnderscriptBox["\[CapitalSigma]", 
       RowBox[{"k", "\[VeryThinSpace]", "l"}]], 
      SubscriptBox["M", 
       RowBox[{
        RowBox[{"i", "\[VeryThinSpace]", "j"}], ";", 
        RowBox[{"k", "\[VeryThinSpace]", "l"}]}]], 
      SubscriptBox["\[Rho]", 
       RowBox[{"k", "\[VeryThinSpace]", "l"}]]}]}]}], TraditionalForm]],
  ExpressionUUID->"c850f4e4-dbe0-41d0-bd2d-bd9034d5be6c"],
 " ."
}], "Notes",
 CellID->688867986,ExpressionUUID->"1f6c1f7e-0feb-415d-aaea-80377b48c48f"]
}, Closed]],

