Cell[TextData[{
 "Consider a single qubit and solve a master equation specified in the Pauli \
operators (for ",
 StyleBox["unlabelled",
  FontSlant->"Italic"],
 " systems):"
}], "ExampleText",
 CellID->1231127355,ExpressionUUID->"60ec70a9-c920-4eec-b5fa-f4afb283719d"],

