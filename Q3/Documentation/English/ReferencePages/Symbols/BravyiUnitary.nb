Cell[TextData[{
 "The above Hermitian matrix represents a quadratic many-body Hamiltonian for \
fermion modes. Notice the factor of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "2"}], TraditionalForm]],ExpressionUUID->
  "c30503df-84ee-42fd-8926-1846d41c673c"],
 " since ",
 Cell[BoxData[
  FormBox[
   RowBox[{"H", ":=", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     SuperscriptBox[
      RowBox[{
       UnderscriptBox["a", "_"], " "}], "\[Dagger]"], 
     UnderscriptBox["H", "_"], 
     UnderscriptBox["a", "_"], " "}]}], TraditionalForm]],ExpressionUUID->
  "3e97ce9d-17ee-489d-aeb9-0a11e6a8a72b"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{
      UnderscriptBox["a", "_"], " "}], "\[Dagger]"], ":=", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["a", "1", "\[Dagger]"], ",", 
      SubsuperscriptBox["a", "2", "\[Dagger]"], ",", "\[Ellipsis]", ",", 
      SubscriptBox["a", "1"], ",", 
      SubscriptBox["a", "2"], ",", "\[Ellipsis]"}], ")"}]}], 
   TraditionalForm]],ExpressionUUID->"92fc2a0c-3bc9-4f95-b765-d7c3788a0ad1"],
 ":"
}], "ExampleText",
 CellID->257892830,ExpressionUUID->"ad46fb7a-83c9-494e-b835-55af131b321d"],

