  StyleBox["u", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "014c50de-fc25-47ca-ada6-3fa444acc464"],
 " represents the canonical transformation of ",
 StyleBox[ButtonBox["Majorana fermion",
  BaseStyle->"Link",
  ButtonData->"paclet:QuantumMob/Q3/tutorial/MajoranaFermions"],
  FontSlant->"Italic"],
 " modes ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["c", "TI"], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "16656c6e-9199-4807-8c92-483c7a1925a8"],
 ":  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"u", " ", 
     SubscriptBox["c", "j"], 
     SuperscriptBox["u", "\[Dagger]"]}], ":=", 
    RowBox[{
     SubscriptBox["\[Sum]", "i"], 
     RowBox[{
      SubscriptBox["c", "i"], 
      SubscriptBox["r", 
       RowBox[{"i", "\[VeryThinSpace]", "j"}]]}]}]}], TraditionalForm]],
  ExpressionUUID->"6bc86c7f-ec7f-4995-bfe2-afa275ac7044"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"j", "=", "1"}], ",", "2", ",", "\[Ellipsis]", ",", 
    RowBox[{"2", "n"}]}], TraditionalForm]],ExpressionUUID->
  "eebd6d0c-96c5-4728-9145-2458b3ac7e63"],
 ",  where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], ":=", 
