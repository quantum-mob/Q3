Cell[TextData[{
 "Get the representative anti-symmetric matrix of the Hamiltonian. Notice the \
factor of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "4"}], "\[ImaginaryI]"}], TraditionalForm]],ExpressionUUID->
  "377f085b-13ce-404f-a128-c0d2ea35c759"],
 " since ",
 Cell[BoxData[
  FormBox[
   RowBox[{"H", ":=", 
    RowBox[{
     FractionBox["\[ImaginaryI]", "4"], 
     SubscriptBox["c", "i"], 
     SubscriptBox["A", 
      RowBox[{"i", "\[VeryThinSpace]", "j"}]], 
     SubscriptBox["c", "j"]}]}], TraditionalForm]],ExpressionUUID->
  "d2e029f7-1f78-4edb-8bfc-201b85e1a965"],
 ":"
}], "ExampleText",
 CellID->932658973,ExpressionUUID->"bc59a413-f5c5-488f-a4ee-d63e481ef344"],

