Cell[TextData[{
 "The two results ",
 StyleBox["vout", "Input",
  IgnoreSpellCheck->True],
 " and ",
 StyleBox["mint", "Input"],
 " look different, but that is due to a global phase factor. Note that the \
matrix representation of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BravyiState"]], "paclet:QuantumMob/Q3/ref/BravyiState", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2a482dd5-efd2-428f-ac0d-6df6bcc06f28"],
 " is always in the canonical form:"
}], "ExampleText",
 CellID->459971255,ExpressionUUID->"ea7df329-dc07-4690-92ec-048d1d1a56bd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"vout", "-", 
   RowBox[{"CanonicalizeVector", "[", "mint", "]"}]}], "//", 
  "ArrayZeroQ"}]], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[10]:=",
 CellID->1416867293,ExpressionUUID->"330a4723-1492-4516-a874-12b6fbf55af4"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[10]=",
 CellID->271276877,ExpressionUUID->"72867a53-8f7f-43ad-82d0-a3749cf9ae22"]
}, Open  ]],

