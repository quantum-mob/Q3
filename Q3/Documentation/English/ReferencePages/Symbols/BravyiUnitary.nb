Cell[BoxData[{
 RowBox[{
  RowBox[{"hamOp", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"I", "/", "4"}], ")"}], "*", 
    RowBox[{"MultiplyDot", "[", 
     RowBox[{"cc", ",", 
      RowBox[{"ham", ".", "cc"}]}], "]"}]}]}], ";", 
  RowBox[{"hamOp", "=", 
   RowBox[{"ToDirac", "[", 
    RowBox[{"hamOp", ",", 
     RowBox[{"cc", "->", "aa"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"new", "=", 
  RowBox[{"MatrixExp", "[", 
   RowBox[{
    RowBox[{"-", "I"}], "*", 
    RowBox[{"Matrix", "[", 
     RowBox[{"hamOp", ",", "aa"}], "]"}]}], "]"}]}]}], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[8]:=",
