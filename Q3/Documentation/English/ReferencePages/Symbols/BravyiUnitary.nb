Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"hamOp", "=", 
   RowBox[{
    RowBox[{"MultiplyDot", "[", 
     RowBox[{"cc", ",", 
      RowBox[{"ham", ".", "cc"}]}], "]"}], "*", 
    RowBox[{"I", "/", "4"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hamOp", "=", 
   RowBox[{"ToDirac", "[", 
    RowBox[{"hamOp", ",", 
     RowBox[{"cc", "->", "aa"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"uni", "=", 
  RowBox[{"MatrixExp", "[", 
   RowBox[{
    RowBox[{"-", "I"}], "*", 
    RowBox[{"Matrix", "[", 
     RowBox[{"hamOp", ",", "aa"}], "]"}]}], "]"}]}]}], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[13]:=",
 CellID->889667198,ExpressionUUID->"c6053001-7d5d-49e8-9679-c9640964017b"],

