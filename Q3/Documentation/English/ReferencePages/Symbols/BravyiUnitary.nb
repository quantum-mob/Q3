Cell[TextData[{
 "A Gaussian-type many-body unitary operator ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["U", "^"], TraditionalForm]],ExpressionUUID->
  "56fa963f-75ab-4fd9-9c09-a1a5e39ceeb9"],
 " may be represented by the unitary matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "=", 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "H"}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"63a673b5-b8fd-4ca6-a67b-1cca9e0e526e"],
 " in the Dirac spinor space and the real orthogonal matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", " ", "=", " ", 
    RowBox[{"exp", "(", "A", ")"}]}], TraditionalForm]],ExpressionUUID->
  "4cec3c20-45d9-405a-b245-c5a0b01340b6"],
 " in the Majorana spinor space. Here, we illustrate the relation between the \
two matrices ",
 Cell[BoxData[
  FormBox["U", TraditionalForm]],ExpressionUUID->
  "c118cde1-8780-4501-83b1-e235672bdea0"],
 " and ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]],ExpressionUUID->
  "bc03f82d-6a53-46e8-b515-88434cd3fc4b"],
 "."
}], "ExampleText",
 CellID->1320245205,ExpressionUUID->"bc049dc0-b33a-4ab7-8246-13b56a0965cf"],

