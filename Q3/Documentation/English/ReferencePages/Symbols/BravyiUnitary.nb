Cell[TextData[{
 "Suppose that ",
 Cell[BoxData[
  RowBox[{
   StyleBox["u", "TI"], ":=", 
   RowBox[{"BravyiUnitary", "[", 
    StyleBox["a", "TI"], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f8e1e029-9dd7-46be-b73f-d0eb884a18da"],
 ". Then, ",
