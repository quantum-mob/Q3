Cell[TextData[{
 "For an open quantum system, the effective Hamiltonian ",
 StyleBox["H",
  FontSlant->"Italic"],
 " and the effective damping operator ",
 StyleBox["G",
  FontSlant->"Italic"],
 " form the non-Hermitian Hamiltonian, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["H",
     FontSlant->"Italic"], "non"], ":=", 
   RowBox[{
    StyleBox["H",
     FontSlant->"Italic"], "-", 
    StyleBox[
     RowBox[{"\[ImaginaryI]", 
      StyleBox["G",
       FontSlant->"Italic"]}]]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0dddd396-47ca-420c-b6cb-18bc8b563fb9"],
 ", which physically describes the irreversible population loss."
}], "Notes",
 CellID->1067943069,ExpressionUUID->"d21df380-f502-4380-a596-4d0794fc9982"]
}, Closed]],

