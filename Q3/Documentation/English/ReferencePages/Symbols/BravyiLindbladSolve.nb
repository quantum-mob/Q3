Cell[TextData[{
 "When ",
 Cell[BoxData[
  StyleBox["jmp", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a3b28c9a-6707-4690-97cf-a22ffd885b6e"],
 " are given in the form of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BravyiMeasurement"]], 
    "paclet:QuantumMob/Q3/ref/BravyiMeasurement", "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "380d5475-1b68-4d4f-9fe0-d9883312d2c1"],
 ", each quantum jump operator is regarded as a ",
 StyleBox["projection operator",
  FontSlant->"Italic"],
 " associated with a dressed fermion mode."
}], "Notes",
 CellID->1177845785,ExpressionUUID->"97cf511b-fc24-49fb-93f1-2680e1b5b643"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BravyiLindbladSolve"]], 
    "paclet:QuantumMob/Q3/ref/BravyiLindbladSolve", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "77ff4593-8bc5-486a-bfc7-ec22ace6e0c6"],
 " solves the quantum master equation\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["d\[Rho]", "dt"], "=", 
    RowBox[{"\[ScriptCapitalL]", "(", "\[Rho]", ")"}]}], TraditionalForm]],
  ExpressionUUID->"47d68c08-bbab-439c-b223-bd1448b1ac63"],
 "\nwith Lindblad supermap\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[ScriptCapitalL]", "(", "\[Rho]", ")"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"\[ImaginaryI]", "[", 
        RowBox[{"H", ",", "\[Rho]"}], "]"}]}], "-", 
      RowBox[{
       FractionBox["1", "2"], 
       SubscriptBox["\[CapitalSigma]", "\[Mu]"], 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubsuperscriptBox["L", "\[Mu]", "\[Dagger]"], 
          SubscriptBox["L", "\[Mu]"]}], ",", "\[Rho]"}], "}"}]}], "+", 
      RowBox[{
       SubscriptBox["\[CapitalSigma]", "\[Mu]"], 
       SubscriptBox["L", "\[Mu]"], "\[Rho]", "\[ThinSpace]", 
       SubsuperscriptBox["L", "\[Mu]", "\[Dagger]"]}]}], "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"i", "[", 
        RowBox[{"H", ",", "\[Rho]"}], "]"}]}], "+", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "\[Mu]"], "[", 
        RowBox[{
         RowBox[{
          SubscriptBox["L", "\[Mu]"], "\[Rho]"}], ",", 
         SubsuperscriptBox["L", "\[Mu]", "\[Dagger]"]}], "]"}]}], "+", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "\[Mu]"], "[", 
        RowBox[{
         SubscriptBox["L", "\[Mu]"], ",", 
         RowBox[{"\[Rho]", "\[ThinSpace]", 
          SubsuperscriptBox["L", "\[Mu]", "\[Dagger]"]}]}], "]"}]}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"fe489ef1-9c68-4e4f-b10a-206bc6b42621"],
 " ,\[LineSeparator]where each quantum jump operator ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "a55184db-c537-4b8d-8839-73e5d1a18899"],
 " is a linear superposition of Majorana fermion operators, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "i"], TraditionalForm]],ExpressionUUID->
  "e1d9e020-b75c-4653-b096-40c5f8159a93"],
 ", \[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "\[Mu]"], ":=", 
    RowBox[{
     SubsuperscriptBox["\[CapitalSigma]", 
      RowBox[{"i", "=", "1"}], 
      RowBox[{"2", "n"}]], 
     SubscriptBox["\[ScriptL]", 
      RowBox[{"\[Mu]", ",", "i"}]], 
     SubscriptBox["c", "i"]}]}], TraditionalForm]],ExpressionUUID->
  "6b1a9094-ff7f-496b-9936-695dd2f673ef"],
 " ,\[LineSeparator]or a projection operator\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "\[Mu]"], ":=", 
    RowBox[{
     SubsuperscriptBox["b", "\[Mu]", "\[Dagger]"], 
     SubscriptBox["b", "\[Mu]"]}]}], TraditionalForm]],ExpressionUUID->
  "060d9b83-a3af-46e5-8313-115af21e786a"],
 "   \[LineSeparator]associated with dressed fermion mode\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["b", "\[Mu]"], ":=", 
    RowBox[{
     SubsuperscriptBox["\[CapitalSigma]", 
      RowBox[{"i", "=", "1"}], 
      RowBox[{"2", "n"}]], 
     SubscriptBox["\[ScriptL]", 
      RowBox[{"\[Mu]", ",", "i"}]], 
     SubscriptBox["c", "i"]}]}], TraditionalForm]],ExpressionUUID->
  "a6265296-6463-4082-b1d4-b0063201e1a2"],
 "."
}], "Notes",
 CellID->1299582758,ExpressionUUID->"a4d3044e-946c-4e94-9d15-6daa126f5cbd"],

Cell[TextData[{
 "It is useful to note that with respect to the Hermitian product, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"A", ",", "B"}], "\[RightAngleBracket]"}], ":=", 
    RowBox[{"Tr", "[", 
     RowBox[{
      SuperscriptBox["A", "\[Dagger]"], "B"}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"614be16b-9620-434a-a369-70b172f1c8c7"],
 ", the Hermitian conjugate ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalL]", "\[Dagger]"], TraditionalForm]],
  ExpressionUUID->"0494df09-0463-47c1-b2d2-fae9e9cb5d31"],
 " of the Lindblad supermap ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalL]", TraditionalForm]],ExpressionUUID->
  "c262be23-2875-43ab-b8b0-33b80459e3e3"],
 " is given by\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[ScriptCapitalL]", "\[Dagger]"], "(", "\[Rho]", ")"}], ":=", 
    RowBox[{
     RowBox[{"+", 
      RowBox[{"\[ImaginaryI]", "[", 
       RowBox[{"H", ",", "\[Rho]"}], "]"}]}], "+", 
     RowBox[{
      FractionBox["1", "2"], 
      SubscriptBox["\[CapitalSigma]", "\[Mu]"], 
      RowBox[{
       SubsuperscriptBox["L", "\[Mu]", "\[Dagger]"], "\[ThinSpace]", "[", 
       RowBox[{"\[Rho]", ",", 
        SubscriptBox["L", "\[Mu]"]}], "]"}]}], "+", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{
       SubscriptBox["\[CapitalSigma]", "\[Mu]"], "\[ThinSpace]", "[", 
       RowBox[{
        SubsuperscriptBox["L", "\[Mu]", "\[Dagger]"], ",", "\[Rho]"}], "]"}], 
      
      SubscriptBox["L", "\[Mu]"]}]}]}], TraditionalForm]],ExpressionUUID->
  "b4c712ab-f05f-4573-857e-820da9eefdac"],
 " ."
}], "Notes",
 CellID->2112322187,ExpressionUUID->"5c2691cf-155c-40e0-9571-5c84c7bf6e38"],

Cell[TextData[{
 "Furthermore, when the quantum jump operators are Hermitian (such as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["a", "k", "\[Dagger]"], 
    SubscriptBox["a", "k"]}], TraditionalForm]],ExpressionUUID->
  "f1225214-5718-47b7-acf0-b6f6e404f424"],
 "), the Hermitian conjugate is given by\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[ScriptCapitalL]", "\[Dagger]"], "(", "\[Rho]", ")"}], ":=", 
    RowBox[{
     RowBox[{"+", 
      RowBox[{"\[ImaginaryI]", "[", 
       RowBox[{"H", ",", "\[Rho]"}], "]"}]}], "-", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{
       SubscriptBox["\[CapitalSigma]", "\[Mu]"], "\[ThinSpace]", "[", 
       "\[ThinSpace]", 
       RowBox[{
        SubscriptBox["L", "\[Mu]"], ",", 
        RowBox[{"[", 
         RowBox[{
          SubscriptBox["L", "\[Mu]"], ",", "\[Rho]"}], "]"}]}], "]"}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"e3532059-ae80-4e58-b2aa-3383d8cd1791"],
 " .\[LineSeparator]From this, it is clear that the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[ScriptCapitalL]", "\[Dagger]"], "(", "\[Rho]", ")"}], 
   TraditionalForm]],ExpressionUUID->"285a1d41-fc6f-4ab9-9f75-edf2ddbfbe0b"],
 " is quadratic if ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "f0cc50b2-a5df-4427-89bb-800509646a8a"],
 " are quadratic."
}], "Notes",
 CellID->1030785274,ExpressionUUID->"091369f6-3170-4934-bc38-d3b401677643"]
}, Closed]],

