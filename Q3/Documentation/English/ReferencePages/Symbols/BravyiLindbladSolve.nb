          SubsuperscriptBox["b", "\[Mu]", "\[Dagger]"], 
          SubscriptBox["b", "\[Mu]"]}]}]}], TraditionalForm]],ExpressionUUID->
      "5d6d6f45-787e-4c79-bcfd-3789752362a9"],
     ", where ",
     Cell[BoxData[
      FormBox[
       SubscriptBox["b", "\[Mu]"], TraditionalForm]],ExpressionUUID->
      "9f0bf080-daaf-4038-9685-013b65f4a54b"],
