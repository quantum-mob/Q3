 CellID->362653969,ExpressionUUID->"30399ef0-ba74-400c-b319-028e09bd40f1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "rho", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EchoTiming", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rho", "[", "t_", "]"}], "=", 
    RowBox[{"NLindbladSolve", "[", 
     RowBox[{"spr", ",", "in", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "$T"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", "]"}], ";"}]}], "Input",
