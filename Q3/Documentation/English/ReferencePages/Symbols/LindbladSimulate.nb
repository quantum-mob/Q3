Cell["\<\
Pick the time slices at every of which a state vector is sampled.\
\>", "ExampleText",
 CellID->3338789,ExpressionUUID->"53cf6309-6f87-4995-b91c-333410dda5c7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tt", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", "10", ",", "0.05"}], "]"}]}], ";"}]], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
