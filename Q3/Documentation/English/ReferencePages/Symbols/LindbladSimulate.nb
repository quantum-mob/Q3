Cell["\<\
Simulate the Lindblad equation using the quantum jump approach. The progress \
indicator moves one step forward each time a trajectory is generated.\
\>", "ExampleText",
 CellID->1333360839,ExpressionUUID->"cb1a0196-5f0b-455a-b953-892ac84d1c17"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EchoTiming", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"data", "=", 
    RowBox[{"Block", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[CapitalGamma]", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalGamma]", "[", "\"\<+\>\"", "]"}], "=", ".3"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[CapitalGamma]", "[", "\"\<-\>\"", "]"}], "=", ".7"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"LindbladSimulate", "[", 
        RowBox[{"opH", ",", "opL", ",", "in", ",", "tt", ",", 
         RowBox[{"\"\<Samples\>\"", "->", "500"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[5]:=",
 CellID->1301683069,ExpressionUUID->"1c09a4fd-9b3d-422e-9dce-da576886dfb4"],

Cell[BoxData["0.559817`"], "EchoTiming",
 CellID->267346607,ExpressionUUID->"99af733d-61c3-4bba-8dfc-d1b0654f8ea2"]
}, Open  ]],

Cell[TextData[{
 "Construct the density matrix at each times. Note that ",
 StyleBox["data", "Input"],
 " from the above has the structure of form ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["data", "TI"], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SubscriptBox[
         StyleBox["v", "TI"], 
         StyleBox["in", "TI"]], ",", 
        RowBox[{
         SubscriptBox[
          StyleBox["v", "TI"], 
          StyleBox["1", "TR"]], 
         RowBox[{"(", 
          SubscriptBox[
           StyleBox["t", "TI"], 
           StyleBox["1", "TR"]], ")"}]}], ",", 
        RowBox[{
         SubscriptBox[
          StyleBox["v", "TI"], 
          StyleBox["1", "TR"]], 
         RowBox[{"(", 
          SubscriptBox[
           StyleBox["t", "TI"], 
           StyleBox["2", "TR"]], ")"}]}], ",", 
        StyleBox["\[Ellipsis]", "TR"]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox[
         StyleBox["v", "TI"], 
         StyleBox["in", "TI"]], ",", 
        RowBox[{
         SubscriptBox[
          StyleBox["v", "TI"], 
          StyleBox["2", "TR"]], 
         RowBox[{"(", 
          SubscriptBox[
           StyleBox["t", "TI"], 
           StyleBox["1", "TR"]], ")"}]}], ",", 
        RowBox[{
         SubscriptBox[
          StyleBox["v", "TI"], 
          StyleBox["2", "TR"]], 
         RowBox[{"(", 
          SubscriptBox[
           StyleBox["t", "TI"], 
           StyleBox["2", "TR"]], ")"}]}], ",", 
        StyleBox["\[Ellipsis]", "TR"]}], "}"}], ",", 
      StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b24f8374-a9dc-4a8a-b496-c7a4ee74c1ba"],
 "; see the ",
 ButtonBox["Details and Options",
  BaseStyle->"Link",
  ButtonData->"paclet:QuantumMob/Q3/ref/LindbladSimulate#1226658091"],
 " section section above."
}], "ExampleText",
 CellID->751405728,ExpressionUUID->"c451148c-a481-4e8d-91b2-32ab3bbdea1e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"EchoTiming", "[", 
  RowBox[{
   RowBox[{"tmp", "=", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Dyad", "[", 
        RowBox[{"#", ",", "#"}], "]"}], "&"}], ",", "data", ",", 
      RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"EchoTiming", "[", 
