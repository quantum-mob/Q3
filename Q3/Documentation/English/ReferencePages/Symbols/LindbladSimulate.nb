Cell["\<\
Simulate the Lindblad equation using the quantum jump approach.\
\>", "ExampleText",
 CellID->1958431180,ExpressionUUID->"ec6ea609-265e-49fb-9791-9bf9ac13de04"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EchoTiming", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"data", "=", 
    RowBox[{"Block", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[CapitalGamma]", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalGamma]", "[", "\"\<+\>\"", "]"}], "=", ".3"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[CapitalGamma]", "[", "\"\<-\>\"", "]"}], "=", ".7"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"LindbladSimulate", "[", 
        RowBox[{
        "opH", ",", "opL", ",", "in", ",", "tt", ",", "\[IndentingNewLine]", 
         RowBox[{"\"\<Samples\>\"", "->", "100"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[6]:=",
 CellID->870984691,ExpressionUUID->"0b52f57e-18a4-40d6-92a7-c6bceb2e9680"],

Cell[BoxData["0.136287`"], "EchoTiming",
 CellID->731445660,ExpressionUUID->"f6b88c1f-30ae-446e-bff9-5043cfb6c294"]
}, Open  ]],

Cell[TextData[{
 "Construct the density matrix at each times. Again, notice ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Transpose"]], "paclet:ref/Transpose"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "182d575d-8c02-49fe-84e5-11047d0eb99a"],
 " here; for the form of the output data, see the ",
 ButtonBox["Details and Options",
  BaseStyle->"Link",
  ButtonData->"paclet:QuantumMob/Q3/ref/LindbladSimulate#1226658091"],
 " section above."
}], "ExampleText",
 CellID->1382089322,ExpressionUUID->"69ed4657-6962-4de1-abe0-6ea75dd54479"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rho", "=", 
   RowBox[{"Mean", "/@", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Dyad", "[", 
        RowBox[{"#", ",", "#"}], "]"}], "&"}], ",", 
      RowBox[{"Transpose", "@", "data"}], ",", 
      RowBox[{"{", "2", "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Dimensions", "[", "rho", "]"}]}], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
