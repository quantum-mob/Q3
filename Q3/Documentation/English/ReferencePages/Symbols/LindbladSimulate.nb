   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "de150d59-8050-44f9-9450-139a3f09c9df"],
 ", then ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LindbladSimulate"]], 
    "paclet:QuantumMob/Q3/ref/LindbladSimulate", "QuantumMob Package Symbol"},
   
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8a060025-1cc9-4edc-a08f-c03cd16b146c"],
 " returns the name of the file that stores the quantum trajectories. The \
file stores the compressed data of the form ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Association"]], "paclet:ref/Association"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "[", 
   RowBox[{
    RowBox[{"\"\<Times\>\"", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        StyleBox["t", "TI"], 
        StyleBox["1", "TR"]], ",", 
       SubscriptBox[
        StyleBox["t", "TI"], 
        StyleBox["2", "TR"]], ",", 
       StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], ",", 
    RowBox[{"\"\<Data\>\"", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        StyleBox["trajectory", "TI"], 
        StyleBox["1", "TR"]], ",", 
       SubscriptBox[
        StyleBox["trajectory", "TI"], 
        StyleBox["2", "TR"]], ",", 
       StyleBox["\[Ellipsis]", "TR"]}], "}"}]}]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ca318969-9127-4584-b109-c3ad300f2738"],
 ". The compressed data can be uncompressed using ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Uncompress"]], "paclet:ref/Uncompress"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a0430ed2-056e-4750-9d9c-3539064c3b06"],
 "."
}], "Notes",
 CellID->908825388,ExpressionUUID->"3a326a14-71bd-4132-91a6-2374aa70effe"],

Cell[TextData[{
 "The data file format is the MX file; see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DumpSave"]], "paclet:ref/DumpSave"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6264f21f-a89a-4f2c-be7b-6330978f38a3"],
 ". One can read in the data using ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Import"]], "paclet:ref/Import"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], 
   "[", "\"\<\!\(\*StyleBox[\"filename\", \"TI\"]\).mx\>\"", "]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "309c72fa-dc55-4559-94b2-c83c1255eb3a"],
 "."
}], "Notes",
 CellID->1999173437,ExpressionUUID->"096b2f5f-3517-4f0d-841d-99511352556a"],

Cell["\<\
As long as the parameters are the same, data sets stored in different files \
(generated at different instants of simulation) may be combined to improve \
the statistical error.\
\>", "Notes",
 CellID->281100389,ExpressionUUID->"997e2634-2f60-4bc5-8c88-eb4f2c3bc5da"],

Cell["The following options can be given: ", "Notes",
 CellID->1473646436,ExpressionUUID->"10415be4-2317-4818-a98d-edd2153aaba1"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
