associated with the Hamiltonian ",
     Cell[BoxData[
      StyleBox["ham", "TI"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "20a6ce77-332d-458f-8a97-841bb0de812e"],
     " and a set of quantum jump operators ",
     Cell[BoxData[
      StyleBox["jmp", "TI"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "84d524d8-3147-40ca-a488-10b67baf5444"],
     " for the initial state ",
     Cell[BoxData[
      StyleBox["in", "TI"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "9bc54ab4-eb45-49c6-9cbd-cdeb05e4b454"],
     " (either ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["WickState"]], "paclet:QuantumMob/Q3/ref/WickState", 
        "QuantumMob Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "9806de5a-0d6f-4c6c-aa4f-dca994ca1dc8"],
     " or Green's function matrix)."
    }],ExpressionUUID->"3ac1ad1f-7f96-4a86-96ba-eb562c67206a"]},
   {"", Cell[TextData[{
     Cell[BoxData[
      RowBox[{
       TemplateBox[{
