Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"k", "+", "1"}], ")"}], "th"], TraditionalForm]],ExpressionUUID->
  "06d377bd-18ed-4ec2-b7d5-e75914f99193"],
 " GHZ state of  ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "29d48ebb-0a1b-4d67-b22c-32f442b93cfa"],
 " many ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]],ExpressionUUID->
  "0f30a402-734a-4b8a-ba98-717dd21ad05d"],
 "-level quantum systems is given by (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Wolf, 2003"]], 
    "https://www-m5.ma.tum.de/foswiki/pub/M5/Allgemeines/PublicationsWolf/\
thesismerge.pdf"},
   "WebLink",
   BaseStyle->{"Notes"}]],ExpressionUUID->
  "a06b64fc-75c4-42f3-8dfe-ff336bf49b00"],
 ")\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      SubscriptBox["GHZ", "k"]},
     "Ket"], ":=", 
    RowBox[{
     FractionBox["1", 
      SqrtBox["d"]], 
     UnderoverscriptBox["\[CapitalSigma]", 
      RowBox[{"x", "=", "0"}], 
      RowBox[{"d", "-", "1"}]], 
     RowBox[{
      TemplateBox[{
        RowBox[{"x", "+", 
          SubscriptBox["k", "1"]}]},
       "Ket"], "\[CircleTimes]", 
      TemplateBox[{
        RowBox[{"x", "+", 
          SubscriptBox["k", "2"]}]},
       "Ket"], "\[CircleTimes]", "\[Ellipsis]", "\[CircleTimes]", 
      TemplateBox[{
        RowBox[{"x", "+", 
          SubscriptBox["k", "n"]}]},
       "Ket"]}], 
     RowBox[{"exp", "(", 
      RowBox[{
      "2", "\[Pi]", "\[VeryThinSpace]", "\[ImaginaryI]", "\[VeryThinSpace]", 
       "x", "\[VeryThinSpace]", 
       RowBox[{
        SubscriptBox["k", "1"], "/", "d"}]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"0e1daec0-b0a3-4594-8eba-750c3621d507"],
 " ,\[LineSeparator]where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "i"], TraditionalForm]],ExpressionUUID->
  "81bf3b08-f8e3-4aa6-86fc-f28351bb0b15"],
 " are base-",
 Cell[BoxData[
  FormBox["d", TraditionalForm]],ExpressionUUID->
  "ff243cd1-019a-494a-929f-1f212280a8cd"],
 " digits of integer ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "\[Element]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", "2", ",", "\[Ellipsis]", ",", 
      RowBox[{
       SuperscriptBox["d", "n"], "-", "1"}]}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"c4242266-0c41-42e7-b63a-2206024718be"],
 ", i.e., ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", ":=", 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["k", "1"], 
       SubscriptBox["k", "2"], "\[Ellipsis]", "\[VeryThinSpace]", 
       SubscriptBox["k", "n"]}], ")"}], "d"]}], TraditionalForm]],
  ExpressionUUID->"3ee2499e-748a-4348-a2be-068b986c6a5e"],
 "."
}], "Notes",
 CellID->95824658,ExpressionUUID->"3e4f3de3-0abf-4129-b746-f02e88d41487"],

Cell[TextData[{
 "The GHZ states form an orthonormal basis for the Hilbert space ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalC]", 
    RowBox[{"d", "\[Times]", "n"}]], TraditionalForm]],ExpressionUUID->
  "b79481d1-3f23-4557-bf1c-5a1e65ca4a82"],
 "of ",
 StyleBox["n",
  FontSlant->"Italic"],
 " ",
 StyleBox["d",
  FontSlant->"Italic"],
 "-level quantum systems."
}], "Notes",
 CellID->1957705826,ExpressionUUID->"87e4a0bb-76c6-43e9-8b9f-d95624892999"],

Cell[TextData[{
 "All GHZ states are ",
 StyleBox["local unitary equivalent",
  FontSlant->"Italic"],
 " to each other."
}], "Notes",
 CellID->255260394,ExpressionUUID->"45efecd1-141e-4436-a4dc-0bef7d07aee2"],

