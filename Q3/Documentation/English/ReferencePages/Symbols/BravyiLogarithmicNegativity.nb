Cell["\<\
Construct a matrix of Green's functions. Note that we are deliberately \
avoiding the case where the matrix of Green's functions has an eigenvalue of \
unity; see below:\
\>", "ExampleText",
 CellID->28224962,ExpressionUUID->"f421c236-5026-4661-998b-be7df0cd5094"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "358", "]"}], ";"}]], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[2]:=",
 CellID->672106451,ExpressionUUID->"3099bd57-9009-4e4a-851f-0b5042fdafe5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"grn", "=", 
   RowBox[{"RandomPositive", "[", "$n", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"grn", "/=", 
   RowBox[{"Max", "[", 
    RowBox[{"Eigenvalues", "[", "grn", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"grn", "=", 
   RowBox[{
    RowBox[{"One", "[", "$n", "]"}], "-", "grn"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Eigenvalues", "[", "grn", "]"}], "//", "Chop"}]}], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[3]:=",
 CellID->295946352,ExpressionUUID->"1d17c72f-0435-4667-995f-4d7ab3e88741"],

