Cell[TextData[{
 "A Wick state represents a fermionic Gaussian pure state of the form\
\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[CapitalPi]", 
      RowBox[{"j", "=", "1"}], "n"], "(", 
     RowBox[{
      SubsuperscriptBox["\[CapitalSigma]", 
       RowBox[{"i", "=", "1"}], "m"], 
      SubsuperscriptBox["c", "i", "\[Dagger]"], 
      SubsuperscriptBox["U", 
       RowBox[{"i", "\[VeryThinSpace]", "j"}], "\[Dagger]"]}], ")"}], 
    TemplateBox[{"\[SpaceIndicator]"},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "88cf01a5-dde6-4e8b-9948-fcc59d39ca73"],
 ",\[LineSeparator]where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"\[SpaceIndicator]"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "4043bf8e-9e01-46ec-88cb-69527627a092"],
 " denotes the vacuum state, ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "43b4f72a-df36-4b4d-8d6b-9b53bbb75eaf"],
 " is the number of fermion modes, ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "662a8ef4-1a7a-4760-95e3-5f56f4f172da"],
 " is the number of particles. The ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "\[Times]", "m"}], TraditionalForm]],ExpressionUUID->
  "17ec4b8a-8536-40ed-ab1a-ba49c8068453"],
 " matrix ",
 Cell[BoxData[
  FormBox["U", TraditionalForm]],ExpressionUUID->
  "bdf7cf35-a4ab-4edd-8397-6d35afc1e2a3"],
 " is isometric, i.e., ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"U", "\[VeryThinSpace]", 
     SuperscriptBox["U", "\[Dagger]"]}], "=", 
    SubscriptBox["I", "n"]}], TraditionalForm]],ExpressionUUID->
  "e7eee3b1-8702-47c3-b6a3-1cb115f0e892"],
 "; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["U", "\[Dagger]"], "U"}], "\[NotEqual]", 
    SubscriptBox["I", "m"]}], TraditionalForm]],ExpressionUUID->
  "4777db89-1e4e-4b2e-8de6-5dae4d0b1d9a"],
 " in general."
}], "Notes",
 CellID->4290819,ExpressionUUID->"5cdd5cf0-0707-4475-b04d-b86209007fe8"],

Cell[TextData[{
 "The operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["d", "i"], ":=", 
    RowBox[{
     SubsuperscriptBox["\[CapitalSigma]", 
      RowBox[{"j", "=", "1"}], "m"], 
     SubscriptBox["U", 
      RowBox[{"i", "\[VeryThinSpace]", "j"}]], 
     SubscriptBox["c", "j"]}]}], TraditionalForm]],ExpressionUUID->
  "6c08b0a6-7d4e-4869-b921-b50642b88f3b"],
 " are associated with dressed fermion modes, and satisfy the commutation \
relations\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["d", "i"], ",", 
      SubsuperscriptBox["d", "j", "\[Dagger]"]}], "}"}], "=", 
    SubscriptBox["\[Delta]", 
     RowBox[{"i", "\[VeryThinSpace]", "j"}]]}], TraditionalForm]],
  ExpressionUUID->"1687fe94-81c9-4801-9e71-e660281a8a3b"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["d", "i"], ",", 
      SubscriptBox["d", "j"]}], "}"}], "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubsuperscriptBox["d", "i", "\[Dagger]"], ",", 
       SubsuperscriptBox["d", "j", "\[Dagger]"]}], "}"}], "=", "0"}]}], 
   TraditionalForm]],ExpressionUUID->"aea60b14-341a-4c64-8e69-0a700d972b49"],
 "."
}], "Notes",
 CellID->1334406494,ExpressionUUID->"0af29766-974c-48c2-9490-3f02b38469ff"],

Cell[TextData[{
 "For general fermionic Gaussian pure states (with pairing correlation), see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BravyiState"]], "paclet:QuantumMob/Q3/ref/BravyiState", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "03112acc-756f-480d-882d-492f4e093f91"],
 "."
}], "Notes",
 CellID->2075823871,ExpressionUUID->"68e48c2b-2aeb-4389-ba4a-8ef68fac7d03"],

Cell[TextData[{
 "Since Q3 v4.5.14, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["WickState"]], "paclet:QuantumMob/Q3/ref/WickState", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "02c8d846-2a26-4375-a2ec-8054241d178b"],
 " carries the global phase and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Matrix"]], "paclet:QuantumMob/Q3/ref/Matrix", 
     "QuantumMob Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["WickState"]], "paclet:QuantumMob/Q3/ref/WickState", 
      "QuantumMob Package Symbol"},
     "PackageLink",
     BaseStyle->"InlineFormula"], "[", 
    StyleBox["\[Ellipsis]", "TR"], "]"}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "838f9e29-df04-4982-af78-f99c1be2e66d"],
 "  returns the native vector without canonicalization."
}], "Notes",
 CellID->1153194490,ExpressionUUID->"8c19c0a3-3790-400a-9eb9-689884107068"]
}, Closed]],

