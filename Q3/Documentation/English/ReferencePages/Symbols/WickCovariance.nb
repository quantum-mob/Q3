Cell[TextData[{
 "The (normal) covariance matrix of fermion modes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "k"], TraditionalForm]],ExpressionUUID->
  "2f48d699-36aa-4639-945f-d6b5b2d10c44"],
 " is defined by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalGamma]", 
     RowBox[{"i", "\[VeryThinSpace]", "j"}]], ":=", 
    RowBox[{
     RowBox[{"2", 
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{
        SubscriptBox["a", "i"], 
        SubsuperscriptBox["a", "j", "\[Dagger]"]}], 
       "\[RightAngleBracket]"}]}], "-", 
     SubscriptBox["\[Delta]", 
      RowBox[{"\[Iota]", "\[VeryThinSpace]", "j"}]]}]}], TraditionalForm]],
  ExpressionUUID->"170ebbdf-63e1-4b4a-836d-ebc7db79802c"],
 ".:\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalGamma]", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"2", "G"}], "-", "I"}], "=", 
     RowBox[{"I", "-", 
      RowBox[{"2", 
       SuperscriptBox["C", "T"]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "ec297aa6-0268-4ff2-bef0-7a862214ea6b"],
 ",\[LineSeparator]where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["C", 
     RowBox[{"i", "\[VeryThinSpace]", "j"}]], ":=", 
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       SubsuperscriptBox["a", "i", "\[Dagger]"], 
       SubscriptBox["a", "j"]}], "\[RightAngleBracket]"}], "\[Congruent]", 
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{"I", "-", 
        SuperscriptBox["G", "T"]}], ")"}], 
      RowBox[{"i", "\[VeryThinSpace]", "j"}]]}]}], TraditionalForm]],
  ExpressionUUID->"de10354c-7ee6-4742-80f3-5a82ad259002"],
 " is the ",
 StyleBox["correlation matrix",
  FontSlant->"Italic"],
 "."
}], "Notes",
 CellID->1128051646,ExpressionUUID->"f5e6c6c1-ab50-4bc9-970d-c819c29eca4f"]
}, Closed]],

