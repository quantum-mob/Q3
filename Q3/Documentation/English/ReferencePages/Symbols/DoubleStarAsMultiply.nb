Cell[TextData[{
 "Prior to Mathematica 14.3, the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6267f12f-cd6e-47af-952c-b95af6963e24"],
 " operator (",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e60dff8a-0ca6-4dc2-b84f-b2a852c244ab"],
 ") lacked a built-in definition. Consequently, it was relatively safe when \
Q3 reset ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3a378697-d089-4c14-96ab-2b509b781cd6"],
 " to be an alias of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e22686c5-0822-4f3f-9e53-f78ab8504e35"],
 ". This reset primarily aimed to enable users to utilize ",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7a6426dd-2596-43ad-8b3e-62844729f5ee"],
 " for interactive expression typing."
}], "Notes",
 CellID->1717752879,ExpressionUUID->"7bb2e177-4ee9-4d30-8fde-ca8c48c0c1b6"],

Cell[TextData[{
 "Mathematica 14.3 introduced ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeAlgebra"]], "paclet:ref/NonCommutativeAlgebra"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "da11d370-3f34-4912-b8fd-4e36a6ec2319"],
 ", which designated ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "edf4ece4-b87f-4ede-bdc7-e4f38d6e8ace"],
 " as the default operator. This resulted in numerous conflicts with Q3 when \
attempting to utilize the features of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeAlgebra"]], "paclet:ref/NonCommutativeAlgebra"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1a9129a6-8864-41ac-a1b2-9efff5e36923"],
 " or similar functions."
}], "Notes",
 CellID->1877245781,ExpressionUUID->"0e702eb6-6746-4f1a-8a1b-e4c9e2be63b5"],

Cell[TextData[{
 "To mitigate these conflicts, Q3 4.6.0 separated ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c2475f72-fc4c-48a9-beb5-c5c4d8cf1aa5"],
 " from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a22d570b-c902-4990-8283-279971da89cd"],
 "; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "34d0bfd8-824a-4725-a183-02852299ebd4"],
 " is no longer an alias of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8bd33f6c-ea38-444d-be62-faf11cd488f2"],
 " in Q3."
}], "Notes",
 CellID->1459755584,ExpressionUUID->"7580be7b-b532-4b8e-90bc-02d76c160912"],

Cell[TextData[{
 "However, we recognize the need to allow users to employ the ",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "867c274c-3d58-469e-a981-74b0850a82e4"],
 " operator for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4489af89-8276-432f-8053-4b30cf2706af"],
 " when typing expressions interactively. For instance, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], "**", 
   StyleBox["b", "TI"], "**", 
   StyleBox["c", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9a4998f6-0a05-42ad-9e35-eaf5ca031c35"],
 " is more convenient to type than ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
     "QuantumMob Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"], ",", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "29c861ff-7d1f-42b5-996d-cf79a6ca193f"],
 ". Therefore, for the convenience of Q3 users, the ",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "429f473f-9034-4863-8337-fc180aaa3faa"],
 " operator is temporarily hijacked and redefined as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "afca5a5f-0a47-4c3e-9fa0-d82e4eb5dd98"],
 " (rather than ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f43fdd81-6ca1-4102-95c7-e90dd5511d76"],
 ") within the frontend (Wolfram Notebook) interface."
}], "Notes",
 CellID->196329507,ExpressionUUID->"f095935b-b1f9-4acd-97f2-0dc1fb775387"],

Cell[TextData[{
 "Note, however, that in any Wolfram script or package loaded by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Get"]], "paclet:ref/Get"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "db77d24e-b203-48a9-9f02-7b115aca63fb"],
 " or similar functions, the ",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5c9c32f6-0d6c-496c-8a3f-3cdcda21e7d3"],
 " operator is still interpreted as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4ef07dce-2f71-4ac7-9ee9-c0ad0f725fe2"],
 ". This behavior can be toggled on and off by utilizing ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DoubleStarAsMultiply"]], 
    "paclet:QuantumMob/Q3/ref/DoubleStarAsMultiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4575d6f1-bbc9-44d9-ad73-81f2b42e27f1"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DoubleStarAsBuiltin"]], 
    "paclet:QuantumMob/Q3/ref/DoubleStarAsBuiltin", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "88b81971-44f9-4eb3-a48c-8dd4f291e63b"],
 ". Nevertheless, the different behaviors of the ",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "51d50cdd-12b2-4cae-b50b-800c680eef4f"],
 " operator depending on the environment may cause a confusion."
}], "Notes",
 CellID->970030297,ExpressionUUID->"41e30af2-d378-4908-b04a-4e3682d7e36b"]
}, Closed]],

