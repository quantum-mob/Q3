Cell[TextData[{
 "Prior to Mathematica 14.3, the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ddeb9dbb-64dd-4436-90e0-521287337515"],
 " operator (",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "57245471-fa44-4ee7-a2d5-5ea374bde5ed"],
 ") lacked a built-in definition. Consequently, it was relatively safe when \
Q3 reset ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d4785e45-92da-4201-ae87-8283778971f7"],
 " to be an alias of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "29ac3bbc-0559-4890-a8e5-d75e9cab6f45"],
 ". This reset primarily aimed to enable users to utilize ",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2dcce389-73e8-4c11-8705-96712759fbab"],
 " for interactive expression typing."
}], "Notes",
 CellID->1717752879,ExpressionUUID->"800cb6cd-6974-4012-86ff-8603d0d590f5"],

Cell[TextData[{
 "Mathematica 14.3 introduced ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeAlgebra"]], "paclet:ref/NonCommutativeAlgebra"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "194b76d0-547f-4c4d-afa7-a43ca5fd3708"],
 ", which designated ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "328608f2-653f-4cc9-bd2d-50bcca644933"],
 " as the default operator. This resulted in numerous conflicts with Q3 when \
attempting to utilize the features of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeAlgebra"]], "paclet:ref/NonCommutativeAlgebra"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "16262fee-4b10-4eb4-a056-0a0f37960168"],
 " or similar functions."
}], "Notes",
 CellID->1877245781,ExpressionUUID->"a6f05bf3-c80b-48ad-acde-356c141df677"],

Cell[TextData[{
 "To mitigate these conflicts, Q3 4.6.0 separated ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a837f76f-bf93-407a-b4a3-06685a9e1759"],
 " from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a8f7120d-b51e-490f-9248-6dab50df0b83"],
 "; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f5926a1c-5ab4-46e0-8eb8-199b19daa6eb"],
 " is no longer an alias of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "477699ca-e0cb-423e-9348-05bad1ccac2a"],
 " in Q3."
}], "Notes",
 CellID->1459755584,ExpressionUUID->"578a2843-b82a-44a5-ab30-f2831f2a3eef"],

Cell[TextData[{
 "However, we recognize the need to allow users to employ the ",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "88018235-5fd7-4eb6-b335-4088a4841291"],
 " operator for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a03016dc-46a1-48f7-997a-87f4adceb184"],
 " when typing expressions interactively. For instance, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], "**", 
   StyleBox["b", "TI"], "**", 
   StyleBox["c", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "22079c6d-2851-48a6-8c84-6155eef8c757"],
 " is more convenient to type than ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
     "QuantumMob Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"], ",", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cc93e6ac-4166-49e4-9d2f-f8c35dd4a4ab"],
 ". Therefore, for the convenience of Q3 users, the ",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "80abbc2e-2114-4525-ac61-ef95f3888014"],
 " operator is temporarily hijacked and redefined as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0b0cfd36-af68-4c71-be00-2dda29ba996b"],
 " (rather than ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e2c9a0d7-5d00-436f-82cd-90e4b291877c"],
 ") within the frontend (Wolfram Notebook) interface. This behavior can be \
toggled on and off by utilizing ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DoubleStarAsMultiply"]], 
    "paclet:QuantumMob/Q3/ref/DoubleStarAsMultiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "320d5f31-d51f-44a9-996d-5aa4c63d1445"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DoubleStarAsBuiltin"]], 
    "paclet:QuantumMob/Q3/ref/DoubleStarAsBuiltin", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4033b46d-e6f9-45c6-9c6a-362f88eebd01"],
 "."
}], "Notes",
 CellID->196329507,ExpressionUUID->"06333742-00ad-4a3b-9798-eeb3733fa73c"],

Cell[TextData[{
 "Note, however, that in any Wolfram script or package loaded by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Get"]], "paclet:ref/Get"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bd1af8f1-fbb9-44da-ae21-d06a7a6a3fd2"],
 " or similar functions, the ",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "25f686d6-3d17-4531-bbbc-a27f660c5d3e"],
 " operator is always interpreted as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3bd9f0ec-74d8-49f4-8d85-cbd5c30e9716"],
 ". The different behaviors of the ",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8f3b7732-d1c9-434b-8f86-eab0522cd6c4"],
 " operator depending on the environment may cause a confusion."
}], "Notes",
 CellID->970030297,ExpressionUUID->"dabfcb54-d2e9-41fa-894f-e2a369c7e197"]
}, Closed]],

