Cell[TextData[{
 "Prior to Mathematica 14.3, the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c433da92-aa11-43e6-9cac-67646aa5a6bc"],
 " operator (",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ae45aa80-c9f5-4dcc-b82f-da4450bd712d"],
 ") lacked a built-in definition. Consequently, it was relatively safe when \
Q3 reset ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ee9a134a-577a-43d8-ae56-3d0c1f268c39"],
 " to be an alias of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c42f92f0-1669-4635-ae0e-95052a427b31"],
 ". This reset primarily aimed to enable users to utilize ",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ec2edca1-600c-4ccf-b164-b37aeaa1be6e"],
 " for interactive expression typing."
}], "Notes",
 CellID->1717752879,ExpressionUUID->"6b906f1f-0fc7-46ab-a005-812ff32cac67"],

Cell[TextData[{
 "Mathematica 14.3 introduced ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeAlgebra"]], "paclet:ref/NonCommutativeAlgebra"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "123c8d79-cb78-488a-96a0-2c552687b231"],
 ", which designated ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7306d953-1dc9-440e-8d2d-a793abc72b7e"],
 " as the default operator. This resulted in numerous conflicts with Q3 when \
attempting to utilize the features of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeAlgebra"]], "paclet:ref/NonCommutativeAlgebra"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "26d8b572-1b80-486f-b1a7-3e5cacf5a47e"],
 " or similar functions."
}], "Notes",
 CellID->1877245781,ExpressionUUID->"8b742cf3-01c1-4f15-9fab-1c51caf0d5d7"],

Cell[TextData[{
 "To mitigate these conflicts, Q3 4.6.0 separated ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ebfeb9f2-1c9c-4095-b754-05dc51c38d9d"],
 " from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "79404405-aa9c-4219-9357-d9365d04bc26"],
 "; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "772a6948-1e7a-466c-bdc4-e81f7eb460b3"],
 " is no longer an alias of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "21cd2287-6f50-4bf7-b655-d23c20063b39"],
 " in Q3."
}], "Notes",
 CellID->1459755584,ExpressionUUID->"be9f0506-02d1-446f-b8f7-f7a63fb9b317"],

Cell[TextData[{
 "However, we recognize the need to allow users to employ the ",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c724d91d-f891-452c-9978-8c67add733dd"],
 " operator for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f388db14-b67b-47bc-b3f7-bb46b2267728"],
 " when typing expressions interactively. For instance, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], "**", 
   StyleBox["b", "TI"], "**", 
   StyleBox["c", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6b2e9bcc-62e4-41e3-a442-569d0a9c96a8"],
 " is more convenient to type than ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
     "QuantumMob Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"], ",", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4e4bae6e-fdb8-4297-a135-ae287684f62a"],
 ". Therefore, for the convenience of Q3 users, the ",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "83e285e4-4f8e-456c-826b-7bc58830e1de"],
 " operator is temporarily hijacked and redefined as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "06177a9a-4e8b-4261-b24b-2570c9625b62"],
 " (rather than ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "131cd515-4222-4904-a26b-3d2ee0064e2a"],
 ") within the frontend (Wolfram Notebook) interface."
}], "Notes",
 CellID->196329507,ExpressionUUID->"ef669b34-ac73-466a-b435-c0c26f636284"],

Cell[TextData[{
 "Note, however, that in any Wolfram script or package loaded by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Get"]], "paclet:ref/Get"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a8a7ca79-518c-4034-b4e1-ad10316243d1"],
 " or similar functions, the ",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d75a7e7b-4e97-40de-9c4e-99489c4a799f"],
 " operator is still interpreted as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1da103bd-8a6e-46ac-8adb-ffe88cb42006"],
 ". This behavior can be toggled on and off by utilizing ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DoubleStarAsMultiply"]], 
    "paclet:QuantumMob/Q3/ref/DoubleStarAsMultiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0f367d12-4344-4695-9c76-c587febc0d2b"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DoubleStarAsBuiltin"]], 
    "paclet:QuantumMob/Q3/ref/DoubleStarAsBuiltin", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4622dabf-1576-493a-b68c-df9ee56d01ef"],
 ". Nevertheless, the different behaviors of the ",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cfa42661-9e07-4c72-8ce4-bb42d4324879"],
 " operator depending on the environment may cause a confusion."
}], "Notes",
 CellID->970030297,ExpressionUUID->"aef92b31-6343-44e5-ba8a-c793e2097192"]
}, Closed]],

