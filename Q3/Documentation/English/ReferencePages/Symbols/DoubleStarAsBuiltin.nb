Cell[TextData[{
 "Prior to Mathematica 14.3, the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "73a0b09a-11a5-4ed8-a2ad-de31eff285f7"],
 " operator (",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "73022954-c7de-40ad-9849-fc1990a2e1cd"],
 ") lacked a built-in definition. Consequently, it was relatively safe when \
Q3 reset ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3c69180a-41e9-44ab-881c-f2287eb87234"],
 " to be an alias of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "30aefebb-6dcc-4d2f-a82d-c6c1b3f98565"],
 ". This reset primarily aimed to enable users to utilize ",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1a3f3937-db22-4f27-9c02-1abf8cea1cd6"],
 " for interactive expression typing."
}], "Notes",
 CellID->1717752879,ExpressionUUID->"e64d8f9c-128e-4331-a9c2-f8714f4cf0f1"],

Cell[TextData[{
 "Mathematica 14.3 introduced ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeAlgebra"]], "paclet:ref/NonCommutativeAlgebra"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "db788253-453b-4e30-ae69-9a97d4475083"],
 ", which designated ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3b6006e8-435d-495b-9950-14716d20241a"],
 " as the default operator. This resulted in numerous conflicts with Q3 when \
attempting to utilize the features of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeAlgebra"]], "paclet:ref/NonCommutativeAlgebra"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e03af2ca-f120-44b0-9f1d-46707808eaae"],
 " or similar functions."
}], "Notes",
 CellID->1877245781,ExpressionUUID->"8cd64810-9fde-44ee-a4da-5d5866530618"],

Cell[TextData[{
 "To mitigate these conflicts, Q3 4.6.0 separated ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6f03fe93-28ae-494c-aee3-3ce2f2cb9809"],
 " from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "00987562-8663-404e-a58b-42d1c4fbfccf"],
 "; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "926ade95-a57a-4e8a-9a38-0fa10d60377a"],
 " is no longer an alias of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "008e2cca-5268-4906-a6b4-d4cef755c27f"],
 " in Q3."
}], "Notes",
 CellID->1459755584,ExpressionUUID->"d2a3fd0c-b953-4c36-9ddc-10e7aca6cd33"],

Cell[TextData[{
 "However, we recognize the need to allow users to employ the ",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3fb2bdf6-d53d-4864-bfbd-f160c071edd3"],
 " operator for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b60f8092-85c7-4ba0-8e7e-fbf0d492f6d1"],
 " when typing expressions interactively. For instance, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], "**", 
   StyleBox["b", "TI"], "**", 
   StyleBox["c", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ff53465e-df68-44b6-b728-15b30eb457a7"],
 " is more convenient to type than ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
     "QuantumMob Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"], ",", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "77f67d1a-5e64-48a2-be45-a7bb0c15f382"],
 ". Therefore, for the convenience of Q3 users, the ",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cdb03b4f-f2aa-4260-9079-369abe319aa4"],
 " operator is temporarily hijacked and redefined as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Multiply"]], "paclet:QuantumMob/Q3/ref/Multiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6353ec25-3c39-416b-aa84-d2d54e33a03b"],
 " (rather than ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8d4c3326-212e-4d87-b986-4614c530c3d1"],
 ") within the frontend (Wolfram Notebook) interface. This behavior can be \
toggled on and off by utilizing ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DoubleStarAsMultiply"]], 
    "paclet:QuantumMob/Q3/ref/DoubleStarAsMultiply", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "34d5c93e-74d3-4350-ab83-8163a623c836"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DoubleStarAsBuiltin"]], 
    "paclet:QuantumMob/Q3/ref/DoubleStarAsBuiltin", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "83450f68-2970-4650-be01-4452a6592d16"],
 "."
}], "Notes",
 CellID->196329507,ExpressionUUID->"d68432eb-f3c9-469e-8b9c-0034786c3821"],

Cell[TextData[{
 "Note, however, that in any Wolfram script or package loaded by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Get"]], "paclet:ref/Get"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "38fd1837-720a-457e-b782-eefe5c24690e"],
 " or similar functions, the ",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fea6879f-8963-4ada-9c29-6d0568cb57b5"],
 " operator is always interpreted as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NonCommutativeMultiply"]], "paclet:ref/NonCommutativeMultiply"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "15ca2135-ecbb-45a0-a294-958fc3c6ad6d"],
 ". The different behaviors of the ",
 Cell[BoxData["**"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "356dc8c1-830e-46cc-ad4a-700cf318e49a"],
 " operator depending on the environment may cause a confusion."
}], "Notes",
 CellID->970030297,ExpressionUUID->"279a6eb6-6c12-4818-9a3d-dcacc1399715"]
}, Closed]],

