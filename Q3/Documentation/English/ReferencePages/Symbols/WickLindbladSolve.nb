Cell["Solve the quantum master equation:", "ExampleText",
 CellID->2034321986,ExpressionUUID->"4ec71abf-ac8d-4418-aff7-8555f9574e0d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"$T", "=", "4"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"final", " ", "time"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dt", "=", "0.01"}], ";"}]}], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[6]:=",
 CellID->1152631756,ExpressionUUID->"ae6e74d8-fb98-4287-8de0-f867dba17584"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"grn", "=", 
