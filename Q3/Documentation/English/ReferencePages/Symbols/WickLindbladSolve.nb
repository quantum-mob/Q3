      FontFamily->"Source Sans Pro",ExpressionUUID->
      "da91d662-2052-497c-86eb-febadd68cc77"],
     " to ",
     Cell[BoxData[
      SubscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["f", "TI"]]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "9aad6c11-513d-45c0-b1ac-abc9f2b611c0"],
     " at step ",
     Cell[BoxData[
      StyleBox["dt", "TI"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "c3003ffc-2717-41f6-b1ae-5508e05306fe"],
     "."
    }],ExpressionUUID->"0bcd07bc-43f1-4cff-8e0f-a6a82aee49bf"]},
