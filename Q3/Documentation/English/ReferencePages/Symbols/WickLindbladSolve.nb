 CellID->1484460928,ExpressionUUID->"5743a201-65db-4a0a-a5be-aeb7bdb0fcc6"],

Cell[TextData[{
 "We take the dissipative model for the ",
 StyleBox["Hatano",
  IgnoreSpellCheck->True,
  FontSlant->"Italic"],
 StyleBox["-Nelson Hamiltonian",
  FontSlant->"Italic"],
 "."
}], "ExampleText",
 CellID->1554113314,ExpressionUUID->"6044e3c9-70c0-458b-a1c5-48e39807e536"],

Cell["Construct the model:", "ExampleText",
 CellID->1228412337,ExpressionUUID->"24c4791c-7541-47f5-aeab-cc855fc64ffc"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "HatanoNelsonModel", "]"}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"HatanoNelsonModel", "[", 
    RowBox[{"L_", ",", "J_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ham", ",", "cff", ",", "jmp"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ham", "=", 
       RowBox[{"PlusTopple", "[", 
        RowBox[{
         RowBox[{"-", "J"}], "*", 
         RowBox[{"One", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"L", ",", "L"}], "}"}], ",", "1"}], "]"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"ham", "=", 
       RowBox[{"WickHermitian", "[", "ham", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"cff", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"One", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"L", "-", "1"}], ",", "L"}], "}"}], "]"}], "+", 
          RowBox[{"I", "*", 
           RowBox[{"One", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"L", "-", "1"}], ",", "L"}], "}"}], ",", "1"}], 
            "]"}]}]}], ")"}], "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"jmp", "=", 
       RowBox[{"WickJump", "@", 
        RowBox[{"Join", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Thread", "[", 
           RowBox[{"cff", "->", "0"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"Conjugate", "[", "cff", "]"}], "->", "1"}], "]"}]}], 
         "\[IndentingNewLine]", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"ham", ",", "jmp"}], "}"}]}]}], "\[IndentingNewLine]", 
    "]"}]}]}]}], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[1]:=",
 CellID->1177694704,ExpressionUUID->"4cb46710-7eaf-4cc0-ac36-c2b2a51a0582"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$L", "=", "6"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$\[Gamma]", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$J", "=", 
   RowBox[{"1", "/", "$\[Gamma]"}]}], ";"}]}], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[2]:=",
 CellID->171829249,ExpressionUUID->"0c4221de-001d-4217-8c88-7f154c02a9b3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ham", ",", "jmp"}], "}"}], "=", 
   RowBox[{"HatanoNelsonModel", "[", 
    RowBox[{"$L", ",", "$J"}], "]"}]}], ";"}]], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[3]:=",
 CellID->18365701,ExpressionUUID->"2c74936a-23d2-434f-b1c9-2ec943a50b5e"],

Cell["\<\
Check that the effective non-Hermitian Hamiltonian is the Hatano-Helson \
Hamiltonian, exhibiting the non-Hermitian skin effect:\
\>", "ExampleText",
 CellID->1668994244,ExpressionUUID->"d9af319d-3e49-4adc-a9bd-3c9143bea9a2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dmp", ",", "gmm"}], "}"}], "=", 
   RowBox[{"WickDampingOperator", "[", "jmp", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eff", "=", 
   RowBox[{"ham", "-", 
    RowBox[{"I", "*", "dmp"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"eff", "//", "MatrixForm"}]}], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[4]:=",
 CellID->1116131714,ExpressionUUID->"da4cd9d7-60ec-4a53-b793-02bf490b0410"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0.`", 
      RowBox[{"-", "1.5`"}], "0.`", "0.`", "0.`", "0.`"},
     {
      RowBox[{"-", "2.5`"}], "0.`", 
      RowBox[{"-", "1.5`"}], "0.`", "0.`", "0.`"},
     {"0.`", 
      RowBox[{"-", "2.5`"}], "0.`", 
      RowBox[{"-", "1.5`"}], "0.`", "0.`"},
     {"0.`", "0.`", 
      RowBox[{"-", "2.5`"}], "0.`", 
      RowBox[{"-", "1.5`"}], "0.`"},
     {"0.`", "0.`", "0.`", 
      RowBox[{"-", "2.5`"}], "0.`", 
      RowBox[{"-", "1.5`"}]},
     {"0.`", "0.`", "0.`", "0.`", 
      RowBox[{"-", "2.5`"}], "0.`"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[
   SparseArray[
    Automatic, {6, 6}, 0., {
     1, {{0, 2, 5, 8, 11, 14, 16}, {{1}, {2}, {1}, {2}, {3}, {2}, {3}, {4}, {
       3}, {4}, {5}, {4}, {5}, {6}, {5}, {6}}}, {0., -1.5, -2.5, 
      0., -1.5, -2.5, 0., -1.5, -2.5, 0., -1.5, -2.5, 0., -1.5, -2.5, 
      0.}}]]]]], "Output",
 CellLabel->"Out[4]//MatrixForm=",
 CellID->643144695,ExpressionUUID->"2ceb41fd-18b9-4202-9e50-075b52f89404"]
}, Open  ]],

