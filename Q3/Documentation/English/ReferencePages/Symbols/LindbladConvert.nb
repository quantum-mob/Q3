Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LindbladConvert"]], "paclet:QuantumMob/Q3/ref/LindbladConvert",
     "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "da3e163f-6f4e-46bd-ae60-c4bdea0e0fdf"],
 " converts the Lindblad equation into the form\n\t",
 Cell[BoxData[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox[
         OverscriptBox["\[Rho]", "."], 
         StyleBox["i", "TI"]], "\[LongEqual]", 
        UnderoverscriptBox["\[Sum]", 
         RowBox[{
           StyleBox["j", "TI"], "\[LongEqual]", "1"}], 
         RowBox[{
           SuperscriptBox[
            StyleBox["n", "TI"], "2"], "-", "1"}], LimitsPositioning -> True], 
        SubscriptBox[
         StyleBox["M", "TI"], 
         RowBox[{
           StyleBox["i", "TI"], 
           StyleBox["j", "TI"]}]], 
        SubscriptBox["\[Rho]", 
         StyleBox["j", "TI"]], "+", 
        SubscriptBox[
         StyleBox["v", "TI"], 
         StyleBox["j", "TI"]], "  ", 
        RowBox[{"(", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1", ",", "\[Ellipsis]", ",", 
            SuperscriptBox[
             StyleBox["n", "TI"], "2"], "-", "1"}], ")"}]}], TraditionalForm],
     "errors" -> {}, "input" -> 
    "\\dot\\rho_i=\\sum_{j=1}^{n^2-1}M_{ij}\\rho_j+v_j \\quad \
(i=1,\\dots,n^2-1)", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"]], "Input",ExpressionUUID->
  "90c6e1a8-3bf2-4c92-a79f-efb4d8f29779"],
 ",\nwhere the density operator is represented in the Lie basis, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         RowBox[{
           SubscriptBox[
            StyleBox["B", "TI"], 
            StyleBox["j", "TI"]], ":", 
           StyleBox["j", "TI"], "\[LongEqual]", "1", ",", "2", ",", 
           "\[Ellipsis]", ",", 
           SuperscriptBox[
            StyleBox["n", "TI"], "2"], "-", "1"}], "}"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\{B_j:j=1,2,\\dots,n^2-1\\}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4d0f7cc1-3859-4ab4-bba0-4d2aca3ab218"],
 ", as\n\t",
 Cell[BoxData[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{"\[Rho]", "\[LongEqual]", 
        FractionBox["1", 
         StyleBox["n", "TI"]], 
        StyleBox["I", "TI"], "+", 
        UnderoverscriptBox["\[Sum]", 
         RowBox[{
           StyleBox["j", "TI"], "\[LongEqual]", "1"}], 
         RowBox[{
           SuperscriptBox[
            StyleBox["n", "TI"], "2"], "-", "1"}], LimitsPositioning -> True], 
        SubscriptBox[
         StyleBox["B", "TI"], 
         StyleBox["j", "TI"]], 
        SubscriptBox["\[Rho]", 
         StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
    "\\rho=\\frac{1}{n}I+\\sum_{j=1}^{n^2-1}B_j\\rho_j", "state" -> "Boxes"|>,
   
   "TeXAssistantTemplate"]], "Input",ExpressionUUID->
  "1d82f74f-de6e-4948-be4f-38458c4f6584"],
 " ."
}], "Notes",
 CellID->1292051031,ExpressionUUID->"69b55b41-292d-46b4-ac52-2be16e484c52"],

Cell[TextData[{
 "The solution of the Lindblad equation is given by\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Rho]", 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], "\[LongEqual]", 
         UnderscriptBox["\[Sum]", 
          StyleBox["j", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          RowBox[{"[", 
            SuperscriptBox[
             StyleBox["e", "TI"], 
             RowBox[{
               StyleBox["M", "TI"], 
               StyleBox["t", "TI"]}]], "]"}], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], 
         SubscriptBox["\[Rho]", 
          StyleBox["j", "TI"]], 
         RowBox[{"(", "0", ")"}], "+", 
         UnderscriptBox["\[Sum]", 
          StyleBox["j", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          RowBox[{"[", 
            RowBox[{
              SubsuperscriptBox["\[Integral]", "0", 
               StyleBox["t", "TI"]], 
              RowBox[{
                StyleBox["d", "TI"], 
                StyleBox["s", "TI"]}], " ", 
              SuperscriptBox[
               StyleBox["e", "TI"], 
               RowBox[{
                 StyleBox["M", "TI"], 
                 StyleBox["s", "TI"]}]]}], "]"}], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], 
         SubscriptBox[
          StyleBox["v", "TI"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho_i(t)=\\sum_j[e^{Mt}]_{ij}\\rho_j(0)+\\sum_j\\left[\\int_0^t{ds}\\,\
e^{Ms}\\right]_{ij}v_j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "506a45f6-e4dc-4e08-a5ea-0225de59bbf1"],
 "."
}], "Notes",
 CellID->421100671,ExpressionUUID->"94c0aeda-6233-472c-8f69-f1c52e5e44fa"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LindbladConvert"]], "paclet:QuantumMob/Q3/ref/LindbladConvert",
     "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "07e40e02-2a7f-4559-8f9a-d845af4f19d1"],
 " returns ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["n", "2"], "-", "1"}], ")"}], "\[Times]", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["n", "2"], "-", "1"}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"e8a8f5bb-eb7d-4885-8fbb-419a4e07acfd"],
 " matrix and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["n", "2"], "-", "1"}], ")"}], TraditionalForm]],
  ExpressionUUID->"9f665500-3aa4-4c5f-8fae-67c21fbeb2ce"],
 "-component column vector, where ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c0ca0bd1-310f-40ca-8b0b-d7666eb33357"],
 " is the Hilbert-space dimension of the system."
}], "Notes",
 CellID->1313509585,ExpressionUUID->"79f2eff1-b036-4d79-b70c-2001a09b4eb9"]
}, Closed]],

