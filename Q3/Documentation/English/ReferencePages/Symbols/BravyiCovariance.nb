Cell[TextData[{
 "More explicitly,\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", "=", 
    RowBox[{
     RowBox[{"\[ImaginaryI]", "\[VeryThinSpace]", 
      RowBox[{"M", "(", 
       RowBox[{"G", "-", 
        RowBox[{
         FractionBox["1", "2"], "I"}]}], ")"}], 
      SuperscriptBox["M", "\[Dagger]"]}], "=", 
     RowBox[{
      RowBox[{"\[ImaginaryI]", "(", GridBox[{
         {"1", "1"},
         {
          RowBox[{"-", "\[ImaginaryI]", "\[VeryThinSpace]"}], 
          RowBox[{"\[ImaginaryI]", "\[VeryThinSpace]"}]}
        }], ")"}], 
      RowBox[{"(", GridBox[{
         {
          RowBox[{"g", "-", 
           FractionBox["1", "2"]}], "f"},
         {
          SuperscriptBox["f", "\[Dagger]"], 
          RowBox[{
           FractionBox["1", "2"], "-", 
           SuperscriptBox["g", "T"]}]}
        }], ")"}], 
      RowBox[{"(", GridBox[{
         {"1", 
          RowBox[{"\[ImaginaryI]", "\[VeryThinSpace]"}]},
         {"1", 
          RowBox[{"-", "\[ImaginaryI]", "\[VeryThinSpace]"}]}
        }], ")"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "423d37b5-d60d-4759-8215-3b220a16dd13"],
