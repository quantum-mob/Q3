Cell[BoxData[GridBox[{
   {"", Cell[TextData[{
     Cell[BoxData[
      RowBox[{
       TemplateBox[{
         Cell[
          TextData["WickLindbladian"]], 
         "paclet:QuantumMob/Q3/ref/WickLindbladian", 
         "QuantumMob Package Symbol"},
        "PackageLink",
        BaseStyle->"InlineFormula"], "[", 
       RowBox[{
        StyleBox["ham", "TI"], ",", 
        StyleBox["jmp", "TI"]}], "]"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "fc865f03-005b-44e4-bea2-defaa3db1bd5"],
     "\[LineSeparator]returns ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{
        StyleBox["off", "TI"], ",", 
        StyleBox["eff", "TI"], ",", 
        StyleBox["bob", "TI"]}], "}"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "d4a5fe2f-54c0-4ee9-b0e0-3b278a75f975"],
     " describing the Lindblad equation for the single-particle Green's \
function matrix, ",
     Cell[BoxData[
      FormBox[
       RowBox[{
        OverscriptBox["g", "."], "=", 
        RowBox[{
         StyleBox["off",
          FontSlant->"Italic"], "-", 
         RowBox[{"\[ImaginaryI]", "(", 
          RowBox[{
           RowBox[{
            StyleBox["eff",
             FontSlant->"Italic"], ".", "g"}], "-", 
           RowBox[{"g", ".", 
            SuperscriptBox[
             StyleBox["eff",
              FontSlant->"Italic"], "\[Dagger]"]}]}], ")"}], "+", 
         RowBox[{
          SubscriptBox["\[CapitalSigma]", "\[Mu]"], 
          RowBox[{
           SubscriptBox[
            StyleBox["bob",
             FontSlant->"Italic"], "\[Mu]"], ".", "g", ".", 
           SubscriptBox[
            StyleBox["bob",
             FontSlant->"Italic"], "\[Mu]"]}]}]}]}], TraditionalForm]],
      ExpressionUUID->"763589c2-9981-48eb-b977-17f7ba142158"],
     ", associated with the Hamiltonian ",
     Cell[BoxData[
      StyleBox["ham", "TI"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "d8b48367-9c95-42b6-bb33-4e4246ae81aa"],
     " (either ",
     Cell[BoxData[
      RowBox[{
       StyleBox["n", "TI"], "\[Times]", 
       StyleBox["n", "TI"]}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "a5afdf9a-66f9-448c-8112-2da863b3894a"],
     " matrix or ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["WickHermitian"]], "paclet:QuantumMob/Q3/ref/WickHermitian",
         "QuantumMob Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "6febacab-c499-4f80-942b-67f1bb1d2bed"],
     ") and a set of quantum jump operators ",
     Cell[BoxData[
      StyleBox["jmp", "TI"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "1a796284-a4b5-4273-a844-d1ed66009112"],
     " (",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["WickJump"]], "paclet:QuantumMob/Q3/ref/WickJump", 
        "QuantumMob Package Symbol"},
       "PackageLink",
