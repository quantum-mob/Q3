Cell[TextData[{
 "Consider the number-conserving Lindblad equation for fermionic Gaussian \
state ",
 Cell[BoxData[
  FormBox["\[Rho]", TraditionalForm]],ExpressionUUID->
  "c3dc646f-1df3-4a2b-8c76-cf376c102bc2"],
 ":\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"d", "\[VeryThinSpace]", "\[Rho]"}], 
     RowBox[{"d", "\[VeryThinSpace]", "t"}]], "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"[", 
       RowBox[{"H", ",", "\[Rho]"}], "]"}]}], "+", 
     RowBox[{
      SubscriptBox["\[CapitalSigma]", "\[Mu]"], 
      SubscriptBox["L", "\[Mu]"], "\[Rho]", " ", 
      SubsuperscriptBox["L", "\[Mu]", "\[Dagger]"]}]}]}], TraditionalForm]],
  ExpressionUUID->"6cd359e6-a605-4b73-9c54-fe5483c32cc2"],
 " ,\[LineSeparator]where the Lindblad operator ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "ff324d9b-e7e7-4282-94c4-ce1d9f8f16de"],
 " takes one of the following forms:\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "042c6705-90fa-4ed2-8b03-8858678ee0c3"],
 " ,    ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["b", "\[Mu]", "\[Dagger]"], TraditionalForm]],
  ExpressionUUID->"9a312298-6e16-4b85-8fef-c2fefca3c3cb"],
 " ,    ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["b", "\[Mu]", "\[Dagger]"], 
    SubscriptBox["b", "\[Mu]"]}], TraditionalForm]],ExpressionUUID->
  "77a9b051-5417-466c-ba57-bd9b17463637"],
 " ,    ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["b", "\[Mu]"], 
    SubsuperscriptBox["b", "\[Mu]", "\[Dagger]"]}], TraditionalForm]],
  ExpressionUUID->"e0e6c437-bdf8-4686-9fb4-d79597a63094"],
 " .\[LineSeparator]Here, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["b", "\[Mu]"], ":=", 
    RowBox[{
     SubscriptBox["\[CapitalSigma]", "i"], 
     SubscriptBox["w", 
      RowBox[{"\[Mu]", ",", "i"}]], 
     SubscriptBox["c", "i"]}]}], TraditionalForm]],ExpressionUUID->
  "5e4cd6c7-43bc-4c25-83ce-6467fa53cbda"],
 " is the (unnormalized) dressed Dirac fermion mode:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["b", "\[Mu]"], ",", 
      SubsuperscriptBox["b", "\[Mu]", "\[Dagger]"]}], "}"}], ":=", 
    SuperscriptBox[
     RowBox[{"\[LeftDoubleBracketingBar]", 
      SubscriptBox["w", "\[Mu]"], "\[RightDoubleBracketingBar]"}], "2"]}], 
   TraditionalForm]],ExpressionUUID->"d60a4a9e-a951-43a3-a4e0-633e77a88dd8"],
 "\[LineSeparator]and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["w", "\[Mu]"], ":=", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["w", 
       RowBox[{"\[Mu]", ",", "1"}]], ",", 
      SubscriptBox["w", 
       RowBox[{"\[Mu]", ",", "2"}]], ",", "\[Ellipsis]", ",", 
      SubscriptBox["w", 
       RowBox[{"\[Mu]", ",", "n"}]]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"baccf99f-f9e0-414b-8fb0-74597dea33ca"],
 " is regarded as a ",
 StyleBox["row",
  FontSlant->"Italic"],
 " vector."
}], "Notes",
 CellID->683617233,ExpressionUUID->"f5f1a546-e474-427b-86e5-e9b3dd39382c"],

Cell[TextData[{
 "The Green\[CloseCurlyQuote]s function matrix satisfies the matrix of the \
form\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"d", "\[VeryThinSpace]", "G"}], 
     RowBox[{"d", "\[VeryThinSpace]", "t"}]], "=", 
    RowBox[{"C", "-", 
     RowBox[{"\[ImaginaryI]", "(", 
      RowBox[{
       RowBox[{
        SubscriptBox["H", "eff"], "G"}], "-", 
       RowBox[{"G", "\[VeryThinSpace]", 
        SubsuperscriptBox["H", "eff", "\[Dagger]"]}]}], ")"}], "+", 
     RowBox[{
      SubscriptBox["\[CapitalSigma]", "\[Mu]"], 
      SubscriptBox["M", "\[Mu]"], "G", " ", 
      SubscriptBox["M", "\[Mu]"]}]}]}], TraditionalForm]],ExpressionUUID->
  "ad0d6969-6769-407b-96d4-75cf0f824558"],
 " ,\nwhere ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["M", "\[Mu]"], ":=", 
    RowBox[{
     SubsuperscriptBox["w", "\[Mu]", "\[Dagger]"], 
     SubscriptBox["w", "\[Mu]"]}]}], TraditionalForm]],ExpressionUUID->
  "5b0db2a6-6b81-4d4f-8bb7-2770c5ce251b"],
 " is the dyadic product (hence an ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "\[Times]", "n"}], TraditionalForm]],ExpressionUUID->
  "69d73127-dd57-41ad-ae97-df4b6d0ff052"],
 " matrix) of column vector ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["w", "\[Mu]", "\[Dagger]"], TraditionalForm]],
  ExpressionUUID->"ce1ca49f-d45e-433b-9fbe-7b51c41941da"],
 " and row vector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "82921e27-6a73-4efd-8217-e4c2f9f3913d"],
 ". The inhomogeneous term is given by\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", ":=", 
    RowBox[{
     SubsuperscriptBox["\[CapitalSigma]", "\[Mu]", 
      RowBox[{"(", "1", ")"}]], 
     SubscriptBox["M", "\[Mu]"]}]}], TraditionalForm]],ExpressionUUID->
  "da15505a-f9ea-4635-8625-3a0d2a04d0eb"],
 " ,\nwhere summation ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalSigma]", "\[Mu]", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "b2b947f0-3066-4907-88ca-720c27c99cde"],
 " is over the Lindblad operators of form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "\[Mu]"], "=", 
    SubscriptBox["b", "\[Mu]"]}], TraditionalForm]],ExpressionUUID->
  "fa4f8776-09bd-48e1-a127-032d1723af45"],
 " (i.e., a linear superposition of annihilators). The effective Hamiltonian \
matrix is given by\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["H", "eff"], ":=", 
    RowBox[{"H", "-", 
     RowBox[{
      FractionBox["\[ImaginaryI]", "2"], 
      SubsuperscriptBox["\[CapitalSigma]", "\[Mu]", 
       RowBox[{"(", "2", ")"}]], 
      SubscriptBox["M", "\[Mu]"]}], "-", 
     RowBox[{
      FractionBox["\[ImaginaryI]", "2"], 
      SubsuperscriptBox["\[CapitalSigma]", "\[Mu]", 
       RowBox[{"(", "3", ")"}]], 
      SubsuperscriptBox["M", "\[Mu]", "2"]}]}]}], TraditionalForm]],
  ExpressionUUID->"fd31f1bc-25b2-4186-9a62-702f1e3994ba"],
 " ,\nwhere ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalSigma]", "\[Mu]", 
    RowBox[{"(", "2", ")"}]], TraditionalForm]],ExpressionUUID->
  "e498d338-5199-4487-bf82-cca5f58ace6a"],
 " is the summation over the Lindblad operators of form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "\[Mu]"], "=", 
    SubscriptBox["b", "\[Mu]"]}], TraditionalForm]],ExpressionUUID->
  "800f397a-de33-4f87-b656-44d5f7a37333"],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "\[Mu]"], "=", 
    SubsuperscriptBox["b", "\[Mu]", "\[Dagger]"]}], TraditionalForm]],
