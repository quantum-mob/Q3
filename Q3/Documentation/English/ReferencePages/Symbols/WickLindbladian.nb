Cell[TextData[{
 "Consider the number-conserving Lindblad equation for fermionic Gaussian \
state ",
 Cell[BoxData[
  FormBox["\[Rho]", TraditionalForm]],ExpressionUUID->
  "2705c475-aa96-4b5d-bb93-35b73d7da07d"],
 ",\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"d", "\[VeryThinSpace]", "\[Rho]"}], 
     RowBox[{"d", "\[VeryThinSpace]", "t"}]], "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"[", 
       RowBox[{"H", ",", "\[Rho]"}], "]"}]}], "+", 
     RowBox[{
      SubscriptBox["\[CapitalSigma]", "\[Mu]"], 
      SubscriptBox["L", "\[Mu]"], "\[Rho]", " ", 
      SubsuperscriptBox["L", "\[Mu]", "\[Dagger]"]}]}]}], TraditionalForm]],
  ExpressionUUID->"36bac351-861b-4000-83a1-bfdd7096e8fc"],
 " ,\[LineSeparator]where the Hamiltonian ",
 Cell[BoxData[
  FormBox["H", TraditionalForm]],ExpressionUUID->
  "c132e1ed-55b1-434d-954d-a70ad1e8f3c8"],
 " is a bilinear combination\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"H", ":=", 
    RowBox[{
     SubscriptBox["\[CapitalSigma]", 
      RowBox[{"i", "\[VeryThinSpace]", "j"}]], 
     SubsuperscriptBox["c", "i", "\[Dagger]"], 
     SubscriptBox["h", 
      RowBox[{"i", "\[VeryThinSpace]", "j"}]], 
     SubscriptBox["c", "j"]}]}], TraditionalForm]],ExpressionUUID->
  "47cfcf7b-0c21-485d-8494-79760ccfc2a6"],
 "\[LineSeparator]of bare Dirac fermion modes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "i"], TraditionalForm]],ExpressionUUID->
  "4e5f47b8-74b6-4713-9525-597f5c32d3e9"],
 " and\[LineSeparator]the Lindblad operator ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "bf998c7a-2ffc-4cbc-a4ca-d84930ad359c"],
 " takes one of the following forms:\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "ee3f2d54-5fb6-48f6-b842-e7a3360641bd"],
 " ,    ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["b", "\[Mu]", "\[Dagger]"], TraditionalForm]],
  ExpressionUUID->"dcdccd36-8df3-4403-bf44-09d442c0e0ce"],
 " ,    ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["b", "\[Mu]", "\[Dagger]"], 
    SubscriptBox["b", "\[Mu]"]}], TraditionalForm]],ExpressionUUID->
  "980c6f2f-5be7-4fb7-b899-a51c3be77c37"],
 " ,    ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["b", "\[Mu]"], 
    SubsuperscriptBox["b", "\[Mu]", "\[Dagger]"]}], TraditionalForm]],
  ExpressionUUID->"2088da9e-a0b2-42d3-9165-6e8ddf493a82"],
 " .\[LineSeparator]Here, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["b", "\[Mu]"], ":=", 
    RowBox[{
     SubscriptBox["\[CapitalSigma]", "i"], 
     SubscriptBox["w", 
      RowBox[{"\[Mu]", ",", "i"}]], 
     SubscriptBox["c", "i"]}]}], TraditionalForm]],ExpressionUUID->
  "994e9cc5-e8dc-4c90-9e5b-3b5b0d1fce9b"],
 " is the (unnormalized) dressed Dirac fermion mode:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["b", "\[Mu]"], ",", 
      SubsuperscriptBox["b", "\[Mu]", "\[Dagger]"]}], "}"}], ":=", 
    SuperscriptBox[
     RowBox[{"\[LeftDoubleBracketingBar]", 
      SubscriptBox["w", "\[Mu]"], "\[RightDoubleBracketingBar]"}], "2"]}], 
   TraditionalForm]],ExpressionUUID->"079618e5-4a26-469b-b751-ed895d1ac028"],
 "\[LineSeparator]and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["w", "\[Mu]"], ":=", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["w", 
       RowBox[{"\[Mu]", ",", "1"}]], ",", 
      SubscriptBox["w", 
       RowBox[{"\[Mu]", ",", "2"}]], ",", "\[Ellipsis]", ",", 
      SubscriptBox["w", 
       RowBox[{"\[Mu]", ",", "n"}]]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"3b7f6dba-dda8-4ff8-92c9-946bf3032522"],
 " is regarded as a ",
 StyleBox["row",
  FontSlant->"Italic"],
 " vector."
}], "Notes",
 CellID->683617233,ExpressionUUID->"c4bafc5a-3c9b-4dad-9606-98bb925b6297"],

Cell[TextData[{
 "The Green\[CloseCurlyQuote]s function matrix, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", 
     RowBox[{"i", "\[VeryThinSpace]", "j"}]], ":=", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox["c", "i"], 
      SubsuperscriptBox["c", "j", "\[Dagger]"]}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]],ExpressionUUID->"4d2431d5-939a-4606-9d15-c148522f9356"],
 ", satisfies\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"d", "\[VeryThinSpace]", "g"}], 
     RowBox[{"d", "\[VeryThinSpace]", "t"}]], "=", 
    RowBox[{
     SubscriptBox["c", "off"], "-", 
     RowBox[{"\[ImaginaryI]", "(", 
      RowBox[{
       RowBox[{
        SubscriptBox["h", "eff"], "g"}], "-", 
       RowBox[{"g", "\[VeryThinSpace]", 
        SubsuperscriptBox["h", "eff", "\[Dagger]"]}]}], ")"}], "+", 
     RowBox[{
      SubscriptBox["\[CapitalSigma]", "\[Mu]"], 
      SubscriptBox["m", "\[Mu]"], "g", " ", 
      SubscriptBox["m", "\[Mu]"]}]}]}], TraditionalForm]],ExpressionUUID->
  "966a766c-025a-4092-a97c-66e4e3d91af6"],
 " ,\nwhere ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["m", "\[Mu]"], ":=", 
    RowBox[{
     SubsuperscriptBox["w", "\[Mu]", "\[Dagger]"], 
     SubscriptBox["w", "\[Mu]"]}]}], TraditionalForm]],ExpressionUUID->
  "ece35b72-e2e9-4304-be93-5560a155b9bd"],
 " is the product of column vector ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["w", "\[Mu]", "\[Dagger]"], TraditionalForm]],
  ExpressionUUID->"e2d63de5-792e-4767-a60c-b3f988a97961"],
 " and row vector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "7d92f316-d179-4423-915d-876e3294602f"],
 " and is an ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "\[Times]", "n"}], TraditionalForm]],ExpressionUUID->
  "eb63c876-8017-4424-8173-a6a2be4ad57b"],
 " dyadic matrix of rank one. The inhomogeneous term is given by\
\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "off"], ":=", 
    RowBox[{
     SubsuperscriptBox["\[CapitalSigma]", "\[Mu]", 
      RowBox[{"(", "1", ")"}]], 
     SubscriptBox["m", "\[Mu]"]}]}], TraditionalForm]],ExpressionUUID->
  "5931a0bd-a1a2-4569-b581-e4a4995eed4f"],
 " ,\nwhere summation ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalSigma]", "\[Mu]", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "84119319-7a49-4ba0-a343-530f763240a3"],
 " is over the Lindblad operators of form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "\[Mu]"], "=", 
    SubscriptBox["b", "\[Mu]"]}], TraditionalForm]],ExpressionUUID->
  "9e510f7b-9b18-4eb8-871d-7193b9aa7ebd"],
 " (i.e., annihilators). The effective Hamiltonian matrix is given by\
\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", "eff"], ":=", 
    RowBox[{"h", "-", 
     RowBox[{
      FractionBox["\[ImaginaryI]", "2"], 
      SubsuperscriptBox["\[CapitalSigma]", "\[Mu]", 
       RowBox[{"(", "2", ")"}]], 
      SubscriptBox["m", "\[Mu]"]}], "-", 
     RowBox[{
      FractionBox["\[ImaginaryI]", "2"], 
      SubsuperscriptBox["\[CapitalSigma]", "\[Mu]", 
       RowBox[{"(", "3", ")"}]], 
      SubsuperscriptBox["m", "\[Mu]", "2"]}]}]}], TraditionalForm]],
  ExpressionUUID->"5e0dc40f-5d20-4548-b1e5-6ea7e2dfec7f"],
 " ,\nwhere ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalSigma]", "\[Mu]", 
    RowBox[{"(", "2", ")"}]], TraditionalForm]],ExpressionUUID->
  "45d2f91b-0b61-477f-a32d-5e53e4ca5b87"],
 " is the summation over the Lindblad operators of form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "\[Mu]"], "=", 
    SubscriptBox["b", "\[Mu]"]}], TraditionalForm]],ExpressionUUID->
  "d98b614e-15bc-4407-8149-1b6d9984af93"],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "\[Mu]"], "=", 
    SubsuperscriptBox["b", "\[Mu]", "\[Dagger]"]}], TraditionalForm]],
  ExpressionUUID->"c9ab3a89-d0f2-49aa-9ee1-e9f3bb7360ba"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalSigma]", "\[Mu]", 
    RowBox[{"(", "3", ")"}]], TraditionalForm]],ExpressionUUID->
  "369e1d91-f9bc-4a6c-81b4-73b46142583f"],
 " is over the Lindblad operators of form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "\[Mu]"], "=", 
    RowBox[{
     SubsuperscriptBox["b", "\[Mu]", "\[Dagger]"], 
     SubscriptBox["b", "\[Mu]"]}]}], TraditionalForm]],ExpressionUUID->
  "f459f17d-c5fc-4522-86f3-7ec05deb2514"],
 "  or  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "\[Mu]"], "=", 
    RowBox[{
     SubscriptBox["b", "\[Mu]"], 
     SubsuperscriptBox["b", "\[Mu]", "\[Dagger]"]}]}], TraditionalForm]],
  ExpressionUUID->"d22137d1-a9d1-47fd-9ba8-aebd725431bd"],
 " ."
}], "Notes",
 CellID->943872783,ExpressionUUID->"d3405b93-28c9-4826-b953-22b1bbd22538"]
}, Closed]],

