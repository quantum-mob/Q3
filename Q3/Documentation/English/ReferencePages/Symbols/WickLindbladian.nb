      FontFamily->"Source Sans Pro",ExpressionUUID->
      "2162d99d-f31d-44d1-b7e4-d8969ef5ae4c"],
     ")."
    }],ExpressionUUID->"638e1053-923a-457c-b2ae-3e9ee04c8bc2"]}
  }]], "Usage",
 CellID->2123630739,ExpressionUUID->"d22a1cb6-1935-4ede-b42d-f3e1497b5a1c"]
}, Open  ]],

