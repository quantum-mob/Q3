Cell[BoxData[GridBox[{
   {"", Cell[TextData[{
     Cell[BoxData[
      RowBox[{
       TemplateBox[{
         Cell[
          TextData["WickLindbladian"]], 
         "paclet:QuantumMob/Q3/ref/WickLindbladian", 
         "QuantumMob Package Symbol"},
        "PackageLink",
        BaseStyle->"InlineFormula"], "[", 
       RowBox[{
        StyleBox["ham", "TI"], ",", 
        StyleBox["jmp", "TI"]}], "]"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "40af17dc-2713-440b-a5a1-defcaa45303f"],
     "\[LineSeparator]returns ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{
        StyleBox["off", "TI"], ",", 
        StyleBox["eff", "TI"], ",", 
        StyleBox["bob", "TI"]}], "}"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "a0060851-dec8-4339-9b3a-27c6b8c6994c"],
     " describing the Lindblad equation for the single-particle Green's \
function matrix, ",
     Cell[BoxData[
      FormBox[
       RowBox[{
        OverscriptBox["g", "."], "=", 
        RowBox[{
         StyleBox["off",
          FontSlant->"Italic"], "-", 
         RowBox[{"\[ImaginaryI]", "(", 
          RowBox[{
           RowBox[{
            StyleBox["eff",
             FontSlant->"Italic"], ".", "g"}], "-", 
           RowBox[{"g", ".", 
            SuperscriptBox[
             StyleBox["eff",
              FontSlant->"Italic"], "\[Dagger]"]}]}], ")"}], "+", 
         RowBox[{
          SubscriptBox["\[CapitalSigma]", "\[Mu]"], 
          RowBox[{
           SubscriptBox[
            StyleBox["bob",
             FontSlant->"Italic"], "\[Mu]"], ".", "g", ".", 
           SubscriptBox[
            StyleBox["bob",
             FontSlant->"Italic"], "\[Mu]"]}]}]}]}], TraditionalForm]],
      ExpressionUUID->"90855209-9edf-40ec-a600-b59f31a97d7d"],
     ", associated with the Hamiltonian ",
     Cell[BoxData[
      StyleBox["ham", "TI"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "1aa330eb-e512-44c2-a3c8-b84f79fa7bc7"],
     " (either ",
     Cell[BoxData[
      RowBox[{
       StyleBox["n", "TI"], "\[Times]", 
       StyleBox["n", "TI"]}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "a214db3b-83de-4ff2-8a86-e1849c9e1639"],
     " matrix or ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["WickHermitian"]], "paclet:QuantumMob/Q3/ref/WickHermitian",
         "QuantumMob Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "f6368bc6-7b31-4438-8246-7d0f66af6429"],
     ") and a set of quantum jump operators ",
     Cell[BoxData[
      StyleBox["jmp", "TI"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "a19d4dd7-7907-45f2-bd94-1ebe426588b5"],
     " (",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["WickJump"]], "paclet:QuantumMob/Q3/ref/WickJump", 
        "QuantumMob Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "bd490991-1105-4882-8b21-1311cc820dd9"],
     ")."
    }],ExpressionUUID->"93bfa4ea-feb8-4a31-a717-b50b93d91af5"]}
  }]], "Usage",
 CellID->2123630739,ExpressionUUID->"0cac2720-10e6-46c4-b521-c0d2e98af854"]
}, Open  ]],

