Cell["\<\
Construct a singular skew-symmetric matrix with prescribed singular value \
pairs (including zeros) from A = Conjugate[V] . N0 . ConjugateTranspose[V] \
with a random unitary V:\
\>", "ExampleText",
 CellID->670745623,ExpressionUUID->"fead219a-2cc0-429b-bf79-a3945057c437"],

Cell["\<\
m = 5; 
n = 2 m;
valTrue = {3., 1.5, 0.7, 1.*10^-15, 0.};\
\>", "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[1]:=",
 CellID->1080022658,ExpressionUUID->"21c2bed5-1500-4a89-a18a-11b632bab899"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "11", "]"}], ";"}]], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[2]:=",
 CellID->1232067152,ExpressionUUID->"c3552a84-9d5e-4a52-95cc-af315a49376d"],

