Cell[TextData[{
 "Singular values smaller than \"Tolerance\" (default ",
 Cell[BoxData[
  SuperscriptBox["10", 
   RowBox[{"-", "8"}]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7ac60126-8672-49ab-a10d-e28740905ff5"],
 ") are treated as zero and discarded in pairs, so that the skew-symmetric \
structure of the pseudoinverse is retained. "
}], "Notes",
 CellID->190253929,ExpressionUUID->"db162170-651e-49ac-88fe-f46705c24d84"],

