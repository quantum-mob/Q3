Cell["\<\
The two smallest singular value pairs are zero to machine precision. Solve A \
. x == b in the least-square sense, reusing the decomposition; singular \
values below eps = 10.^-8 are discarded in pairs:\
\>", "ExampleText",
 CellID->1240866065,ExpressionUUID->"dc0d44ed-043a-4b2e-9355-8a020f731b44"],

Cell[CellGroupData[{

Cell["\<\
b = RandomVector[n];
x = SkewJacobiSolve[{val, U}, b, \"Threshold\"->10.^-8];
x//ArrayShort\
\>", "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[6]:=",
 CellID->1022258438,ExpressionUUID->"d05ca8ba-f729-4550-ac09-2923d75b7fc3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "0.06799271143000622`"}], "+", 
    RowBox[{"0.07436537504251986`", " ", "\[ImaginaryI]"}]}], ",", 
   RowBox[{
    RowBox[{"-", "0.08227747293751975`"}], "-", 
    RowBox[{"0.34708558974025194`", " ", "\[ImaginaryI]"}]}], ",", 
   RowBox[{"0.14310932990365557`", "\[VeryThinSpace]", "+", 
    RowBox[{"0.23788288447482892`", " ", "\[ImaginaryI]"}]}], ",", 
   RowBox[{"0.22366966807577743`", "\[VeryThinSpace]", "+", 
    RowBox[{"0.09249382547710025`", " ", "\[ImaginaryI]"}]}], 
   ",", "\<\"\[Ellipsis]\"\>"}], "}"}]], "Output",
 CellLabel->"Out[6]=",
 CellID->1130301826,ExpressionUUID->"d18fd225-7146-401e-905e-110724c361ba"]
}, Open  ]],

