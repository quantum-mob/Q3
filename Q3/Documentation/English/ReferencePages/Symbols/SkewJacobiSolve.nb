 CellLabel->"In[7]:=",
 CellID->1325803050,ExpressionUUID->"9fefe211-9b9e-4465-bae4-d4c28b826f81"],

Cell[BoxData["1.3261969482947918`*^-15"], "Output",
 CellLabel->"Out[7]=",
 CellID->342448220,ExpressionUUID->"6ab40f01-a9da-45c5-b966-8cca7a02e1c4"]
}, Open  ]],

Cell[TextData[{
 "The comparison with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PseudoInverse"]], "paclet:ref/PseudoInverse"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c32afb9c-a708-424d-9239-f88519c632ff"],
 " is illustrative: note that the Tolerance option of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PseudoInverse"]], "paclet:ref/PseudoInverse"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "36b497ec-39ca-482d-8040-67ed6f2d0f3c"],
 " is relative to the largest singular value, whereas \"Threshold\" in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SkewJacobiSolve"]], "paclet:QuantumMob/Q3/ref/SkewJacobiSolve",
     "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8e76b967-24f8-4a78-af75-28e5915808ef"],
 " is an absolute threshold, so the two agree here only because the retained \
and discarded singular values are well separated. More importantly, when a \
degenerate pair of singular values straddles the threshold due to round-off, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PseudoInverse"]], "paclet:ref/PseudoInverse"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "76cd3588-8923-46a3-bace-d7527e5861e4"],
 " may discard only one member of the pair and thereby break the \
skew-symmetry of the pseudoinverse; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SkewJacobiSolve"]], "paclet:QuantumMob/Q3/ref/SkewJacobiSolve",
     "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "00752b74-5a49-4b03-afaa-ba4e26bb7941"],
 " always removes them in pairs. This is precisely the property required for \
stable TDVP propagation; see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Humeniuk and Mitric (2018)"]], 
    "https://doi.org/10.1016/j.cpc.2018.04.026"},
   "WebLink",
   BaseStyle->{"ExampleText"}]],ExpressionUUID->
  "257b9305-f943-4453-a9f9-d8c7e0fa5b1b"],
 "."
}], "ExampleText",
 CellID->1815070451,ExpressionUUID->"240c4a61-ff14-464a-bac5-31f49ed832b8"]
}, Open  ]]
}, Open  ]],

