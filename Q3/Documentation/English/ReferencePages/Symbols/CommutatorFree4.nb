Cell[TextData[{
 "As an example, we consider the Rabi oscillation, governed by the \
time-dependent Hamiltonian\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"H", "(", "t", ")"}], "=", 
    RowBox[{
     RowBox[{
      FractionBox["\[CapitalDelta]", "2"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"cos", "(", 
          RowBox[{"\[Omega]", "\[VeryThinSpace]", "t"}], ")"}], 
         SuperscriptBox["\[Sigma]", "x"]}], "+", 
        RowBox[{
         RowBox[{"sin", "(", 
          RowBox[{"\[Omega]", "\[VeryThinSpace]", "t"}], ")"}], 
         SuperscriptBox["\[Sigma]", "y"]}]}], ")"}]}], "+", 
     RowBox[{
      FractionBox["B", "2"], 
      SuperscriptBox["\[Sigma]", "z"]}]}]}], TraditionalForm]],ExpressionUUID->
  "05fb12cb-bb96-40fb-b0b0-880e7bfb8597"],
 " \[LineSeparator]with field rotating at angular frequence \[Omega]."
}], "ExampleText",
 CellID->54922489,ExpressionUUID->"0ad4b044-7796-41ce-9dd1-e16514f5c083"],

Cell["Set the system parameters, and construct the model:", "ExampleText",
 CellID->1130650370,ExpressionUUID->"cffe2e4a-0cc3-4150-b09b-0718fae19892"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Omega]", "=", 
   RowBox[{"2", "Pi"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"B", "[", "1", "]"}], "=", 
   RowBox[{"\[CapitalDelta]", "*", 
    RowBox[{"Cos", "[", 
     RowBox[{"\[Omega]", "*", "t"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"B", "[", "2", "]"}], "=", 
   RowBox[{"\[CapitalDelta]", "*", 
    RowBox[{"Sin", "[", 
     RowBox[{"\[Omega]", "*", "t"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"B", "[", "3", "]"}], "=", 
   RowBox[{"1.1", "\[Omega]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"HH", "[", "t_", "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"B", "[", "1", "]"}], "/", "2"}], "*", 
      RowBox[{"ThePauli", "[", "1", "]"}]}], "+", 
     RowBox[{
      RowBox[{
       RowBox[{"B", "[", "2", "]"}], "/", "2"}], "*", 
      RowBox[{"ThePauli", "[", "2", "]"}]}], "+", 
     RowBox[{
      RowBox[{
       RowBox[{"B", "[", "3", "]"}], "/", "2"}], "*", 
      RowBox[{"ThePauli", "[", "3", "]"}]}]}], "//", "Normal"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"HH", "[", "t", "]"}], "//", "MatrixForm"}]}], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[1]:=",
 CellID->155947334,ExpressionUUID->"2893e4a9-ccb8-4e1e-a439-dba50e524db0"],

