Cell[TextData[{
 "From the time-independent Hamiltonian in the rotating frame, get the full \
time-evolution operator, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"U", "(", "t", ")"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["R", "z"], "(", 
      RowBox[{"\[Omega]", "\[VeryThinSpace]", "t"}], ")"}], 
     RowBox[{
      SubscriptBox["U", "R"], "(", "t", ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"34d4b979-d3f3-4f0c-9450-f57ac8fc318d"],
 ":"
}], "ExampleText",
 CellID->898210223,ExpressionUUID->"1d5b3cd5-f4e6-4108-a71f-7418d8b50920"],

Cell[CellGroupData[{

