Cell[TextData[{
 "To get the exact solution, get the Hamiltonian\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["H", "R"], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SubsuperscriptBox["R", "z", "\[Dagger]"], "(", 
        RowBox[{"\[Omega]", " ", "t"}], ")"}], " ", 
       RowBox[{"H", "(", "t", ")"}], " ", 
       RowBox[{
        SubscriptBox["R", "z"], "(", 
        RowBox[{"\[Omega]", "\[VeryThinSpace]", "t"}], ")"}]}], "-", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["R", "z", "\[Dagger]"], "(", 
        RowBox[{"\[Omega]", "\[VeryThinSpace]", "t"}], ")"}], "\[ImaginaryI]",
        "\[VeryThinSpace]", 
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{
         SubscriptBox["R", "z"], "(", 
         RowBox[{"\[Omega]", "\[VeryThinSpace]", "t"}], ")"}]}]}]}], "=", 
     RowBox[{
      RowBox[{
       FractionBox["\[CapitalDelta]", "2"], 
       SuperscriptBox["\[Sigma]", "x"]}], "+", 
      RowBox[{
       FractionBox[
        RowBox[{"B", "-", "\[Omega]"}], "2"], 
       SuperscriptBox["\[Sigma]", "z"]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"11e59184-e285-4158-ab38-09237e9190e6"],
 "\[LineSeparator]in the rotating frame:"
}], "ExampleText",
 CellID->1285652313,ExpressionUUID->"94a5a8a5-3a0a-4c61-a22e-c6ee5ecf842b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"HR", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"ThePauli", "[", "1", "]"}], "*", 
      RowBox[{"\[CapitalDelta]", "/", "2"}]}], "+", 
     RowBox[{
      RowBox[{"ThePauli", "[", "3", "]"}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"B", "[", "3", "]"}], "-", "\[Omega]"}], ")"}], "/", 
       "2"}]}]}], "//", "Normal"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"HR", "//", "MatrixForm"}]}], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[2]:=",
 CellID->1186541537,ExpressionUUID->"d483bdd0-fb54-407c-bc68-3e782d135a6c"],

