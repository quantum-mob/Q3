 RowBox[{"init", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Pauli", "[", "0", "]"}], "/", "2"}], "+", 
   RowBox[{"Dot", "[", 
    RowBox[{
     RowBox[{"x", "@", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], ",", 
