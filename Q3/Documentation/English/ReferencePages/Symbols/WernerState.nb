Cell[TextData[{
 "A Werner state is a bipartite mixed state on the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["d", "2"], TraditionalForm]],ExpressionUUID->
  "9941216b-9ba6-4d51-ba7c-542f1699027f"],
 "-dimensional Hilbert space that is invariant under all global unitary \
transformation, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "\[CircleTimes]", "U"}], TraditionalForm]],ExpressionUUID->
  "e7986cae-7b3d-4307-b079-c834957fc5bf"],
 "; that is,\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"U", "\[CircleTimes]", "U"}], ")"}], "\[Rho]", " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["U", "\[Dagger]"], "\[CircleTimes]", 
       SuperscriptBox["U", "\[Dagger]"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"734ded9a-e551-4165-be85-2efa9023ab90"],
 "."
}], "Notes",
 CellID->1560445638,ExpressionUUID->"7422da26-362d-4cb1-b1c1-10f2506ffdd2"],

Cell["\<\
These states were first developed by Reinhard F. Werner in 1989.\
\>", "Notes",
 CellID->741708678,ExpressionUUID->"489860c4-2533-4edb-bfc9-5eb73f77ba89"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "2"}], TraditionalForm]],ExpressionUUID->
  "26b0c988-b180-4f95-81ea-c0278db19b78"],
 ", the Werner state may be written as\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "=", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"1", "-", "\[Lambda]"}], "4"], "I"}], "+", 
     RowBox[{"\[Lambda]", 
      TemplateBox[{
        SuperscriptBox["\[CapitalPsi]", "-"]},
       "Ket"], 
      TemplateBox[{
        SuperscriptBox["\[CapitalPsi]", "-"]},
       "Bra"]}]}]}], TraditionalForm]],ExpressionUUID->
  "de65cb74-b600-4333-ac5c-7f62e93d8595"],
 ",\[LineSeparator]where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"3", "-", 
       RowBox[{"4", "p"}]}], ")"}], "/", "3"}]}], TraditionalForm]],
  ExpressionUUID->"b561be2d-e06f-45c0-81ba-fbbc92f00f72"],
 " and\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      SuperscriptBox["\[CapitalPsi]", "-"]},
     "Ket"], ":=", 
    FractionBox[
     RowBox[{
      TemplateBox[{
        RowBox[{"[", "01", "]"}]},
       "Ket"], "-", 
      TemplateBox[{"10"},
       "Ket"]}], 
     SqrtBox["2"]]}], TraditionalForm]],ExpressionUUID->
  "b7ad15de-6f03-43e7-be64-b13dc9d08931"],
 "."
}], "Notes",
 CellID->1445123784,ExpressionUUID->"3add52af-ac3b-467d-a0c8-ab3ec2f4121b"]
}, Closed]],

