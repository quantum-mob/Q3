Cell[TextData[{
 "A Werner state is a bipartite mixed state on the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["d", "2"], TraditionalForm]],ExpressionUUID->
  "47b512b6-52de-45b6-b04e-7f316549aace"],
 "-dimensional Hilbert space that is invariant under all global unitary \
transformation, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "\[CircleTimes]", "U"}], TraditionalForm]],ExpressionUUID->
  "9f30ce02-a2a7-43a9-a100-7f4cc7dd241f"],
 "; that is,\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"U", "\[CircleTimes]", "U"}], ")"}], "\[Rho]", " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["U", "\[Dagger]"], "\[CircleTimes]", 
       SuperscriptBox["U", "\[Dagger]"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"71403506-866c-45b6-b3a3-bfa3e97898ff"],
 "."
}], "Notes",
 CellID->1560445638,ExpressionUUID->"7ce7dc0d-dbb6-469c-8d10-633e1b4a0324"],

Cell["\<\
These states were first developed by Reinhard F. Werner in 1989.\
\>", "Notes",
 CellID->741708678,ExpressionUUID->"be82846e-a43d-4910-8058-35fc57ff1849"],

Cell[TextData[{
 "The pseudo-Werner state of order ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "612bdad4-54d1-44d4-a2df-6d8f71d50ab8"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WernerState"]], "paclet:QuantumMob/Q3/ref/WernerState", 
     "QuantumMob Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", 
    StyleBox["d", "TI"], ",", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4876b76a-0bae-4400-b7cf-adba6c0bf000"],
 ", is defined by\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Rho]", "k"], ":=", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"1", "-", "\[Lambda]"}], 
       SuperscriptBox["d", "2"]], "I"}], "+", 
     RowBox[{"\[Lambda]", 
      TemplateBox[{
        SubscriptBox["GHZ", "k"]},
       "Ket"], 
      TemplateBox[{
        SubscriptBox["GHZ", "k"]},
       "Bra"]}]}]}], TraditionalForm]],ExpressionUUID->
  "9729bcf3-25ba-4cb0-af24-53046bb4e794"],
 ",\[LineSeparator]where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", ":=", 
    RowBox[{"1", "-", 
     RowBox[{
      SuperscriptBox["d", "2"], 
      RowBox[{"p", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"d", "^", "2"}], "-", "1"}], ")"}]}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"2c473f93-8a78-4b12-aaec-4c5954b040c6"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SubscriptBox["GHZ", "k"]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "fceab6c4-86db-49db-b37b-1939bbdbe160"],
 " is the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"k", "+", "1"}], ")"}], "th"], TraditionalForm]],ExpressionUUID->
  "e7c8006d-1d07-40a6-8df2-363001b2e78e"],
 " bipartite GHZ state."
}], "Notes",
 CellID->1314031322,ExpressionUUID->"803fea1c-5194-408f-b76c-68202f3773e6"],

Cell["WernerState[p,2,2] is a genuine Werner state.", "Notes",
 CellID->160513421,ExpressionUUID->"62e7580a-0f6f-4af2-ad79-c04728e3184b"]
}, Closed]],

