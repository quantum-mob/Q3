   "89a41aad-b301-47b9-85ae-c22c8dabc977"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->1941142044,ExpressionUUID->"90b5abbd-61db-41cd-9816-affc13421e6c"],

Cell["To verify the above result, solve the Lindblad equation:", "ExampleText",
 CellID->259242180,ExpressionUUID->"81352d04-b71a-42cd-b3ef-690ca5318f35"],

Cell[BoxData[
 RowBox[{
  RowBox[{"out", "=", 
   RowBox[{"BravyiLindbladSolve", "[", 
    RowBox[{"ham", ",", "jmp", ",", "in", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "$T", ",", 
       RowBox[{"4", "*", "$dt"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[1]:=",
 CellID->1986483144,ExpressionUUID->"7769d021-05f6-43e7-b5d8-3c53de78e775"],

Cell["\<\
Calculate the entanglement between the subsystem and the rest:\
\>", "ExampleText",
 CellID->2041424946,ExpressionUUID->"906c33c7-8faf-4060-8892-ad84b2991301"],

Cell[BoxData[
 RowBox[{
  RowBox[{"negSol", "=", 
   RowBox[{"BravyiLogarithmicNegativity", "[", 
    RowBox[{"out", ",", "sub"}], "]"}]}], ";"}]], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[2]:=",
 CellID->2030322950,ExpressionUUID->"6641aaf7-6c22-4a2e-b904-8b6d53bdbeb0"],

Cell["Compare the two results:", "ExampleText",
 CellID->371480877,ExpressionUUID->"efa0a3d4-07bc-4bc3-94c4-e5e082795994"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Re", "@", 
    RowBox[{"{", 
     RowBox[{"negSol", ",", "negRho"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"DataRange", "->", 
    RowBox[{"{", 
     RowBox[{"0", ",", "$T"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotMarkers", "->", 
