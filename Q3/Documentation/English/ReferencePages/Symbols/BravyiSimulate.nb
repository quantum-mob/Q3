Cell["Set the final time (in units of 1/\[Gamma]):", "ExampleText",
 CellID->147009777,ExpressionUUID->"754bfd56-4ae5-4533-a690-10fe0e378e52"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$T", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$dt", "=", 
   RowBox[{"$T", "/", "200."}]}], ";"}]}], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[8]:=",
 CellID->1336993214,ExpressionUUID->"e433c004-285a-4e8c-9d90-f51c59ca66f1"],

Cell["Do the Monte-Carlo simulation:", "ExampleText",
 CellID->1822149419,ExpressionUUID->"9af256bd-ae1a-4993-a4b8-194824d6bcc5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "452", "]"}], ";"}]], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[9]:=",
 CellID->1748478913,ExpressionUUID->"0b208872-728b-40b3-8c0c-37d2d7aeeaad"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"EchoTiming", "[", "\[IndentingNewLine]", 
   RowBox[{"data", "=", 
    RowBox[{"BravyiSimulate", "[", 
     RowBox[{"in", ",", "ham", ",", "jmp", ",", 
      RowBox[{"{", 
       RowBox[{"$T", ",", "$dt"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<Samples\>\"", "->", "100"}]}], "]"}]}], 
   "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Dimensions", "[", "data", "]"}]}], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[10]:=",
 CellID->2003320038,ExpressionUUID->"ab4d1d5f-25e0-48f1-9f2c-0ddff24a976e"],

Cell[BoxData["3.091476`"], "EchoTiming",
 CellID->1689372481,ExpressionUUID->"22b1e48e-3edd-4a36-ad65-2efc70de0b4c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"100", ",", "201"}], "}"}]], "Output",
 CellLabel->"Out[10]=",
 CellID->1401991180,ExpressionUUID->"3e208448-b4c8-46c0-b5e2-d72725357ca7"]
}, Open  ]],

