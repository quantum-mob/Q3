Cell["\<\
Let us now examine various entanglement properties. Take the first half of \
the fermion modes as a subsystem:\
\>", "ExampleText",
 CellID->478283074,ExpressionUUID->"a1287141-c40b-4875-a07f-2de599c36b27"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"kk", "=", 
  RowBox[{"Range", "[", 
   RowBox[{"$n", "/", "2"}], "]"}]}]], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[1]:=",
 CellID->1346002203,ExpressionUUID->"e1a059e8-dcd4-4e8c-8d9a-6fe4bb454d1a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->1358117803,ExpressionUUID->"af0feae5-f0fa-49a4-aa76-718cea2d1ae0"]
}, Open  ]],

Cell[TextData[{
 "Calculate the ",
 StyleBox["entanglement entropy",
  FontSlant->"Italic"],
 " (EE) between the subsystem and the rest:"
}], "ExampleText",
 CellID->2108780712,ExpressionUUID->"bd1d05d6-9285-4050-bf76-85756392f02b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"EchoTiming", "[", "\[IndentingNewLine]", 
   RowBox[{"ee", "=", 
    RowBox[{"BravyiEntanglementEntropy", "[", 
     RowBox[{"data", ",", "kk"}], "]"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}]], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[2]:=",
 CellID->1203043985,ExpressionUUID->"b33110e9-bac0-47fc-b29d-41c1b2412a78"],

Cell[BoxData["0.279363`"], "EchoTiming",
 CellID->1813499230,ExpressionUUID->"4b16b5d6-2add-4a4a-9948-29c39af1a6d8"]
}, Open  ]],

Cell["\<\
Plot the entanglement entropy averaged over the quantum trajectories. Here, \
\[Gamma] refers to the damping rate, which equals to 1 in our unit system:\
\>", "ExampleText",
 CellID->961579217,ExpressionUUID->"0d714172-b986-41cb-8761-870005acec83"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Mean", "[", "ee", "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"DataRange", "->", 
    RowBox[{"{", 
     RowBox[{"0", ",", "$T"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotMarkers", "->", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", "12"}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Gamma]\[ThinSpace]t\>\"", 
      ",", "\"\<\[LeftAngleBracket]EE \
(\!\(\*StyleBox[\"L\",FontSlant->\"Italic\"]\), \
\!\(\*StyleBox[\"L\",FontSlant->\"Italic\"]\)/2)\[RightAngleBracket]\>\""}], 
     "}"}]}]}], "]"}]], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[3]:=",
 CellID->1422494101,ExpressionUUID->"6b1d69d6-d7d5-43e6-85d9-282923d28811"],

