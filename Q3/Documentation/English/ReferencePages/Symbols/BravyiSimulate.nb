Cell[TextData[{
 "It returns a collection of quantum trajectories, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["data", "TI"], "=", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["trj", "TI"], 
      StyleBox["1", "TR"]], ",", 
     SubscriptBox[
      StyleBox["trj", "TI"], 
      StyleBox["2", "TR"]], ",", 
     StyleBox["\[Ellipsis]", "TR"]}], "}"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3aecb47e-4f25-4361-952e-59ea9ba44bdc"],
 ": each trajectory stores a sequence of quantum states, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["trj", "TI"], 
    StyleBox["i", "TI"]], "=", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["ws", "TI"], 
      StyleBox[
       RowBox[{
        StyleBox["i", "TI"], 
        StyleBox["1", "TR"]}],
       ZeroWidthTimes->True]], ",", 
     SubscriptBox[
      StyleBox["ws", "TI"], 
      StyleBox[
       RowBox[{
        StyleBox["i", "TI"], 
        StyleBox["2", "TR"]}],
       ZeroWidthTimes->True]], ",", 
     StyleBox["\[Ellipsis]", "TR"], ",", 
     SubscriptBox[
      StyleBox["ws", "TI"], 
      StyleBox["in", "TI"]]}], "}"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "33abb34f-c09f-40a4-aa1b-96023124e331"],
 ", where every quantum state is in the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BravyiState"]], "paclet:QuantumMob/Q3/ref/BravyiState", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "38932481-ebfa-45ff-a00b-ff2d32b9a34d"],
 " form."
}], "Notes",
 CellID->1967207486,ExpressionUUID->"571948b6-77a7-4d9f-9416-fc4abc0d3a87"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  RowBox[{
   StyleBox["jmp", "TI"], "=", 
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["BravyiJump"]], "paclet:QuantumMob/Q3/ref/BravyiJump", 
      "QuantumMob Package Symbol"},
     "PackageLink",
     BaseStyle->"InlineFormula"], "[", 
    StyleBox["m", "TI"], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1f2049cf-88b1-435b-b9b0-b400ad257788"],
 ", then ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SuperscriptBox[
     RowBox[{"\[LeftDoubleBracketingBar]", 
      SubscriptBox["m", "i"], "\[RightDoubleBracketingBar]"}], "2"]}], 
   TraditionalForm]],ExpressionUUID->"44403766-dd25-4c13-aa8d-6646c9b29d0b"],
 " (notice the factor of 2), where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["m", "i"], ":=", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["m", 
       RowBox[{"i", "\[VeryThinSpace]", "1"}]], ",", 
      SubscriptBox["m", 
       RowBox[{"i", "\[VeryThinSpace]", "2"}]], ",", "\[Ellipsis]", ",", 
      SubscriptBox["m", 
       RowBox[{"i", ",", 
        RowBox[{"2", "n"}]}]]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "e0b86db5-53da-4fbb-85c6-c751408f5840"],
 " is the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["i", "th"], TraditionalForm]],ExpressionUUID->
  "d838c24f-4424-43cd-9c2c-0aea4ca0fe4e"],
 " row of matrix ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "ce7e4488-747d-4e87-9a3c-a34ced1fc357"],
 ", gives the decoherence rate of the quantum jump operator\[LineSeparator]\t \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "i"], ":=", 
    RowBox[{
     UnderoverscriptBox["\[CapitalSigma]", 
      RowBox[{"j", "=", "1"}], 
      RowBox[{"2", "n"}]], 
     SubscriptBox["m", 
      RowBox[{"i", "\[VeryThinSpace]", "j"}]], 
     SubscriptBox["c", "j"]}]}], TraditionalForm]],ExpressionUUID->
  "6aa9f4f3-a86f-4e30-ad7e-e04db30c21d2"],
 " (not necessarily a dressed mode)."
}], "Notes",
 CellID->725440945,ExpressionUUID->"112e5939-4c19-4aaa-80b7-be7317dab2af"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  RowBox[{
   StyleBox["jmp", "TI"], "=", 
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["BravyiMeasurement"]], 
      "paclet:QuantumMob/Q3/ref/BravyiMeasurement", 
      "QuantumMob Package Symbol"},
     "PackageLink",
     BaseStyle->"InlineFormula"], "[", 
    StyleBox["m", "TI"], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a16d27fc-c863-4030-8bd0-4ae341b9c801"],
 ", then ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", 
    SuperscriptBox[
     RowBox[{"\[LeftDoubleBracketingBar]", 
      SubscriptBox["m", "i"], "\[RightDoubleBracketingBar]"}], "4"]}], 
   TraditionalForm]],ExpressionUUID->"27cd4124-4de0-456d-86f7-c50c5f804b06"],
 " (notice the power of 4 rather than 2), gives the decoherence rate of the \
quantum jump operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "i"], ":=", 
    RowBox[{
     SubsuperscriptBox["b", "i", "\[Dagger]"], 
     SubscriptBox["b", "i"]}]}], TraditionalForm]],ExpressionUUID->
  "9d6df95f-1373-455e-95e8-00b53e8cf9e5"],
 " association with the dressed Fermion mode\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["b", "i"], ":=", 
    RowBox[{
     UnderoverscriptBox["\[CapitalSigma]", 
      RowBox[{"j", "=", "1"}], 
      RowBox[{"2", "n"}]], 
     SubscriptBox["m", 
      RowBox[{"i", "\[VeryThinSpace]", "j"}]], 
     SubscriptBox["c", "j"]}]}], TraditionalForm]],ExpressionUUID->
  "c27d1881-0647-4f5c-b940-6fde5fbde60b"],
 " (unnormalized)."
}], "Notes",
 CellID->1069290512,ExpressionUUID->"caf477ee-4266-407d-8d46-6695f2235e6e"],

Cell[TextData[{
 "The accuracy and speed of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BravyiSimulate"]], "paclet:QuantumMob/Q3/ref/BravyiSimulate", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ae6a596a-9c07-450a-b233-3cd7c399f7db"],
 " may be adjusted by parameter ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$BravyiMinorSteps"]], 
    "paclet:QuantumMob/Q3/ref/$BravyiMinorSteps", "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1e3c39a7-699a-4a02-831a-cbed5888c48a"],
 ". The bigger this parameter is, the accuracy is increased but ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BravyiSimulate"]], "paclet:QuantumMob/Q3/ref/BravyiSimulate", 
    "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cf17f5bc-49d9-4ac8-9b66-930ed3538257"],
 " becomes slower, and vice versa."
}], "Notes",
 CellID->1521906099,ExpressionUUID->"c3594bd5-d366-458e-8359-3cb9ac936cbe"],

Cell[TextData[{
 "For the non-unitary evolution governed by the non-Hermitian part of the \
effective Hamiltonian, BravyiSimulate internally uses the 4th-order ",
 StyleBox["Runge-Kutta method",
  FontSlant->"Italic"],
 ". The step size is controlled by parameter ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$BravyiMinorSteps"]], 
    "paclet:QuantumMob/Q3/ref/$BravyiMinorSteps", "QuantumMob Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f2af06ec-e383-45bf-9b3a-f38a57ebcf47"],
 "."
}], "Notes",
 CellID->859340705,ExpressionUUID->"4300be71-a7f9-4bb1-86fd-0b3bb99ef2bc"],

