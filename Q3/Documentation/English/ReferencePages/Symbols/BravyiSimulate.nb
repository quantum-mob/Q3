Cell["To verify the above result, solve the Lindblad equation:", "ExampleText",
 CellID->885622144,ExpressionUUID->"ed2f74e6-59e3-4f0d-bc84-7c21bec33ff5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"out", "=", 
   RowBox[{"BravyiLindbladSolve", "[", 
    RowBox[{"ham", ",", "jmp", ",", "in", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "$T", ",", 
       RowBox[{"4", "*", "$dt"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[1]:=",
 CellID->1723549137,ExpressionUUID->"233e2a27-8bcc-46a3-81c9-817fb45f2b94"],

Cell["\<\
Calculate the entanglement between the subsystem and the rest:\
\>", "ExampleText",
 CellID->1620316432,ExpressionUUID->"52ec2d32-0edf-4a17-867c-717a8314f097"],

Cell[BoxData[
 RowBox[{
  RowBox[{"negSol", "=", 
   RowBox[{"BravyiLogarithmicNegativity", "[", 
    RowBox[{"out", ",", "sub"}], "]"}]}], ";"}]], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[2]:=",
 CellID->132278913,ExpressionUUID->"76b0e162-b306-4270-9092-e19286923d8b"],

Cell["Compare the two results:", "ExampleText",
 CellID->95302880,ExpressionUUID->"a8feb77f-2f7c-47b0-968a-3ff98f677de1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Re", "@", 
    RowBox[{"{", 
     RowBox[{"negSol", ",", "negRho"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"DataRange", "->", 
    RowBox[{"{", 
     RowBox[{"0", ",", "$T"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotMarkers", "->", 
