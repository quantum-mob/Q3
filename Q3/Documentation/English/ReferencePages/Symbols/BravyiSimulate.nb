}, Open  ]],

Cell["\<\
Construct an approximate density matrix , and calculate the entanglement \
between the subsystem and the rest:\
\>", "ExampleText",
 CellID->1788699700,ExpressionUUID->"44f707fc-92af-43c2-9705-f13d2499940f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"avg", "=", 
   RowBox[{"BravyiMean", "[", "data", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"negRho", "=", 
   RowBox[{"BravyiLogarithmicNegativity", "[", 
    RowBox[{"avg", ",", "sub"}], "]"}]}], ";"}]}], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[12]:=",
 CellID->185629150,ExpressionUUID->"1ab61fc4-97b6-4578-9052-7346bde8787e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Re", "@", "negRho"}], ",", "\[IndentingNewLine]", 
   RowBox[{"DataRange", "->", 
    RowBox[{"{", 
     RowBox[{"0", ",", "$T"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotMarkers", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Gamma] t\>\"", ",", "\"\<LN (L, L/2)\>\""}], "}"}]}]}], 
  "]"}]], "Input",
 CellProlog:>Needs["QuantumMob`Q3`"],
 CellLabel->"In[13]:=",
