Cell[BoxData[GridBox[{
   {"", Cell[TextData[{
     Cell[BoxData[
      RowBox[{
       TemplateBox[{
         Cell[
          TextData["BravyiSimulate"]], 
         "paclet:QuantumMob/Q3/ref/BravyiSimulate", 
         "QuantumMob Package Symbol"},
        "PackageLink",
        BaseStyle->"InlineFormula"], "[", 
       RowBox[{
        StyleBox["in", "TI"], ",", 
        StyleBox["ham", "TI"], ",", 
        StyleBox["jmp", "TI"], ",", 
        RowBox[{"{", 
         RowBox[{
          StyleBox["\[Tau]", "TI"], ",", 
          StyleBox["dt", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "d884b87d-aaae-4e5c-8376-2f956c7dc147"],
     "\[LineSeparator]solves the quantum master equation for a \
non-interacting dissipative fermionic many-body system by using the Monte \
Carlo simulation method (also known as the ",
     StyleBox["quantum jump approach",
      FontSlant->"Italic"],
     " or ",
     StyleBox["quantum trajectory method",
      FontSlant->"Italic"],
     "). The model is specified by the single-particle Hamiltonian ",
     Cell[BoxData[
      StyleBox["ham", "TI"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "ccdfddeb-e80d-4643-8288-3bc89f1e6d8a"],
     " in the ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["BravyiHermitian"]], 
        "paclet:QuantumMob/Q3/ref/BravyiHermitian", 
        "QuantumMob Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "0c38ad2c-8c60-448b-95f5-98fe4327cd74"],
     " form and the quantum jump operators are specified by ",
     Cell[BoxData[
      StyleBox["jmp", "TI"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "c639273f-f1f4-41a8-97b9-4b891652f5cf"],
     " in the ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["BravyiJump"]], "paclet:QuantumMob/Q3/ref/BravyiJump", 
        "QuantumMob Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "8426239f-01f8-4da9-9cc5-33433e924869"],
     " or ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["BravyiMeasurement"]], 
        "paclet:QuantumMob/Q3/ref/BravyiMeasurement", 
        "QuantumMob Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "5cea365b-436f-49d7-8980-2d986c0d180d"],
     " form. The simulation starts from the initial state ",
     Cell[BoxData[
      StyleBox["in", "TI"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "505f8a63-cc9d-4077-963f-d55150ae082e"],
     " in the  ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["BravyiState"]], "paclet:QuantumMob/Q3/ref/BravyiState", 
        "QuantumMob Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "d21e0be0-785c-4b52-8cbb-1e38e5aaab6d"],
     " form at time 0 and runs to time \[Tau] in steps of size ",
     Cell[BoxData[
      StyleBox["dt", "TI"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "ccb98378-b7f1-46b5-abff-b4bb8ffb33f4"],
     "."
    }],ExpressionUUID->"fe23c319-a892-4029-b4a6-9b937147e5ab"]},
   {"", Cell[TextData[{
     Cell[BoxData[
      RowBox[{
       TemplateBox[{
         Cell[
          TextData["BravyiSimulate"]], 
         "paclet:QuantumMob/Q3/ref/BravyiSimulate", 
         "QuantumMob Package Symbol"},
        "PackageLink",
        BaseStyle->"InlineFormula"], "[", 
       RowBox[{
        StyleBox["in", "TI"], ",", 
        StyleBox["ham", "TI"], ",", 
        StyleBox["jmp", "TI"], ",", 
        RowBox[{"{", 
         RowBox[{
          StyleBox["\[Tau]", "TR"], ",", 
          StyleBox["dt", "TI"], ",", 
          StyleBox["k", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "80642f2e-28c5-41c1-8458-66d6ca4901e2"],
     "\[LineSeparator]collects states in steps of ",
     Cell[BoxData[
      RowBox[{
       StyleBox["k", "TI"], "\[Times]", 
       StyleBox["dt", "TI"]}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "fc9df7b3-ebb0-42ce-ae53-bba726a3fb6a"],
     " (rather than ",
     Cell[BoxData[
      StyleBox["dt", "TI"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "7cb10d7b-4c97-4c7d-bf07-127a9b9ac880"],
     "), where ",
     Cell[BoxData[
      StyleBox["k", "TI"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "efa99dc6-3d46-4f7d-9ec9-494fb9b6685c"],
     " must be an integer or ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["All"]], "paclet:ref/All"},
       "RefLink",
       BaseStyle->{"InlineFormula"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "6de644e0-89aa-43e6-99d7-f0a0db935233"],
     "."
    }],ExpressionUUID->"9b112837-54b8-4f6e-a238-abf4ca6ec34a"]}
  }]], "Usage",
 CellID->1058277371,ExpressionUUID->"01bd9ff1-8b56-4e1c-9b85-72842202b0ac"]
}, Open  ]],

